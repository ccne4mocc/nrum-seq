import { ScrollView } from "std-widgets.slint";
// nrum seq: algorithm-first MIDI drum sequencer. Rust pushes deterministic pattern and view data.
export global Theme {
    in-out property <color> c1: #a67c00;
    in-out property <color> c2: #3f6591;
    in-out property <color> c3: #9c4f43;
    in-out property <color> hi: #a93226;
    in-out property <color> bg1: #f3eee2;
    in-out property <color> bg2: #eee7d8;
    in-out property <color> bg3: #e8dfcd;
    in-out property <color> surface: #faf5e9;
    in-out property <color> control: #e5dcc9;
    in-out property <color> control-hover: #d7ccb5;
    in-out property <color> text: #2f2b25;
    in-out property <color> text-muted: #7a7061;
    in-out property <color> border: #c7bca8;
    in-out property <color> cell-off: #ded5c3;
    in-out property <color> on-accent: #fdf9f0;
    // Eight distinguishable lane colours used by the phyllotaxis rosettes.
    in-out property <[color]> lanes: [#3f6591, #9c4f43, #a67c00, #4f7a4a, #7a4f91, #2f7a74, #a93226, #5c5c5c];
}

export struct ViewNode { x: length, y: length, r: length, on: bool, cur: bool, label: string, lane: int }
export struct ModeEntry { group: string, index: int, header: bool }
export struct ModeRow { header: bool, group: string, left: int, right: int, has-right: bool }
export struct StepCell { track: int, step: int, hit: bool, playing: bool, velocity: float, probability: float, hit-override: int, edited: bool, ratchet: int, offset: int }
export struct TrackRow { index: int, name: string, enabled: bool, note: int, cells: [StepCell] }
export struct Opt { label: string, min: float, max: float, value: float, text: string, step: float, number: string, scale: float }
export struct ModRow { lfo: int, target-id: int, source: string, target: string, base: string, value: string, delta: string }
export struct ModTargetView {
    target: int,
    linked: bool,
    base: float,
    value: float,
    min: float,
    max: float,
    base01: float,
    value01: float,
    depth-up: float,
    depth-down: float,
    lfo-text: string,
    count: int,
}

export global ModDrag {
    in-out property <int> lfo: 0;
    in-out property <length> x: 0px;
    in-out property <length> y: 0px;
    callback dropped(float, length, length);
}

export global ModRegistry {
    callback register(int, bool, length, length, length, length);
}

export global HoverTip {
    in-out property <string> text: "";
    in-out property <length> x: 0px;
    in-out property <length> y: 0px;
    // Position of the control that owns the visible tip, so moving between two controls with
    // the same hint cannot let the old control clear the new one's tip.
    in-out property <length> owner-x: 0px;
    in-out property <length> owner-y: 0px;
}

/// A TouchArea that publishes its hint while hovered. The tooltip is drawn once at the window
/// root so it is not clipped by panels or the matrix scroll view.
component TipTouch inherits TouchArea {
    in property <string> hint: "";
    moved => {
        if (root.has-hover) {
            HoverTip.text = root.hint;
            HoverTip.x = root.absolute-position.x + root.mouse-x;
            HoverTip.y = root.absolute-position.y + root.mouse-y;
            HoverTip.owner-x = root.absolute-position.x;
            HoverTip.owner-y = root.absolute-position.y;
        }
    }
    changed has-hover => {
        if (root.has-hover) {
            HoverTip.text = root.hint;
            HoverTip.x = root.absolute-position.x + root.mouse-x;
            HoverTip.y = root.absolute-position.y + root.mouse-y;
            HoverTip.owner-x = root.absolute-position.x;
            HoverTip.owner-y = root.absolute-position.y;
        } else if (HoverTip.owner-x == root.absolute-position.x && HoverTip.owner-y == root.absolute-position.y) {
            HoverTip.text = "";
        }
    }
}

export global ModHover {
    in-out property <int> target: -1;
    in-out property <length> x: 0px;
    in-out property <length> y: 0px;
}

export global ModView {
    in property <[ModTargetView]> targets;
    public pure function view(index: int) -> ModTargetView {
        if (index >= 0 && index < targets.length) {
            return targets[index];
        }
        return {
            target: -1, linked: false, base: 0, value: 0, min: 0, max: 1,
            base01: 0, value01: 0, depth-up: 0, depth-down: 0, lfo-text: "", count: 0
        };
    }
}

component Selector inherits Rectangle {
    in property <[string]> options;
    in property <int> current;
    in property <length> text-size: 10px;
    callback selected(int);
    height: 28px;
    HorizontalLayout {
        spacing: 4px;
        for i in root.options.length: Rectangle {
            border-radius: 1px;
            background: ta.has-hover ? Theme.control-hover : Theme.control;
            if i == root.current: Rectangle {
                border-radius: 4px;
                background: @linear-gradient(90deg, Theme.c1 0%, Theme.c2 52%, Theme.c3 100%);
            }
            Text {
                width: parent.width; height: parent.height;
                text: root.options[i];
                color: i == root.current ? Theme.on-accent : Theme.text;
                font-size: root.text-size;
                horizontal-alignment: center; vertical-alignment: center;
                overflow: elide;
            }
            ta := TipTouch {
                hint: "Choose this option";
                clicked => { root.selected(i); }
                // Enum parameters (rate, waveform, theme) can be stepped with the wheel too.
                scroll-event(e) => {
                    if (e.delta-y != 0px) {
                        root.selected((root.current + (e.delta-y > 0px ? 1 : -1)) < 0 ? 0 : ((root.current + (e.delta-y > 0px ? 1 : -1)) >= root.options.length ? root.options.length - 1 : root.current + (e.delta-y > 0px ? 1 : -1)));
                        accept
                    } else {
                        reject
                    }
                }
            }
        }
    }
}

// One RANDOMIZE scope group. The five chips edit the bits of a single host parameter.
component ScopeChip inherits Rectangle {
    in property <string> label;
    in property <bool> active;
    callback toggled();
    height: 22px; border-radius: 4px;
    background: root.active ? Theme.c1.with-alpha(0.8) : (ta.has-hover ? Theme.control-hover : Theme.control);
    Text { text: root.label; color: root.active ? Theme.on-accent : Theme.text; font-size: 8px; horizontal-alignment: center; vertical-alignment: center; overflow: elide; }
    ta := TipTouch { hint: "Toggle this RANDOMIZE group"; clicked => { root.toggled(); } }
}

component OptSlider inherits Rectangle {
    in property <Opt> opt;
    in property <int> mod-target: -1;
    in property <string> hint: "Drag or scroll to adjust";
    callback changed(float);
    height: 25px;
    border-radius: 4px; background: Theme.control; clip: true;
    property <bool> edit-open: false;
    property <string> draft: "";
    out property <bool> editing: root.edit-open;
    property <bool> mod-registered: false;
    property <ModTargetView> modview: ModView.view(root.mod-target);
    property <bool> mod-hover: root.mod-target >= 0 && ModDrag.lfo > 0
        && ModDrag.x >= root.absolute-position.x && ModDrag.x <= root.absolute-position.x + root.width
        && ModDrag.y >= root.absolute-position.y && ModDrag.y <= root.absolute-position.y + root.height;
    property <bool> hovered: ta.has-hover;
    property <float> mod-base01: Math.clamp((root.modview.base - root.opt.min) / Math.max(root.opt.max - root.opt.min, 0.0001), 0, 1);
    property <float> mod-value01: Math.clamp((root.modview.value - root.opt.min) / Math.max(root.opt.max - root.opt.min, 0.0001), 0, 1);
    property <float> mod-up01: Math.min(1, root.modview.depth-up * (root.modview.max - root.modview.min) / Math.max(root.opt.max - root.opt.min, 0.0001));
    property <float> mod-down01: Math.min(1, root.modview.depth-down * (root.modview.max - root.modview.min) / Math.max(root.opt.max - root.opt.min, 0.0001));
    property <float> mod-band-low: Math.max(0, root.mod-base01 - root.mod-down01);
    property <float> mod-band-high: Math.min(1, root.mod-base01 + root.mod-up01);
    function report-mod() {
        if (root.mod-target >= 0) {
            ModRegistry.register(root.mod-target, root.visible, root.absolute-position.x, root.absolute-position.y, root.width, root.height);
        }
    }
    Rectangle {
        x: 0px; y: 0px; height: parent.height;
        width: parent.width * Math.clamp((root.opt.value - root.opt.min) / (root.opt.max - root.opt.min), 0, 1);
        background: @linear-gradient(90deg, Theme.c1 0%, Theme.c2 52%, Theme.c3 100%);
        opacity: 0.3;
    }
    if root.modview.linked: Rectangle {
        x: parent.width * root.mod-band-low;
        y: parent.height - 5px;
        width: parent.width * Math.max(0, root.mod-band-high - root.mod-band-low);
        height: 4px;
        background: Theme.c3;
        opacity: 0.20;
    }
    if root.modview.linked: Rectangle {
        x: parent.width * Math.min(root.mod-base01, root.mod-value01);
        y: parent.height - 4px;
        width: parent.width * Math.abs(root.mod-value01 - root.mod-base01);
        height: 3px;
        background: Theme.c3;
        opacity: 0.95;
    }
    if root.modview.linked: Rectangle {
        x: Math.max(0px, Math.min(parent.width - 2px, parent.width * root.mod-value01 - 1px));
        y: parent.height - 5px; width: 2px; height: 5px;
        background: Theme.hi;
    }
    Text { x: 8px; width: parent.width - 16px; height: parent.height; text: root.opt.label; color: Theme.text; font-size: 11px; vertical-alignment: center; }
    Text { x: 8px; width: parent.width - 16px; height: parent.height; text: root.opt.text; color: Theme.text; font-size: 11px; horizontal-alignment: right; vertical-alignment: center; }
    ta := TouchArea {
        pointer-event(e) => {
            if (root.hint != "") {
                HoverTip.text = root.hint;
                HoverTip.x = root.absolute-position.x + ta.mouse-x;
                HoverTip.y = root.absolute-position.y + ta.mouse-y;
                HoverTip.owner-x = root.absolute-position.x;
                HoverTip.owner-y = root.absolute-position.y;
            }
            if (e.button == PointerEventButton.left && e.kind == PointerEventKind.down) {
                root.changed(root.opt.min + Math.clamp(ta.mouse-x / ta.width, 0, 1) * (root.opt.max - root.opt.min));
            }
        }
        double-clicked => {
            if (!root.edit-open) {
                root.draft = root.opt.number;
                root.edit-open = true;
            }
        }
        moved => { if (ta.pressed) { root.changed(root.opt.min + Math.clamp(ta.mouse-x / ta.width, 0, 1) * (root.opt.max - root.opt.min)); } }
        // Snap to the parameter's step grid, then move one step per wheel notch.
        scroll-event(e) => {
            if (e.delta-y != 0px) {
                root.changed(Math.clamp(root.opt.min + Math.round((root.opt.value - root.opt.min) / root.opt.step + (e.delta-y > 0px ? 1 : -1)) * root.opt.step, root.opt.min, root.opt.max));
                accept
            } else {
                reject
            }
        }
    }
    property <bool> tip-hover: ta.has-hover;
    changed tip-hover => {
        if (tip-hover) {
            HoverTip.text = root.hint;
            HoverTip.x = root.absolute-position.x + ta.mouse-x;
            HoverTip.y = root.absolute-position.y + ta.mouse-y;
            HoverTip.owner-x = root.absolute-position.x;
            HoverTip.owner-y = root.absolute-position.y;
        } else if (HoverTip.owner-x == root.absolute-position.x && HoverTip.owner-y == root.absolute-position.y) {
            HoverTip.text = "";
        }
    }
    if root.edit-open: Rectangle {
        x: 1px; y: 1px; width: parent.width - 2px; height: parent.height - 2px;
        border-radius: 3px; background: Theme.surface; border-width: 1px; border-color: Theme.c2;
        entry := TextInput {
            x: 4px; width: parent.width - 8px; height: parent.height;
            text: root.draft; color: Theme.text; font-size: 11px;
            horizontal-alignment: right; vertical-alignment: center;
            edited => { root.draft = self.text; }
            accepted => {
                if (root.draft.is-float()) {
                    root.changed(Math.clamp(root.draft.to-float() * root.opt.scale, root.opt.min, root.opt.max));
                }
                root.edit-open = false;
            }
            key-pressed(event) => {
                if (event.text == Key.Escape) { root.edit-open = false; return accept; }
                return reject;
            }
        }
    }
    if root.mod-hover: Rectangle {
        x: 0px; y: 0px; width: parent.width; height: parent.height;
        border-radius: 4px; border-width: 2px; border-color: Theme.c2;
        background: transparent;
    }
    Timer {
        interval: 30ms;
        running: root.mod-target >= 0 && !root.mod-registered;
        triggered => { root.mod-registered = true; root.report-mod(); }
    }
    Timer {
        interval: 250ms;
        running: root.mod-target >= 0;
        triggered => { root.report-mod(); }
    }
    Timer {
        interval: 40ms;
        running: root.hovered && root.mod-target >= 0 && !root.edit-open;
        triggered => {
            ModHover.target = root.mod-target;
            ModHover.x = root.absolute-position.x;
            ModHover.y = root.absolute-position.y + root.height;
        }
    }
    Timer {
        interval: 40ms;
        running: !root.hovered && ModHover.target == root.mod-target;
        triggered => { ModHover.target = -1; }
    }
}
// Slint's SpinBox is <int>-only, so this carries fractional values such as 16.5 steps.
component NumBox inherits Rectangle {
    in property <string> label;
    in property <float> value: 0;
    in property <float> minimum: 0;
    in property <float> maximum: 100;
    in property <float> step: 1;
    in property <int> decimals: 0;
    in property <int> mod-target: -1;
    callback changed(float);
    property <bool> mod-registered: false;
    property <ModTargetView> modview: ModView.view(root.mod-target);
    property <bool> mod-hover: root.mod-target >= 0 && ModDrag.lfo > 0
        && ModDrag.x >= root.absolute-position.x && ModDrag.x <= root.absolute-position.x + root.width
        && ModDrag.y >= root.absolute-position.y && ModDrag.y <= root.absolute-position.y + root.height;
    property <bool> hovered: wheel.has-hover;
    property <float> mod-base01: Math.clamp((root.modview.base - root.minimum) / Math.max(root.maximum - root.minimum, 0.0001), 0, 1);
    property <float> mod-value01: Math.clamp((root.modview.value - root.minimum) / Math.max(root.maximum - root.minimum, 0.0001), 0, 1);
    property <float> mod-up01: Math.min(1, root.modview.depth-up * (root.modview.max - root.modview.min) / Math.max(root.maximum - root.minimum, 0.0001));
    property <float> mod-down01: Math.min(1, root.modview.depth-down * (root.modview.max - root.modview.min) / Math.max(root.maximum - root.minimum, 0.0001));
    property <float> mod-band-low: Math.max(0, root.mod-base01 - root.mod-down01);
    property <float> mod-band-high: Math.min(1, root.mod-base01 + root.mod-up01);
    function report-mod() {
        if (root.mod-target >= 0) {
            ModRegistry.register(root.mod-target, root.visible, root.absolute-position.x, root.absolute-position.y, root.width, root.height);
        }
    }

    height: 26px;
    border-radius: 4px;
    background: Theme.control; border-width: 1px; border-color: Theme.border;
    horizontal-stretch: 1;
    // True while the number field has focus, so Rust can keep host shortcuts out of typing.
    out property <bool> editing: input.has-focus;

    function clamp-value(v: float) -> float {
        return Math.clamp(v, root.minimum, root.maximum);
    }
    function nudge(dir: float) {
        root.changed(root.clamp-value(root.value + dir * root.step));
    }
    function format-value(v: float) -> string {
        if (root.decimals <= 0) { return Math.round(v); }
        return Math.round(v * 100) / 100;
    }

    Text {
        x: 6px; width: parent.width - 12px;
        text: root.label;
        color: Theme.text-muted; font-size: 9px; vertical-alignment: center; overflow: elide;
    }
    if root.modview.linked: Rectangle {
        x: 1px + (parent.width - 35px) * root.mod-band-low;
        y: parent.height - 4px;
        width: (parent.width - 35px) * Math.max(0, root.mod-band-high - root.mod-band-low);
        height: 3px;
        background: Theme.c3;
        opacity: 0.20;
    }
    if root.modview.linked: Rectangle {
        x: 1px + (parent.width - 35px) * Math.min(root.mod-base01, root.mod-value01);
        y: parent.height - 3px;
        width: (parent.width - 35px) * Math.abs(root.mod-value01 - root.mod-base01);
        height: 2px;
        background: Theme.c3;
    }
    down := Rectangle {
        x: parent.width - 34px; y: 1px; width: 16px; height: parent.height - 2px;
        border-radius: 3px; background: down-touch.has-hover ? Theme.control-hover : Theme.control;
        Text { text: "-"; color: Theme.text; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
        down-touch := TipTouch { hint: "Decrease this value"; clicked => { root.nudge(-1); } }
    }
    up := Rectangle {
        x: parent.width - 17px; y: 1px; width: 16px; height: parent.height - 2px;
        border-radius: 3px; background: up-touch.has-hover ? Theme.control-hover : Theme.control;
        Text { text: "+"; color: Theme.text; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
        up-touch := TipTouch { hint: "Increase this value"; clicked => { root.nudge(1); } }
    }
    // Wheel nudges anywhere on the control. Declared before `input` so clicks and typing still
    // reach the TextInput; with no scroll handler there, the wheel falls through to this area.
    wheel := TouchArea {
        // Keep the wheel area off the buttons; a full-width TouchArea here would swallow clicks.
        x: 0px; y: 0px; width: parent.width - 34px; height: parent.height;
        scroll-event(e) => {
            if (e.delta-y != 0px) {
                root.nudge(e.delta-y > 0px ? 1 : -1);
                return accept;
            }
            return reject;
        }
    }
    input := TextInput {
        x: 6px; width: parent.width - 42px; height: parent.height;
        color: Theme.text; font-size: 11px;
        horizontal-alignment: right; vertical-alignment: center;
        text: root.format-value(root.value);
        // Only accept complete numbers; a lone "-" or "1." must not be committed.
        edited => {
            if (self.text.is-float()) { root.changed(root.clamp-value(self.text.to-float())); }
            else { self.text = root.format-value(root.value); }
        }
        accepted => { self.text = root.format-value(root.value); }
        key-pressed(event) => {
            if (event.text == Key.UpArrow) { root.nudge(1); return accept; }
            if (event.text == Key.DownArrow) { root.nudge(-1); return accept; }
            return reject;
        }
    }
    if root.mod-hover: Rectangle {
        x: 0px; y: 0px; width: parent.width; height: parent.height;
        border-radius: 4px; border-width: 2px; border-color: Theme.c2;
        background: transparent;
    }
    Timer {
        interval: 30ms;
        running: root.mod-target >= 0 && !root.mod-registered;
        triggered => { root.mod-registered = true; root.report-mod(); }
    }
    Timer {
        interval: 250ms;
        running: root.mod-target >= 0;
        triggered => { root.report-mod(); }
    }
    Timer {
        interval: 40ms;
        running: root.hovered && root.mod-target >= 0 && !input.has-focus;
        triggered => {
            ModHover.target = root.mod-target;
            ModHover.x = root.absolute-position.x;
            ModHover.y = root.absolute-position.y + root.height;
        }
    }
    Timer {
        interval: 40ms;
        running: !root.hovered && ModHover.target == root.mod-target;
        triggered => { ModHover.target = -1; }
    }
}

// Collapsed waveform picker with a live LFO phase dot.
component WavePicker inherits Rectangle {
    in property <[string]> paths;
    in property <[string]> names;
    in property <int> current;
    in property <float> anim-phase: 0;
    in property <float> dot-y: 20;
    in property <bool> show-dot: false;
    in property <bool> running: false;
    callback selected(int);
    callback opened(length, length);
    height: 28px; border-radius: 4px;
    background: ta.has-hover ? Theme.control-hover : Theme.control;
    border-width: 1px; border-color: Theme.border;
    Text { x: 8px; width: Math.max(parent.width - 96px, 0px); height: parent.height; text: root.current < root.names.length ? root.names[root.current] : ""; color: Theme.text; font-size: 10px; vertical-alignment: center; overflow: elide; }
    Path {
        x: Math.max(parent.width - 76px, 6px); y: 4px;
        width: Math.min(50px, parent.width - 28px); height: parent.height - 8px;
        viewbox-x: 0; viewbox-y: 0; viewbox-width: 100; viewbox-height: 40;
        commands: root.current < root.paths.length ? root.paths[root.current] : "";
        fill: transparent; stroke: Theme.c1; stroke-width: 1.2px;
    }
    if root.show-dot: Rectangle {
        x: Math.max(parent.width - 76px, 6px) + (2.0 + root.anim-phase * 96.0) / 100.0 * Math.min(50px, parent.width - 28px) - 2px;
        y: 4px + (root.dot-y / 40.0) * (parent.height - 8px) - 2px;
        width: 4px; height: 4px; border-radius: 2px;
        background: Theme.hi;
        opacity: root.running ? 0.9 : 0.25;
    }
    Text { x: parent.width - 22px; width: 16px; height: parent.height; text: "▾"; color: Theme.text-muted; font-size: 9px; horizontal-alignment: center; vertical-alignment: center; }
    ta := TouchArea {
        clicked => { root.opened(root.absolute-position.x, root.absolute-position.y + root.height); }
        scroll-event(e) => {
            if (e.delta-y != 0px) {
                root.selected(Math.max(0, Math.min(root.current + (e.delta-y > 0px ? 1 : -1), root.paths.length - 1)));
                accept
            } else {
                reject
            }
        }
    }
}

// Small state button used by the LFO rack.
component LfoChip inherits Rectangle {
    in property <string> label;
    in property <bool> active: false;
    in property <length> text-size: 9px;
    in property <string> hint: "";
    callback clicked();
    height: 28px; border-radius: 4px;
    background: root.active
        ? @linear-gradient(90deg, Theme.c1 0%, Theme.c2 100%)
        : (ta.has-hover ? Theme.control-hover : Theme.control);
    border-width: 1px; border-color: Theme.border;
    Text { width: parent.width; height: parent.height; text: root.label; color: root.active ? Theme.on-accent : Theme.text; font-size: root.text-size; horizontal-alignment: center; vertical-alignment: center; overflow: elide; }
    ta := TipTouch { hint: root.hint; clicked => { root.clicked(); } }
}

// One LFO in the 2x2 rack.
component LfoCell inherits Rectangle {
    in property <int> index: 1;
    in property <bool> enabled: true;
    in property <int> wave: 0;
    in property <int> rate-mode: 0;
    in property <float> freq: 0.5;
    in property <float> beats: 4;
    in property <float> depth: 0;
    in property <float> phase: 0;
    in property <int> polarity: 0; // 0 = bipolar, 1 = unipolar up, 2 = unipolar down
    in property <float> anim-phase: 0;
    in property <float> dot-y: 20;
    in property <bool> running: true;
    in property <[string]> wave-paths;
    in property <[string]> wave-names;
    callback wave-selected(int);
    callback wave-opened(length, length);
    callback enabled-toggled();
    callback rate-mode-toggled();
    callback speed-changed(float);
    callback depth-changed(float);
    callback phase-changed(float);
    callback polarity-toggled();
    out property <bool> editing: speed-slider.editing || depth-slider.editing || phase-slider.editing;

    property <color> accent: root.index == 1 ? Theme.c1 : (root.index == 2 ? Theme.c2 : (root.index == 3 ? Theme.c3 : Theme.hi));
    function format-hz(v: float) -> string {
        if (v >= 10) { return "\{Math.round(v * 10) / 10} Hz"; }
        return "\{Math.round(v * 100) / 100} Hz";
    }
    height: 28px;
    HorizontalLayout {
        // 2px gaps and the 30px handle slot keep the 28x26 drag points inside the 822px rack width.
        spacing: 2px;
        Rectangle {
            width: 30px; height: 28px; background: transparent;
            Rectangle {
                y: 1px; width: 28px; height: 26px; border-radius: 4px;
                background: root.accent;
                Text { text: "\{root.index}"; color: Theme.on-accent; font-size: 11px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                handle-touch := TouchArea {
                    pointer-event(e) => {
                        if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                            ModDrag.lfo = root.index;
                            ModDrag.x = handle-touch.absolute-position.x + handle-touch.mouse-x;
                            ModDrag.y = handle-touch.absolute-position.y + handle-touch.mouse-y;
                        } else if (e.kind == PointerEventKind.move && ModDrag.lfo == root.index) {
                            ModDrag.x = handle-touch.absolute-position.x + handle-touch.mouse-x;
                            ModDrag.y = handle-touch.absolute-position.y + handle-touch.mouse-y;
                        } else if (e.kind == PointerEventKind.up && ModDrag.lfo == root.index) {
                            ModDrag.dropped(root.index, ModDrag.x, ModDrag.y);
                            ModDrag.lfo = 0;
                        } else if (e.kind == PointerEventKind.cancel) {
                            ModDrag.lfo = 0;
                        }
                    }
                }
            }
        }
        Rectangle {
            width: 34px; height: 28px; background: transparent;
            Text {
                width: parent.width; height: parent.height;
                text: "LFO \{root.index}";
                color: root.enabled ? root.accent : Theme.text-muted;
                opacity: root.enabled ? 1.0 : 0.65;
                font-size: 9px; font-weight: 700;
                vertical-alignment: center; overflow: elide;
            }
            TipTouch { hint: "Enable or disable this LFO"; clicked => { root.enabled-toggled(); } }
        }
        WavePicker {
            width: 76px; height: 28px;
            paths: root.wave-paths; names: root.wave-names; current: root.wave;
            anim-phase: root.anim-phase; dot-y: root.dot-y; show-dot: true; running: root.running;
            selected(i) => { root.wave-selected(i); }
            opened(x, y) => { root.wave-opened(x, y); }
        }
        LfoChip { width: 28px; label: root.rate-mode == 0 ? "Hz" : "BT"; active: false; hint: "Rate mode: Hz (free-running) or BT (beat-synced)"; clicked => { root.rate-mode-toggled(); } }
        speed-slider := OptSlider {
            width: 84px; height: 25px;
            opt: {
                label: "Rate",
                min: root.rate-mode == 0 ? 0.01 : 0.25,
                max: root.rate-mode == 0 ? 10 : 16,
                value: root.rate-mode == 0 ? root.freq : root.beats,
                text: root.rate-mode == 0 ? root.format-hz(root.freq) : "\{Math.round(root.beats * 100) / 100}",
                step: root.rate-mode == 0 ? 0.01 : 0.25,
                number: root.rate-mode == 0 ? "\{Math.round(root.freq * 100) / 100}" : "\{Math.round(root.beats * 100) / 100}",
                scale: 1
            };
            changed(v) => { root.speed-changed(v); }
        }
        depth-slider := OptSlider {
            width: 58px; height: 25px;
            hint: "Depth: 0–200% of the target range; 100% is a full sweep";
            opt: { label: "Dep", min: 0, max: 2, value: root.depth, text: "\{Math.round(root.depth * 100)}%", step: 0.01, number: "\{Math.round(root.depth * 100)}", scale: 0.01 };
            changed(v) => { root.depth-changed(v); }
        }
        phase-slider := OptSlider {
            width: 52px; height: 25px;
            opt: { label: "Phs", min: 0, max: 1, value: root.phase, text: "\{Math.round(root.phase * 360)}°", step: 0.01, number: "\{Math.round(root.phase * 360)}", scale: 1.0 / 360.0 };
            changed(v) => { root.phase-changed(v); }
        }
        LfoChip { width: 30px; label: root.polarity == 0 ? "±" : (root.polarity == 1 ? "↑" : "↓"); text-size: 11px; active: true; hint: "Polarity: click to cycle bipolar ±, positive ↑ (adds) and negative ↓ (subtracts)"; clicked => { root.polarity-toggled(); } }
    }
}

component ModePanel inherits Rectangle {
    in property <[ViewNode]> nodes;
    in property <string> edges: "M0 0";
    in property <string> lines: "M0 0";
    in property <string> hand: "M0 0";
    // view.rs builds every panel in a 210-unit space; paths scale through the viewbox and node
    // rectangles are scaled by hand so dots and labels grow with the box.
    property <float> px-per-unit: 1.4285714;   // 300px square drawing / 210-unit geometry
    property <length> draw-offset-x: 30px;      // letterbox the square drawing in the wider card
    width: 360px; height: 300px;
    background: transparent; border-radius: 6px; clip: true;
    Path { x: root.draw-offset-x; y: 0px; width: 300px; height: 300px; viewbox-x: 0; viewbox-y: 0; viewbox-width: 210; viewbox-height: 210; commands: root.edges; fill: transparent; stroke: Theme.border; stroke-width: 1px; }
    Path { x: root.draw-offset-x; y: 0px; width: 300px; height: 300px; viewbox-x: 0; viewbox-y: 0; viewbox-width: 210; viewbox-height: 210; commands: root.lines; fill: transparent; stroke: Theme.c3; stroke-width: 1.4px; }
    Path { x: root.draw-offset-x; y: 0px; width: 300px; height: 300px; viewbox-x: 0; viewbox-y: 0; viewbox-width: 210; viewbox-height: 210; commands: root.hand; fill: transparent; stroke: Theme.hi; stroke-width: 2px; }
    for n in root.nodes: Rectangle {
        // Pebble-box positions change every step; static panels never show the tween.
        animate x, y { duration: 120ms; }
        x: root.draw-offset-x + (n.x - n.r) * root.px-per-unit; y: (n.y - n.r) * root.px-per-unit;
        width: n.r * 2 * root.px-per-unit; height: n.r * 2 * root.px-per-unit;
        border-radius: n.r * root.px-per-unit;
        background: n.cur ? Theme.hi : (n.lane >= 0 ? Theme.lanes[Math.mod(n.lane, 8)].with-alpha(n.on ? 0.95 : 0.35) : (n.on ? Theme.c1 : Theme.cell-off));
        border-width: 1px; border-color: n.lane >= 0 ? Theme.lanes[Math.mod(n.lane, 8)] : Theme.border;
        Text { width: parent.width; height: parent.height; text: n.label; font-size: 7px * root.px-per-unit; color: (n.cur || n.on) ? Theme.on-accent : Theme.text; horizontal-alignment: center; vertical-alignment: center; }
    }
}

// Dropdown list overlay, anchored to its triggering field by the caller.
component DropdownList inherits Rectangle {
    in property <[string]> options;
    in property <int> current;
    callback selected(int);
    width: 200px; height: 260px;
    background: Theme.surface; border-width: 1px; border-color: Theme.border;
    drop-shadow-blur: 12px; drop-shadow-color: #00000055; drop-shadow-offset-y: 3px;
    clip: true;
    ScrollView {
        width: parent.width; height: parent.height;
        vertical-scrollbar-policy: as-needed;
        VerticalLayout {
            spacing: 3px; padding: 6px; alignment: start;
            for i in root.options.length: Rectangle {
                height: 24px; border-radius: 3px;
                background: i == root.current ? @linear-gradient(90deg, Theme.c1 0%, Theme.c2 52%, Theme.c3 100%) : (item-touch.has-hover ? Theme.control-hover : Theme.control);
                Text { x: 8px; width: parent.width - 16px; height: parent.height; text: root.options[i]; color: i == root.current ? Theme.on-accent : Theme.text; font-size: 9px; vertical-alignment: center; overflow: elide; }
                item-touch := TipTouch { hint: "Select this value"; clicked => { root.selected(i); } }
            }
        }
    }
}

component ModeDropdown inherits Rectangle {
    in property <[ModeRow]> rows;
    in property <[string]> names;
    in property <int> current;
    callback selected(int);
    width: 460px; height: 432px;
    background: Theme.surface; border-width: 1px; border-color: Theme.border;
    drop-shadow-blur: 16px; drop-shadow-color: #00000055; drop-shadow-offset-y: 4px;
    clip: true;
    ScrollView {
        width: parent.width; height: parent.height;
        vertical-scrollbar-policy: as-needed;
        VerticalLayout {
            padding: 8px; spacing: 4px; alignment: start;
            for r in root.rows: Rectangle {
                height: r.header ? 18px : 24px;
                width: 444px;
                border-radius: 3px;
                background: transparent;
                if r.header: Text {
                    x: 6px; width: 432px; height: parent.height;
                    text: r.group; color: Theme.text-muted; font-size: 8px; font-weight: 700; vertical-alignment: center; overflow: elide;
                }
                if !r.header: HorizontalLayout {
                    spacing: 6px; padding-left: 0px; padding-right: 0px;
                    Rectangle {
                        horizontal-stretch: 1; height: parent.height; border-radius: 3px;
                        background: r.left == root.current ? @linear-gradient(90deg, Theme.c1 0%, Theme.c2 52%, Theme.c3 100%) : (left-touch.has-hover ? Theme.control-hover : Theme.control);
                        Text { x: 6px; width: parent.width - 12px; height: parent.height; text: root.names[r.left]; color: r.left == root.current ? Theme.on-accent : Theme.text; font-size: 11px; vertical-alignment: center; overflow: elide; }
                        left-touch := TipTouch { hint: "Select this mode"; clicked => { root.selected(r.left); } }
                    }
                    if r.has-right: Rectangle {
                        horizontal-stretch: 1; height: parent.height; border-radius: 3px;
                        background: r.right == root.current ? @linear-gradient(90deg, Theme.c1 0%, Theme.c2 52%, Theme.c3 100%) : (right-touch.has-hover ? Theme.control-hover : Theme.control);
                        Text { x: 6px; width: parent.width - 12px; height: parent.height; text: root.names[r.right]; color: r.right == root.current ? Theme.on-accent : Theme.text; font-size: 11px; vertical-alignment: center; overflow: elide; }
                        right-touch := TipTouch { hint: "Select this mode"; clicked => { root.selected(r.right); } }
                    }
                    if !r.has-right: Rectangle { horizontal-stretch: 1; }
                }
                row-touch := TouchArea {
                    enabled: false;
                }
            }
        }
    }
}

export component AppWindow inherits Window {
    title: "nrum seq";
    // Fixed layout size: the window never resizes, so the host cannot fight over it.
    in property <length> base-width: 860px;
    in property <length> base-height: 740px;
    preferred-width: root.base-width; preferred-height: root.base-height;
    background: @linear-gradient(135deg, Theme.bg1 0%, Theme.bg2 50%, Theme.bg3 100%);
    in property <int> mode: 0;
    in property <string> version;
    in property <[string]> preset-names;
    in property <float> steps: 16;
    in property <float> max-steps: 256;
    in property <bool> round-steps: true;
    // Grid cells the generator will fill, mirroring `cell_count_for`: snap rounds, free length
    // takes the ceiling. Header and bounds read this so they cannot disagree with the matrix.
    property <int> cells: root.round-steps ? Math.round(root.steps) : Math.ceil(root.steps);
    // Fixed step width: growing the pattern scrolls the matrix instead of shrinking cells.
    property <length> matrix-cell-width: root.cells < 64 ? Math.max(14px, 780px / root.cells) : 14px;
    in-out property <int> current-step: 0;
    in-out property <bool> follow-step: true;
    in-out property <bool> regen-pulse: false;
    in-out property <length> regen-off-timer: 0px;
    in-out property <length> matrix-x: 0px;
    // `viewport-x` is the content offset and is negative when scrolled right.
    pure function follow-x() -> length {
        let max-offset = Math.max(0px, root.cells * root.matrix-cell-width - matrix-scroll.width);
        let offset = Math.max(0px, Math.min(root.current-step * root.matrix-cell-width - matrix-scroll.width * 0.35, max-offset));
        return -offset;
    }
    changed current-step => {
        if (root.follow-step) { root.matrix-x = root.follow-x(); }
    }
    changed follow-step => {
        if (root.follow-step) { root.matrix-x = root.follow-x(); }
    }
    in property <float> pulses: 5;
    in property <float> rotate: 0;
    in property <float> density: 0.65;
    in property <float> probability: 1.0;
    in property <float> velocity: 1.0;
    in property <float> gate: 0.12;
    in property <float> regenerate-every: 0;
    in property <float> randomize-after-lengths: 0;
    in property <float> swing: 0;
    in property <float> seed: 0.271;
    in property <float> phase: 0.0;
    in property <float> osc-rate: 2.0;
    in property <float> ca-rule: 30;
    in property <float> markov-bias: 0;
    in property <float> symmetry: 4;
    in property <int> rate: 3;
    in property <[string]> rate-names;
    in property <int> osc-wave: 0;
    in property <[string]> wave-names;
    in property <[string]> wave-paths;
    // Four runtime LFOs.
    in property <bool> lfo1-enabled: true;
    in property <int> lfo1-wave: 0;
    in property <int> lfo1-rate-mode: 0;
    in property <float> lfo1-freq: 0.5;
    in property <float> lfo1-rate: 4.0;
    in property <float> lfo1-depth: 0.0;
    in property <float> lfo1-phase: 0.0;
    in property <int> lfo1-polarity: 0;
    in property <float> lfo1-anim-phase: 0.0;
    in property <float> lfo1-dot-y: 20.0;
    in property <bool> lfo2-enabled: true;
    in property <int> lfo2-wave: 1;
    in property <int> lfo2-rate-mode: 0;
    in property <float> lfo2-freq: 0.25;
    in property <float> lfo2-rate: 8.0;
    in property <float> lfo2-depth: 0.0;
    in property <float> lfo2-phase: 0.0;
    in property <int> lfo2-polarity: 0;
    in property <float> lfo2-anim-phase: 0.0;
    in property <float> lfo2-dot-y: 20.0;
    in property <bool> lfo3-enabled: true;
    in property <int> lfo3-wave: 2;
    in property <int> lfo3-rate-mode: 0;
    in property <float> lfo3-freq: 1.0;
    in property <float> lfo3-rate: 2.0;
    in property <float> lfo3-depth: 0.0;
    in property <float> lfo3-phase: 0.0;
    in property <int> lfo3-polarity: 0;
    in property <float> lfo3-anim-phase: 0.0;
    in property <float> lfo3-dot-y: 20.0;
    in property <bool> lfo4-enabled: true;
    in property <int> lfo4-wave: 3;
    in property <int> lfo4-rate-mode: 0;
    in property <float> lfo4-freq: 2.0;
    in property <float> lfo4-rate: 1.0;
    in property <float> lfo4-depth: 0.0;
    in property <float> lfo4-phase: 0.0;
    in property <int> lfo4-polarity: 0;
    in property <float> lfo4-anim-phase: 0.0;
    in property <float> lfo4-dot-y: 20.0;
    in property <bool> lfo-running: false;
    in-out property <bool> matrix-open: false;
    in-out property <length> matrix-y: root.base-height;
    changed matrix-open => {
        root.matrix-y = root.matrix-open ? root.base-height - 300px : root.base-height;
    }
    in property <[ModRow]> mod-rows;
    in-out property <string> mod-status: "";
    in property <bool> scope-mode: true;
    in property <bool> scope-length: true;
    in property <bool> scope-rhythm: true;
    in property <bool> scope-tone: true;
    in property <bool> scope-clock: true;
    in property <bool> scope-phase: true;
    in property <bool> scope-acid: true;
    in property <bool> scope-feel: true;
    in property <string> settings-path: "";
    in property <string> credit-author: "";
    in property <string> credit-github: "";
    in property <string> credit-support: "";
    in property <string> credit-email: "";
    in property <string> midi-folder: "";
    // DAW track hosting this instance; empty when the host does not report one.
    in property <string> track-name: "";
    // Any text field with keyboard focus. Rust reads this each frame (see `keys.rs`).
    out property <bool> text-focused: midi-input.has-focus || max-steps-box.editing || lfo1-cell.editing || lfo2-cell.editing || lfo3-cell.editing || lfo4-cell.editing;
    in-out property <string> export-status: "";
    in property <int> theme-index: 0;
    in-out property <bool> mode-menu-open: false;
    in property <[ModeEntry]> mode-entries;
    in property <[ModeRow]> mode-rows;
    in-out property <length> mode-menu-x: 0px;
    in-out property <length> mode-menu-y: 0px;
    in-out property <bool> clock-menu-open: false;
    in-out property <length> clock-menu-x: 0px;
    in-out property <length> clock-menu-y: 0px;
    in-out property <bool> wave-menu-open: false;
    // 0 = oscillator picker, 1..4 = LFO slot.
    in-out property <int> wave-menu-target: 0;
    in-out property <length> wave-menu-x: 0px;
    in-out property <length> wave-menu-y: 0px;
    in-out property <bool> scope-menu-open: false;
    in-out property <length> scope-menu-x: 0px;
    in-out property <length> scope-menu-y: 0px;
    in-out property <bool> settings-open: false;
    // Settings slide in from the right edge of the fixed 860px layout.
    in-out property <length> settings-x: root.base-width;
    changed settings-open => {
        root.settings-x = root.settings-open ? root.base-width - 300px : root.base-width;
    }
    in property <bool> free-run: false;
    in property <bool> invert-on: false;
    in property <bool> mirror-on: false;
    in property <bool> logging-on: false;
    in property <bool> generate-on: false;
    in property <[TrackRow]> tracks;
    /// 0 = off, 1 = hit, 2 = probability, 3 = accent, 4 = clear cell, 5 = ratchet, 6 = microtiming.
    in-out property <int> edit-mode: 0;
    in property <[ViewNode]> view-nodes;
    in property <string> view-edges: "M0 0";
    in property <string> view-lines: "M0 0";
    in property <string> view-hand: "M0 0";
    in property <string> mode-math: "";
    callback set-mode(int);
    /// Move the mode selection one notch in the grouped display order.
    callback step-mode(int);
    callback set-rate(int);
    callback apply-preset(int);
    callback set-osc-wave(int);
    callback set-markov-bias(float);
    callback set-lfo-enabled(int, bool);
    callback set-lfo-wave(int, int);
    callback set-lfo-rate-mode(int, int);
    callback set-lfo-speed(int, float);
    callback set-lfo-depth(int, float);
    callback set-lfo-phase(int, float);
    callback set-lfo-polarity(int, int);
    callback delete-mod(int, int);
    callback set-theme(int);
    callback set-opt(int, float);
    callback toggle-round-steps();
    callback toggle-track(int);
    callback edit-step(int, int, int);
    callback clear-edits();
    callback undo-edit();
    callback redo-edit();
    callback toggle-free-run();
    callback toggle-invert();
    callback toggle-mirror();
    callback toggle-logging();
    callback generate-pressed();
    callback randomize-pressed();
    callback toggle-scope(int);
    callback set-midi-folder(string);
    callback export-midi();

    // Expose only the controls the selected mode uses, labelled for that mode; `GenParams` still
    // carries every field.
    pure function shows-param(mode: int, key: int) -> bool {
        // pulses: hidden for modes that never read p.pulses
        if (key == 1) { return !(mode == 20 || mode == 21 || mode == 23 || mode == 24 || mode == 25 || mode == 26 || mode == 27 || mode == 29 || mode == 32); }
        // seed: hidden where the generator never reads it (the shared accent humanizer still does).
        if (key == 4) { return !(mode == 4 || mode == 11 || mode == 31 || mode == 33 || mode == 34); }
        // phase: only modes that consume p.phase
        if (key == 5) { return mode == 2 || mode == 3 || mode == 4 || mode == 6 || mode == 8 || mode == 13 || mode == 16 || mode == 17 || mode == 18 || mode == 28 || mode == 29 || mode == 30 || mode == 31 || (mode >= 33 && mode <= 38); }
        // osc_rate: oscillator, pebble, kuramoto
        if (key == 6) { return mode == 4 || mode == 16 || mode == 18; }
        // ca_rule: cellular, pebble, sieve, vuza
        if (key == 7) { return mode == 3 || mode == 16 || mode == 17 || mode == 32 || mode == 39; }
        // probability: stochastic/chaos modes
        if (key == 8) { return mode == 20 || mode == 21 || mode == 22 || mode == 23 || mode == 24 || mode == 25 || mode == 26 || mode == 27 || mode == 28 || mode == 29 || mode == 30 || mode == 31 || mode == 32; }
        // symmetry: crystallographic, sieve, cellular initial state and L-system grammar
        if (key == 11) { return mode == 3 || mode == 5 || mode == 12 || mode == 17 || mode == 39; }
        return true;
    }
    pure function pulses-max(mode: int) -> float {
        if (mode == 1) { return 3; } // Eulerian degree is 1 + pulses mod 4
        if (mode == 3) { return 15; } // cellular generation
        if (mode == 17) { return 2; } // 0 = silent, 1-2 = union terms
        if (mode == 30) { return 5; } // Hilbert order
        if (mode == 39) { return 64; } // warm-up generations
        return root.cells;
    }
    pure function pulse-label(mode: int) -> string {
        if (mode == 0) { return "Target pulses"; }
        if (mode == 1) { return "Degree"; }
        if (mode == 3) { return "Generation"; }
        if (mode == 4) { return "Requested hits"; }
        if (mode == 5) { return "Motif density"; }
        if (mode == 6) { return "Target peaks"; }
        if (mode == 7) { return "Walk activity"; }
        if (mode == 8) { return "Envelope cycles"; }
        if (mode == 9) { return "Motif pulses"; }
        if (mode == 15) { return "Target onsets"; }
        if (mode == 16) { return "Shaker impulses"; }
        if (mode == 17) { return "Sieve terms"; }
        if (mode == 18) { return "Target onsets"; }
        if (mode == 28) { return "Rotation (Omega)"; }
        if (mode == 30) { return "Order"; }
        if (mode == 31) { return "Target onsets"; }
        if (mode >= 33 && mode <= 38) { return "Target onsets"; }
        return "Pulses";
    }
    pure function density-label(mode: int) -> string {
        if (mode == 6) { return "Growth (r)"; }
        if (mode == 16) { return "Impact sensitivity"; }
        if (mode == 17) { return "Sieve density"; }
        if (mode == 18) { return "Onset density"; }
        if (mode == 28) { return "Coupling K"; }
        if (mode == 33 || mode == 34) { return "Onset density"; }
        if (mode == 35) { return "Step sigma"; }
        if (mode == 36) { return "Tail alpha"; }
        if (mode == 37) { return "Slope (mu)"; }
        if (mode == 38) { return "Map (a)"; }
        if (mode == 39) { return "Warm-up generations"; }
        return "Density";
    }
    pure function phase-label(mode: int) -> string {
        if (mode == 2) { return "Spiral phase"; }
        if (mode == 3) { return "Generation offset"; }
        if (mode == 6) { return "Initial x"; }
        if (mode == 8) { return "Envelope phase"; }
        if (mode == 13) { return "Phase offset"; }
        if (mode == 16) { return "Gravity tilt"; }
        if (mode == 17) { return "Residue shift"; }
        if (mode == 18) { return "Detune spread"; }
        if (mode == 28) { return "Start phase"; }
        if (mode == 29) { return "Word slope"; }
        if (mode == 30) { return "Rotation"; }
        if (mode == 31) { return "Spiral start"; }
        if (mode == 33 || mode == 34) { return "Window offset"; }
        if (mode == 35 || mode == 36) { return "Start position"; }
        if (mode == 37) { return "Initial x"; }
        if (mode == 38) { return "Start offset"; }
        return "Osc phase";
    }
    pure function osc-label(mode: int) -> string {
        if (mode == 16) { return "Substeps"; }
        if (mode == 18) { return "Coupling"; }
        return "Osc cycles";
    }
    pure function ca-label(mode: int) -> string {
        if (mode == 16) { return "Gravity"; }
        if (mode == 17) { return "Sieve moduli"; }
        if (mode == 39) { return "Rule preset"; }
        return "CA rule";
    }
    pure function regen-label(mode: int) -> string {
        return "Regenerate after (lengths, 0=off)";
    }
    in property <[string]> mode-names;
    property <[string]> mode-help: [
        "Places pulses as evenly as possible around the step ring with Bjorklund spacing. Each lane scales the pulse count by its density profile and anchors its word on a different phase, so the kit interleaves instead of stacking.",
        "Builds a balanced directed graph whose vertices are rest plus the eight drum lanes, then walks every edge once with Hierholzer's algorithm. The Euler circuit becomes the step sequence; density gates which visited lanes actually sound.",
        "Rotates every lane by 1/φ per step (222.49°, the mirror of the 137.51° golden angle) and lays the dots on a √i phyllotaxis rosette; the panel draws all eight lanes and a second 1/φ³ spiral in the inner band. Density and pulse ratio set how much of each lane's wedge fires.",
        "Runs a Wolfram elementary cellular automaton on a ring, one row per generation. Pulses and phase choose which generation each lane reads; the rule number decides how the row evolves.",
        "Evaluates one of eight waveforms (sine, triangle, saw, square, pulse, decay, half-sine, noise) at each step with an explicit phase and cycle count. The waveform orders the steps and a density-derived rank cutoff keeps exactly the requested number.",
        "Tiles a seeded motif across the pattern, then applies a symmetry operation per unit cell: translation, mirror, glide, inversion, screw or centering. Symmetry sets the cell size; density sets how full the motif is.",
        "Iterates the logistic map x[n+1] = r·x[n]·(1−x[n]) with r set by density. Onsets land on local peaks above a per-lane cutoff, so related phrases recur without repeating exactly.",
        "Walks a first-order transition table over rest and the eight drum voices. Weights favour role-compatible moves such as kick→snare or hat→hat; density sets the chance of an event at each step.",
        "Thresholds a smooth raised-cosine envelope whose cycle count is the requested hit count. Each envelope cycle contributes one onset, so accents stay periodic and evenly spread.",
        "Builds each lane from a short motif whose length depends on the lane and pulse count, then concatenates phrases over slow subdivisions. Shifts and phrase rules keep the lanes out of phase.",
        "Selects onsets where integer boundary crossings occur in a maximally even pulse train. The seed rotates the circular origin and modular distance shapes the accents.",
        "Generates a Christoffel/Bresenham word with exactly k onsets whose inter-onset gaps differ by at most one. Each lane gets its own phase origin, so the same word interlocks across the kit.",
        "Rewrites a two-symbol alphabet in parallel for up to sixteen generations, then reads the symbols as lane and accent roles; the panel shows the actual A/B word per step. Seed and variation choose one of four rule families.",
        "Repeats one maximally even pulse train on every lane, each copy circularly offset by a fixed span plus user and seed phase. The result is Reich-style phasing over a shared pattern length.",
        "Gives each lane a fixed integer ratio (1:1, 3:2, 2:1, 5:2, 4:3, 2:3, 5:4, 3:4) over the same pattern duration. Pulse count and density scale the number of onsets per ratio.",
        "Scores every step by metric weight, a lane-dependent shifted weight, and deterministic jitter. The highest-scoring steps become onsets, biasing the result toward offbeats and late subdivisions.",
        "Bounces eight pebbles, one per lane, in a box whose gravity can be tilted and strengthened. Each shaker impulse kicks a rotating third of them; a pebble triggers its drum when its wall impact is harder than the density-derived threshold. The panel animates the recorded positions and flashes the wall each hit struck.",
        "Builds a sieve mask from residue classes modulo small primes: two union terms minus a subtracted term. ca_rule picks the moduli, symmetry and phase pick the residues, the pulse count says how many union terms are active. The panel draws the three lattice rows and the resulting step mask; density keeps a fraction of the members.",
        "Runs eight phase oscillators, one per lane, coupled to their ring neighbours. osc_rate sets the coupling strength, phase the frequency spread, pulses the target onsets, and density the per-lane weight. The panel draws the eight phase pointers, their trails and the mean phase vector, so drift and lock are visible.",
        "Builds normal Euclidean spacing, then accent-hits every odd step. The result reads as a swung version of the same necklace, with the underlying pulse grid unchanged.",
        "Each step flips an independent Bernoulli coin per lane with probability density×probability. Lower values give sparse, unstable patterns; high values approach a solid grid.",
        "Repeats a 12-step African bell figure, rotated by a seeded lane offset and gated by probability. The interlocking rotations make the kit feel like a bell ensemble.",
        "Builds a base pulse train of the requested pulses, then shifts each lane by lane×n/8. The overlapping copies form a polymetric canon with a moving phase relationship.",
        "Thresholds a sinusoidal activator grown from reaction-diffusion dynamics. Density sets the activation threshold and probability gates each cell, producing slow blobs and filaments that break into hits.",
        "Integrates the Lorenz system (σ=10, ρ=28, β=8/3) and fires each lane on local z-peaks. The panel draws the butterfly attractor and the current orbit so the motion is visible while it plays.",
        "Samples the Cantor set at the lane's iteration depth and turns its gaps into rests. The result is a self-similar rhythm with holes at every scale, gated by density and probability.",
        "Generates a Sturmian (Fibonacci-type) word from an irrational slope and fires where floor((i+1)α) changes. The word is maximally even and avoids long runs at any density.",
        "Evolves a base pattern by random mutation and keeps changes with probability p. Density controls mutation rate; the pattern drifts while preserving its original shape.",
        "Arnold circle map: a point walks around a circle; each step it moves by Ω plus a wiggle. Pulses set the rotation number Ω, density sets the coupling K (high density means weak coupling), and phase/seed set the start. Onsets happen when the walk wraps around.",
        "Sturmian word: a maximally even rhythm built from an irrational slope. Onsets fire where floor((i+1)α) changes; no long gaps or clusters.",
        "Hilbert curve: a line that fills a square grid. Pulses select the order, phase rotates it by quarter turns, and seed shifts the curve-to-lane mapping (x+2y+i). Density thins each lane's cells evenly along the curve.",
        "Ulam spiral: write numbers in a spiral; onsets land on prime numbers. Density thins the prime hits.",
        "Vuza canon: two complementary sets tile the whole cycle with no overlaps or gaps. Recommended N (Hájos groups): 72, 108, 120, 144, 168.",
        "Thue-Morse: the parity of the 1-bits in each step index (A010060). Each lane reads a shifted window of the same self-similar word; density keeps a spread subset of the 1s, and the infinity series colours the accents.",
        "Rudin-Shapiro: the parity of overlapping 11-pairs in the step index (A020985). Each lane reads a shifted window; density keeps a spread subset of the 1s, with a seven-slot accent contour.",
        "Brownian walk: eight reflected random walks with Gaussian steps. Density sets the step size, phase sets the start position, and each lane fires on its largest steps; the panel shows lane 0's path and step sizes.",
        "Levy flight: a heavy-tailed walk built from Pareto steps. Density sets the tail index (more density means heavier jumps); each lane fires on its largest jumps and the panel shows the walk and step sizes.",
        "Tent map: x' = mu·min(x,1−x), started on the attractor after a transient. Density sets the slope, phase the initial x, and each lane fires on its highest normalized samples; the panel draws the return map.",
        "Henon map: the classic two-dimensional attractor, started near the origin with a transient and an escape guard. Density sets a, each lane fires on its largest x-moves, and the panel draws the attractor path.",
        "Life-like CA: a 16x8 torus runs one generation per step under Life, HighLife, Seeds, Day & Night or a dense survival rule. Pulses sets warm-up generations, density seeds the grid, and a lane fires when its row has live cells; accent follows population."
    ];
    pure function symmetry-label(mode: int) -> string {
        if (mode == 3) { return "Initial state"; }
        if (mode == 12) { return "Grammar"; }
        if (mode == 39) { return "Initial shape"; }
        return "Symmetry";
    }
    pure function symmetry-text(mode: int, value: float) -> string {
        let v = Math.round(value);
        if (mode == 3) {
            if (v == 1) { return "Centre"; }
            if (v == 2) { return "Stripes"; }
            if (v == 3) { return "Solid + gap"; }
            return "Random";
        }
        if (mode == 39) {
            if (v == 1) { return "Centre"; }
            if (v == 2) { return "Stripes"; }
            if (v == 3) { return "Sparse"; }
            return "Random";
        }
        if (mode == 12) {
            if (v == 1) { return "Family A"; }
            if (v == 2) { return "Family B"; }
            if (v == 3) { return "Family C"; }
            if (v == 5) { return "Family D"; }
            return "Auto";
        }
        return "\{v}";
    }

    property <[Opt]> opts: [
        { label: "Steps", min: 1, max: root.max-steps, value: root.steps, text: root.round-steps ? "\{Math.round(root.steps)}" : "\{Math.round(root.steps * 1000) / 1000}", step: root.round-steps ? 1 : 0.01, number: root.round-steps ? "\{Math.round(root.steps)}" : "\{Math.round(root.steps * 1000) / 1000}", scale: 1 },
        { label: root.pulse-label(root.mode), min: 0, max: root.pulses-max(root.mode), value: Math.min(root.pulses, root.pulses-max(root.mode)), text: "\{Math.round(Math.min(root.pulses, root.pulses-max(root.mode)))}", step: 1, number: "\{Math.round(Math.min(root.pulses, root.pulses-max(root.mode)))}", scale: 1 },
        { label: "Rotate", min: 0, max: Math.max(root.cells - 1, 0), value: Math.min(root.rotate, Math.max(root.cells - 1, 0)), text: "\{Math.round(Math.min(root.rotate, Math.max(root.cells - 1, 0)))}", step: 1, number: "\{Math.round(Math.min(root.rotate, Math.max(root.cells - 1, 0)))}", scale: 1 },
        { label: root.density-label(root.mode), min: 0, max: 1, value: root.density, text: "\{Math.round(root.density * 100)}%", step: 0.01, number: "\{Math.round(root.density * 100)}", scale: 0.01 },
        { label: "Seed", min: 0, max: 1, value: root.seed, text: "\{Math.round(root.seed * 1000) / 1000}", step: 0.001, number: "\{Math.round(root.seed * 1000) / 1000}", scale: 1 },
        { label: root.phase-label(root.mode), min: 0, max: 1, value: root.phase, text: "\{Math.round(root.phase * 360)}°", step: 0.01, number: "\{Math.round(root.phase * 360)}", scale: 1.0 / 360.0 },
        { label: root.osc-label(root.mode), min: root.mode == 16 ? 1 : 0.125, max: root.mode == 16 ? 16 : 8, value: root.mode == 16 ? Math.max(root.osc-rate, 1) : root.osc-rate, text: root.mode == 16 ? "\{Math.round(Math.max(root.osc-rate, 1))}" : "\{Math.round(root.osc-rate * 100) / 100}", step: root.mode == 16 ? 1 : 0.125, number: root.mode == 16 ? "\{Math.round(Math.max(root.osc-rate, 1))}" : "\{Math.round(root.osc-rate * 100) / 100}", scale: 1 },
        { label: root.ca-label(root.mode), min: 0, max: 255, value: root.ca-rule, text: root.mode == 16 ? "\{Math.round(root.ca-rule / 255 * 100)}%" : "\{Math.round(root.ca-rule)}", step: 1, number: root.mode == 16 ? "\{Math.round(root.ca-rule / 255 * 100)}" : "\{Math.round(root.ca-rule)}", scale: root.mode == 16 ? 2.55 : 1 },
        { label: "Probability", min: 0, max: 1, value: root.probability, text: "\{Math.round(root.probability * 100)}%", step: 0.01, number: "\{Math.round(root.probability * 100)}", scale: 0.01 },
        { label: "Velocity", min: 0.01, max: 1, value: root.velocity, text: "\{Math.round(root.velocity * 100)}%", step: 0.01, number: "\{Math.round(root.velocity * 100)}", scale: 0.01 },
        { label: root.regen-label(root.mode), min: 0, max: 256, value: root.regenerate-every, text: "\{Math.round(root.regenerate-every)}", step: 1, number: "\{Math.round(root.regenerate-every)}", scale: 1 },
        { label: root.symmetry-label(root.mode), min: 1, max: 8, value: root.symmetry, text: root.symmetry-text(root.mode, root.symmetry), step: 1, number: "\{Math.round(root.symmetry)}", scale: 1 },
        { label: "Randomize after lengths", min: 0, max: 256, value: root.randomize-after-lengths, text: "\{Math.round(root.randomize-after-lengths)}", step: 1, number: "\{Math.round(root.randomize-after-lengths)}", scale: 1 },
        { label: "Swing", min: 0, max: 0.5, value: root.swing, text: "\{Math.round(root.swing * 300)}%", step: 0.01, number: "\{Math.round(root.swing * 300)}", scale: 1.0 / 300.0 },
        { label: "Gate", min: 0.02, max: 1, value: root.gate, text: "\{Math.round(root.gate * 100)}%", step: 0.01, number: "\{Math.round(root.gate * 100)}", scale: 0.01 },
        { label: "Transition bias", min: 0, max: 255, value: root.markov-bias, text: "\{Math.round(root.markov-bias)}", step: 1, number: "\{Math.round(root.markov-bias)}", scale: 1 }
    ];

    // One fixed 860x740 coordinate space; the matrix scrolls fixed-width cells, so nothing reflows.
    Rectangle {
        width: root.base-width; height: root.base-height;

        // Faint graph paper for Sketch; it sits below the layout so only gaps between cards show it.
        Rectangle {
            visible: root.theme-index == 0;
            for i in 38: Rectangle { y: (i + 1) * 20px; height: 1px; background: Theme.border.with-alpha(0.16); }
            for i in 43: Rectangle { x: (i + 1) * 20px; width: 1px; height: parent.height; background: Theme.border.with-alpha(0.16); }
        }
        Timer {
            interval: 180ms;
            running: root.regen-pulse;
            triggered => { root.regen-pulse = false; }
        }
        Timer {
            interval: 4s;
            running: root.mod-status != "";
            triggered => { root.mod-status = ""; }
        }
        Rectangle {
            visible: root.regen-pulse;
            width: parent.width; height: parent.height;
            background: Theme.c1.with-alpha(0.10);
        }

    VerticalLayout {
        padding: 14px; spacing: 8px;
        HorizontalLayout {
            height: 34px; spacing: 6px;
            Text { text: "nrum seq"; color: Theme.text; font-family: "Consolas"; font-size: 24px; font-weight: 700; letter-spacing: 0.5px; vertical-alignment: center; }
            Text { visible: root.track-name != ""; text: "· \{root.track-name}"; color: Theme.text-muted; font-size: 10px; vertical-alignment: center; overflow: elide; }
            // Hover descriptions live in the header. This is always at the top, cannot sit under the
            // pointer, and costs no overlay or hover hit-testing.
            Text {
                horizontal-stretch: 1;
                text: HoverTip.text;
                color: Theme.text-muted; font-size: 9px;
                vertical-alignment: center; overflow: elide;
            }
            Text { text: "CLOCK RATE"; color: Theme.text-muted; font-size: 9px; vertical-alignment: center; }
            // Clock-rate picker: sized like nelody seq's rate field.
            Rectangle {
                width: 70px; height: 25px; border-radius: 4px; background: clock-field-touch.has-hover ? Theme.control-hover : Theme.control; border-width: 1px; border-color: Theme.border;
                Text { x: 0px; width: parent.width; height: parent.height; text: root.rate < root.rate-names.length ? root.rate-names[root.rate] : ""; color: Theme.text; font-size: 9px; horizontal-alignment: center; vertical-alignment: center; overflow: elide; }
                clock-field-touch := TipTouch { hint: "Choose the clock rate";
                    clicked => {
                        root.clock-menu-open = !root.clock-menu-open;
                        if (root.clock-menu-open) { root.clock-menu-x = clock-field-touch.absolute-position.x; root.clock-menu-y = clock-field-touch.absolute-position.y + clock-field-touch.height + 2px; }
                        root.wave-menu-open = false;
                    }
                    scroll-event(e) => {
                        if (e.delta-y != 0px) {
                            root.set-rate((root.rate + (e.delta-y > 0px ? 1 : -1)).clamp(0, root.rate-names.length - 1));
                            accept
                        } else {
                            reject
                        }
                    }
                }
            }
            Rectangle { width: 72px; height: 24px; border-radius: 4px; background: root.free-run ? Theme.c1.with-alpha(0.22) : Theme.control; Text { text: "free-run"; color: Theme.text; font-size: 9px; horizontal-alignment: center; vertical-alignment: center; } free-touch := TipTouch { hint: "Run the internal clock when the host transport is stopped"; clicked => { root.toggle-free-run(); } } }
            Text { text: root.free-run ? "FREE-RUN CLOCK: ON" : "SYNC: HOST TRANSPORT"; color: root.free-run ? Theme.c1 : Theme.text-muted; font-size: 9px; vertical-alignment: center; }
            Rectangle { width: 112px; height: 30px; border-radius: 5px; background: generate-touch.has-hover ? Theme.hi : Theme.control; Text { text: root.generate-on ? "RE-GENERATE ↻" : "GENERATE ↻"; color: generate-touch.has-hover ? Theme.on-accent : Theme.text; font-size: 10px; horizontal-alignment: center; vertical-alignment: center; } generate-touch := TipTouch { hint: "Create a new deterministic variation of the current pattern"; clicked => { root.regen-pulse = true; root.generate-pressed(); } } }
            Rectangle { width: 112px; height: 30px; border-radius: 5px; background: randomize-touch.has-hover ? Theme.c3 : Theme.control; Text { text: "RANDOMIZE ⚄"; color: randomize-touch.has-hover ? Theme.on-accent : Theme.text; font-size: 10px; horizontal-alignment: center; vertical-alignment: center; } randomize-touch := TipTouch { hint: "Randomize the parameter groups enabled in RANDOMIZE SCOPE"; clicked => { root.randomize-pressed(); } } }
            Rectangle { width: 40px; height: 30px; border-radius: 5px; background: settings-touch.has-hover ? Theme.c2.with-alpha(0.5) : Theme.control; Text { text: "⚙"; color: settings-touch.has-hover ? Theme.on-accent : Theme.text; font-size: 14px; horizontal-alignment: center; vertical-alignment: center; } settings-touch := TipTouch { hint: "Open settings: theme, presets, limits, export and credits"; clicked => { root.settings-open = !root.settings-open; } } }
        }
        HorizontalLayout {
            // 300px fits the description and live math line without squeezing the sliders.
            height: 300px; spacing: 10px;
            ModePanel { nodes: root.view-nodes; edges: root.view-edges; lines: root.view-lines; hand: root.view-hand; }
            VerticalLayout {
                spacing: 3px; alignment: start;
                mode-header := Rectangle {
                    height: 30px; border-radius: 4px;
                    background: mode-menu-touch.has-hover ? Theme.control-hover : Theme.control;
                    Text { x: 8px; width: parent.width - 16px; height: parent.height; text: "MODE  ·  \{root.mode-names[root.mode]}  ▾"; color: Theme.c1; font-size: 13px; font-weight: 700; vertical-alignment: center; overflow: elide; }
                    mode-menu-touch := TipTouch { hint: "Open the grouped generator mode list";
                        clicked => {
                            root.mode-menu-open = !root.mode-menu-open;
                            if (root.mode-menu-open) {
                                root.mode-menu-x = mode-header.absolute-position.x;
                                root.mode-menu-y = mode-header.absolute-position.y + mode-header.height + 2px;
                            }
                        }
                        scroll-event(e) => {
                            if (e.delta-y != 0px) {
                                root.step-mode(e.delta-y > 0px ? 1 : -1);
                                accept
                            } else {
                                reject
                            }
                        }
                    }
                }
                VerticalLayout {
                    spacing: 0px;
                    Text { text: root.mode-help[root.mode]; color: Theme.text; font-size: 13px; wrap: word-wrap; }
                    // Live formula with the current snapshot, pushed from the generator's own helpers.
                    Text { text: root.mode-math; color: Theme.text-muted; font-size: 11px; wrap: word-wrap; }
                }
                Rectangle { height: 2px; }
                HorizontalLayout { spacing: 5px;
                    OptSlider { opt: root.opts[0]; mod-target: 0; changed(v) => { root.set-opt(0, v); } }
                    if root.shows-param(root.mode, 1): OptSlider { opt: root.opts[1]; mod-target: 1; changed(v) => { root.set-opt(1, v); } }
                    OptSlider { opt: root.opts[2]; mod-target: 2; changed(v) => { root.set-opt(2, v); } }
                    OptSlider { opt: root.opts[3]; mod-target: 3; changed(v) => { root.set-opt(3, v); } }
                }
                HorizontalLayout {
                    spacing: 5px;
                    OptSlider { opt: root.opts[4]; mod-target: 4; changed(v) => { root.set-opt(4, v); } }
                    if root.shows-param(root.mode, 5): OptSlider { opt: root.opts[5]; mod-target: 5; changed(v) => { root.set-opt(5, v); } }
                    if root.shows-param(root.mode, 6): OptSlider { opt: root.opts[6]; mod-target: 6; changed(v) => { root.set-opt(6, v); } }
                    if root.shows-param(root.mode, 7): OptSlider { opt: root.opts[7]; mod-target: 7; changed(v) => { root.set-opt(7, v); } }
                }
                HorizontalLayout { spacing: 5px;
                    OptSlider { horizontal-stretch: 1; opt: root.opts[8]; mod-target: 8; changed(v) => { root.set-opt(8, v); } }
                    OptSlider { width: 100px; opt: root.opts[9]; mod-target: 11; changed(v) => { root.set-opt(9, v); } }
                    OptSlider { width: 100px; opt: root.opts[13]; mod-target: 9; changed(v) => { root.set-opt(13, v); } }
                    OptSlider { width: 82px; opt: root.opts[14]; mod-target: 10; changed(v) => { root.set-opt(15, v); } }
                }
                if root.shows-param(root.mode, 11): HorizontalLayout { spacing: 5px; OptSlider { opt: root.opts[11]; mod-target: 13; changed(v) => { root.set-opt(11, v); } } }
                if root.mode == 7: HorizontalLayout { spacing: 5px; OptSlider { width: 170px; opt: root.opts[16]; changed(v) => { root.set-markov-bias(v); } } Text { horizontal-stretch: 1; text: "rest · repeat · role · novelty (2 bits each)"; color: Theme.text-muted; font-size: 8px; vertical-alignment: center; overflow: elide; } }
                if root.mode == 4: HorizontalLayout {
                    WavePicker {
                        width: 200px; height: 28px;
                        paths: root.wave-paths; names: root.wave-names; current: root.osc-wave;
                        selected(i) => { root.set-osc-wave(i); }
                        opened(x, y) => {
                            root.wave-menu-open = true;
                            root.wave-menu-target = 0;
                            root.wave-menu-x = x;
                            root.wave-menu-y = y + 2px;
                            root.clock-menu-open = false;
                        }
                    }
                    Rectangle { horizontal-stretch: 1; }
                }
            }
        }
        HorizontalLayout { spacing: 8px;
            Rectangle { width: 74px; height: 20px; border-radius: 3px; background: root.invert-on ? Theme.c2.with-alpha(0.35) : Theme.control; Text { text: "INVERT"; color: Theme.text; font-size: 8px; horizontal-alignment: center; vertical-alignment: center; } invert-touch := TipTouch { hint: "Swap every generated hit with a rest"; clicked => { root.toggle-invert(); } } }
            Rectangle { width: 74px; height: 20px; border-radius: 3px; background: root.mirror-on ? Theme.c3.with-alpha(0.35) : Theme.control; Text { text: "MIRROR"; color: Theme.text; font-size: 8px; horizontal-alignment: center; vertical-alignment: center; } mirror-touch := TipTouch { hint: "Reverse the generated steps after rotation"; clicked => { root.toggle-mirror(); } } }
            Rectangle { width: 32px; height: 20px; border-radius: 3px; background: root.edit-mode == 1 ? Theme.c1.with-alpha(0.75) : Theme.control; Text { text: "HIT"; color: root.edit-mode == 1 ? Theme.on-accent : Theme.text; font-size: 8px; horizontal-alignment: center; vertical-alignment: center; } hit-edit-touch := TipTouch { hint: "Edit mode: click a step to cycle auto / force on / force off"; clicked => { root.edit-mode = root.edit-mode == 1 ? 0 : 1; } } }
            Rectangle { width: 34px; height: 20px; border-radius: 3px; background: root.edit-mode == 2 ? Theme.c2.with-alpha(0.75) : Theme.control; Text { text: "PROB"; color: root.edit-mode == 2 ? Theme.on-accent : Theme.text; font-size: 8px; horizontal-alignment: center; vertical-alignment: center; } prob-edit-touch := TipTouch { hint: "Edit mode: cycle a step's hit probability"; clicked => { root.edit-mode = root.edit-mode == 2 ? 0 : 2; } } }
            Rectangle { width: 34px; height: 20px; border-radius: 3px; background: root.edit-mode == 3 ? Theme.c3.with-alpha(0.75) : Theme.control; Text { text: "ACC"; color: root.edit-mode == 3 ? Theme.on-accent : Theme.text; font-size: 8px; horizontal-alignment: center; vertical-alignment: center; } acc-edit-touch := TipTouch { hint: "Edit mode: cycle a step's accent"; clicked => { root.edit-mode = root.edit-mode == 3 ? 0 : 3; } } }
            Rectangle { width: 34px; height: 20px; border-radius: 3px; background: root.edit-mode == 4 ? Theme.hi.with-alpha(0.75) : Theme.control; Text { text: "CLR"; color: root.edit-mode == 4 ? Theme.on-accent : Theme.text; font-size: 8px; horizontal-alignment: center; vertical-alignment: center; } clr-edit-touch := TipTouch { hint: "Edit mode: clear every manual edit on a step"; clicked => { root.edit-mode = root.edit-mode == 4 ? 0 : 4; } } }
            Rectangle { width: 48px; height: 20px; border-radius: 3px; background: clear-edits-touch.has-hover ? Theme.hi : Theme.control; Text { text: "CLR ALL"; color: clear-edits-touch.has-hover ? Theme.on-accent : Theme.text; font-size: 8px; horizontal-alignment: center; vertical-alignment: center; } clear-edits-touch := TipTouch { hint: "Clear all manual step edits in this pattern"; clicked => { root.clear-edits(); } } }
            Rectangle { width: 32px; height: 20px; border-radius: 3px; background: root.edit-mode == 5 ? Theme.c1.with-alpha(0.75) : Theme.control; Text { text: "RAT"; color: root.edit-mode == 5 ? Theme.on-accent : Theme.text; font-size: 8px; horizontal-alignment: center; vertical-alignment: center; } rat-edit-touch := TipTouch { hint: "Edit mode: cycle 1–4 ratchet substeps on a step"; clicked => { root.edit-mode = root.edit-mode == 5 ? 0 : 5; } } }
            Rectangle { width: 38px; height: 20px; border-radius: 3px; background: root.edit-mode == 6 ? Theme.c3.with-alpha(0.75) : Theme.control; Text { text: "TIME"; color: root.edit-mode == 6 ? Theme.on-accent : Theme.text; font-size: 8px; horizontal-alignment: center; vertical-alignment: center; } time-edit-touch := TipTouch { hint: "Edit mode: delay a step by 0, 1/8, 1/4 or 1/2 step"; clicked => { root.edit-mode = root.edit-mode == 6 ? 0 : 6; } } }
            Rectangle { width: 38px; height: 20px; border-radius: 3px; background: undo-touch.has-hover ? Theme.control-hover : Theme.control; Text { text: "UNDO"; color: Theme.text; font-size: 8px; horizontal-alignment: center; vertical-alignment: center; } undo-touch := TipTouch { hint: "Undo the last manual step edit"; clicked => { root.undo-edit(); } } }
            Rectangle { width: 38px; height: 20px; border-radius: 3px; background: redo-touch.has-hover ? Theme.control-hover : Theme.control; Text { text: "REDO"; color: Theme.text; font-size: 8px; horizontal-alignment: center; vertical-alignment: center; } redo-touch := TipTouch { hint: "Redo the last undone step edit"; clicked => { root.redo-edit(); } } }
            Rectangle { horizontal-stretch: 1; }
            Rectangle { width: 92px; height: 20px; border-radius: 3px; background: root.follow-step ? Theme.c1.with-alpha(0.7) : Theme.control; Text { text: root.follow-step ? "FOLLOW: ON" : "FOLLOW: OFF"; color: root.follow-step ? Theme.on-accent : Theme.text; font-size: 8px; horizontal-alignment: center; vertical-alignment: center; } follow-touch := TipTouch { hint: "Keep the matrix scrolled to the playhead"; clicked => { root.follow-step = !root.follow-step; } } }
        }
        HorizontalLayout {
            spacing: 4px;
            VerticalLayout {
                spacing: 4px;
                for track in root.tracks: Rectangle {
                    width: 76px; height: 22px; border-radius: 3px;
                    background: track.enabled ? Theme.control : Theme.cell-off;
                    Text { x: 4px; width: parent.width - 8px; height: parent.height; text: track.name; color: track.enabled ? Theme.text : Theme.text-muted.with-alpha(0.55); font-size: 9px; vertical-alignment: center; overflow: elide; }
                    TipTouch {
                        hint: track.name + " · note " + track.note + " · click to enable or disable";
                        clicked => { root.toggle-track(track.index); }
                    }
                }
            }
            matrix-scroll := ScrollView {
                horizontal-stretch: 1; height: 210px;
                vertical-scrollbar-policy: always-off;
                horizontal-scrollbar-policy: as-needed;
                viewport-width: root.cells * root.matrix-cell-width;
                viewport-x <=> root.matrix-x;
                // User drags/wheel disable following; the follow write lands on `follow-x()`.
                scrolled() => {
                    if (Math.abs(root.matrix-x - root.follow-x()) > 2px) { root.follow-step = false; }
                }
                VerticalLayout {
                    width: root.cells * root.matrix-cell-width;
                    spacing: 4px;
                    for track in root.tracks: Rectangle {
                        height: 22px;
                        HorizontalLayout {
                            spacing: 0px;
                            for cell in track.cells: Rectangle {
                                width: root.matrix-cell-width; height: 20px;
                                Rectangle {
                                    x: 0px; y: 0px;
                                    width: parent.width - 1px; height: parent.height;
                                    border-radius: 2px;
                                    background: cell.hit ? (cell.velocity > 0.82 ? Theme.c1 : Theme.c2.with-alpha(0.85)) : Theme.cell-off;
                                    opacity: track.enabled ? (cell.hit ? (0.25 + 0.75 * cell.velocity * cell.probability) : 1.0) : 0.35;
                                    border-width: cell.playing ? 2px : (cell.edited ? 1px : 0px); border-color: cell.playing ? Theme.hi : Theme.border;
                                    // Velocity bar: height encodes velocity.
                                    if cell.hit: Rectangle {
                                        x: 1px; y: parent.height - Math.max(2px, cell.velocity * (parent.height - 2px));
                                        width: parent.width - 3px; height: Math.max(2px, cell.velocity * (parent.height - 2px));
                                        border-radius: 1px;
                                        background: Theme.hi.with-alpha(0.55);
                                    }
                                    // Probability indicator: top strip whose opacity encodes probability.
                                    if cell.hit && cell.probability < 1.0: Rectangle {
                                        x: 1px; y: 1px;
                                        width: parent.width - 3px; height: 2px;
                                        border-radius: 1px;
                                        background: Theme.on-accent.with-alpha(0.9 * (1.0 - cell.probability));
                                    }
                                    // Manual edit markers: force-on bottom-right, force-off top-right.
                                    if cell.hit-override == 1: Rectangle {
                                        x: parent.width - 4px; y: parent.height - 4px; width: 3px; height: 3px;
                                        border-radius: 1px; background: Theme.c2;
                                    }
                                    if cell.hit-override == 2: Rectangle {
                                        x: parent.width - 4px; y: 1px; width: 3px; height: 3px;
                                        border-radius: 1px; background: Theme.hi;
                                    }
                                }
                            }
                        }
                        if root.edit-mode > 0: Rectangle {
                            x: 0px; y: 0px; width: parent.width; height: parent.height;
                            background: transparent;
                            editor-ta := TouchArea {
                                clicked => {
                                    let step = Math.floor(editor-ta.mouse-x / root.matrix-cell-width);
                                    root.edit-step(track.index, step, root.edit-mode);
                                }
                            }
                        }
                    }
                }
            }
        }
        // Four runtime LFOs in a 2x2 rack; the colored point is the drag handle.
        Rectangle {
            height: 88px; border-radius: 4px;
            background: Theme.surface; border-width: 1px; border-color: Theme.border;
            VerticalLayout {
                padding: 5px; spacing: 3px;
                HorizontalLayout {
                    height: 16px; spacing: 5px;
                    Text { text: "LFO MODULATION"; color: Theme.text-muted; font-size: 9px; vertical-alignment: center; }
                    Text {
                        horizontal-stretch: 1;
                        text: root.mod-status != "" ? root.mod-status : "drag a colored point onto a parameter · click a name to disable";
                        color: root.mod-status != "" ? Theme.c2 : Theme.text-muted;
                        font-size: 8px; horizontal-alignment: right; vertical-alignment: center; overflow: elide;
                    }
                    Rectangle {
                        width: 58px; height: 15px; border-radius: 3px;
                        background: root.matrix-open ? Theme.c2.with-alpha(0.55) : (matrix-touch.has-hover ? Theme.control-hover : Theme.control);
                        Text { text: "MATRIX ▤"; color: root.matrix-open ? Theme.on-accent : Theme.text; font-size: 8px; horizontal-alignment: center; vertical-alignment: center; }
                        matrix-touch := TipTouch { hint: "Show or hide the LFO modulation matrix";
                            clicked => {
                                root.matrix-open = !root.matrix-open;
                                root.mode-menu-open = false;
                                root.clock-menu-open = false;
                                root.wave-menu-open = false;
                                root.scope-menu-open = false;
                                root.settings-open = false;
                            }
                        }
                    }
                }
                HorizontalLayout {
                    height: 28px; spacing: 5px;
                    lfo1-cell := LfoCell {
                        horizontal-stretch: 1;
                        index: 1; enabled: root.lfo1-enabled; wave: root.lfo1-wave; rate-mode: root.lfo1-rate-mode;
                        freq: root.lfo1-freq; beats: root.lfo1-rate; depth: root.lfo1-depth;
                        phase: root.lfo1-phase; polarity: root.lfo1-polarity;
                        anim-phase: root.lfo1-anim-phase; dot-y: root.lfo1-dot-y; running: root.lfo-running;
                        wave-paths: root.wave-paths; wave-names: root.wave-names;
                        wave-selected(i) => { root.set-lfo-wave(1, i); }
                        wave-opened(x, y) => { root.wave-menu-open = true; root.wave-menu-target = 1; root.wave-menu-x = x; root.wave-menu-y = y - (root.wave-paths.length * 26px + 36px); }
                        enabled-toggled => { root.set-lfo-enabled(1, !root.lfo1-enabled); }
                        rate-mode-toggled => { root.set-lfo-rate-mode(1, root.lfo1-rate-mode == 0 ? 1 : 0); }
                        speed-changed(v) => { root.set-lfo-speed(1, v); }
                        depth-changed(v) => { root.set-lfo-depth(1, v); }
                        phase-changed(v) => { root.set-lfo-phase(1, v); }
                        polarity-toggled => { root.set-lfo-polarity(1, Math.mod(root.lfo1-polarity + 1, 3)); }
                    }
                    lfo2-cell := LfoCell {
                        horizontal-stretch: 1;
                        index: 2; enabled: root.lfo2-enabled; wave: root.lfo2-wave; rate-mode: root.lfo2-rate-mode;
                        freq: root.lfo2-freq; beats: root.lfo2-rate; depth: root.lfo2-depth;
                        phase: root.lfo2-phase; polarity: root.lfo2-polarity;
                        anim-phase: root.lfo2-anim-phase; dot-y: root.lfo2-dot-y; running: root.lfo-running;
                        wave-paths: root.wave-paths; wave-names: root.wave-names;
                        wave-selected(i) => { root.set-lfo-wave(2, i); }
                        wave-opened(x, y) => { root.wave-menu-open = true; root.wave-menu-target = 2; root.wave-menu-x = x; root.wave-menu-y = y - (root.wave-paths.length * 26px + 36px); }
                        enabled-toggled => { root.set-lfo-enabled(2, !root.lfo2-enabled); }
                        rate-mode-toggled => { root.set-lfo-rate-mode(2, root.lfo2-rate-mode == 0 ? 1 : 0); }
                        speed-changed(v) => { root.set-lfo-speed(2, v); }
                        depth-changed(v) => { root.set-lfo-depth(2, v); }
                        phase-changed(v) => { root.set-lfo-phase(2, v); }
                        polarity-toggled => { root.set-lfo-polarity(2, Math.mod(root.lfo2-polarity + 1, 3)); }
                    }
                }
                HorizontalLayout {
                    height: 28px; spacing: 5px;
                    lfo3-cell := LfoCell {
                        horizontal-stretch: 1;
                        index: 3; enabled: root.lfo3-enabled; wave: root.lfo3-wave; rate-mode: root.lfo3-rate-mode;
                        freq: root.lfo3-freq; beats: root.lfo3-rate; depth: root.lfo3-depth;
                        phase: root.lfo3-phase; polarity: root.lfo3-polarity;
                        anim-phase: root.lfo3-anim-phase; dot-y: root.lfo3-dot-y; running: root.lfo-running;
                        wave-paths: root.wave-paths; wave-names: root.wave-names;
                        wave-selected(i) => { root.set-lfo-wave(3, i); }
                        wave-opened(x, y) => { root.wave-menu-open = true; root.wave-menu-target = 3; root.wave-menu-x = x; root.wave-menu-y = y - (root.wave-paths.length * 26px + 36px); }
                        enabled-toggled => { root.set-lfo-enabled(3, !root.lfo3-enabled); }
                        rate-mode-toggled => { root.set-lfo-rate-mode(3, root.lfo3-rate-mode == 0 ? 1 : 0); }
                        speed-changed(v) => { root.set-lfo-speed(3, v); }
                        depth-changed(v) => { root.set-lfo-depth(3, v); }
                        phase-changed(v) => { root.set-lfo-phase(3, v); }
                        polarity-toggled => { root.set-lfo-polarity(3, Math.mod(root.lfo3-polarity + 1, 3)); }
                    }
                    lfo4-cell := LfoCell {
                        horizontal-stretch: 1;
                        index: 4; enabled: root.lfo4-enabled; wave: root.lfo4-wave; rate-mode: root.lfo4-rate-mode;
                        freq: root.lfo4-freq; beats: root.lfo4-rate; depth: root.lfo4-depth;
                        phase: root.lfo4-phase; polarity: root.lfo4-polarity;
                        anim-phase: root.lfo4-anim-phase; dot-y: root.lfo4-dot-y; running: root.lfo-running;
                        wave-paths: root.wave-paths; wave-names: root.wave-names;
                        wave-selected(i) => { root.set-lfo-wave(4, i); }
                        wave-opened(x, y) => { root.wave-menu-open = true; root.wave-menu-target = 4; root.wave-menu-x = x; root.wave-menu-y = y - (root.wave-paths.length * 26px + 36px); }
                        enabled-toggled => { root.set-lfo-enabled(4, !root.lfo4-enabled); }
                        rate-mode-toggled => { root.set-lfo-rate-mode(4, root.lfo4-rate-mode == 0 ? 1 : 0); }
                        speed-changed(v) => { root.set-lfo-speed(4, v); }
                        depth-changed(v) => { root.set-lfo-depth(4, v); }
                        phase-changed(v) => { root.set-lfo-phase(4, v); }
                        polarity-toggled => { root.set-lfo-polarity(4, Math.mod(root.lfo4-polarity + 1, 3)); }
                    }
                }
            }
        }
        HorizontalLayout {
            height: 27px; spacing: 5px;
            HorizontalLayout {
                spacing: 0px;
                OptSlider { width: 205px; opt: root.opts[12]; mod-target: 14; changed(v) => { root.set-opt(12, v); } }
                scope-gear := Rectangle {
                    width: 25px; height: 25px; border-radius: 4px;
                    background: root.scope-menu-open ? Theme.c2.with-alpha(0.5) : (scope-touch.has-hover ? Theme.control-hover : Theme.control);
                    Text { text: "⚙"; color: Theme.text; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
                    scope-touch := TipTouch { hint: "Toggle this group for RANDOMIZE";
                        clicked => {
                            root.scope-menu-open = !root.scope-menu-open;
                            if (root.scope-menu-open) {
                                root.scope-menu-x = scope-gear.absolute-position.x + scope-gear.width - 160px;
                                root.scope-menu-y = scope-gear.absolute-position.y - 118px;
                            }
                        }
                    }
                }
            }
            OptSlider { width: 230px; opt: root.opts[10]; mod-target: 12; changed(v) => { root.set-opt(10, v); } }
            Rectangle { horizontal-stretch: 1; }
            Text { text: root.export-status; color: Theme.text-muted; font-size: 9px; vertical-alignment: center; overflow: elide; }
            Rectangle {
                width: 96px; height: 24px; border-radius: 4px;
                background: export-touch.has-hover ? Theme.c2 : Theme.control;
                Text { text: "EXPORT MIDI"; color: export-touch.has-hover ? Theme.on-accent : Theme.text; font-size: 9px; horizontal-alignment: center; vertical-alignment: center; }
                export-touch := TipTouch { hint: "Write one loop as a Standard MIDI File"; clicked => { root.export-midi(); } }
            }
        }
    }

    // Floating LFO number follows the pointer while a modulation point is dragged.
    if ModDrag.lfo > 0: Rectangle {
        x: ModDrag.x - 11px; y: ModDrag.y - 11px; width: 22px; height: 22px;
        border-radius: 11px;
        background: ModDrag.lfo == 1 ? Theme.c1 : (ModDrag.lfo == 2 ? Theme.c2 : (ModDrag.lfo == 3 ? Theme.c3 : Theme.hi));
        border-width: 2px; border-color: Theme.on-accent;
        Text { text: "\{ModDrag.lfo}"; color: Theme.on-accent; font-size: 10px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
    }

    // Grouped mode dropdown (nelody seq-style), anchored to the mode header.
    if root.mode-menu-open: Rectangle {
        x: 0px; y: 0px; width: root.base-width; height: root.base-height;
        background: #00000044;
        TouchArea { clicked => { root.mode-menu-open = false; } }
    }
    if root.mode-menu-open: ModeDropdown {
        x: Math.min(root.mode-menu-x, root.base-width - 460px);
        y: Math.min(root.mode-menu-y, root.base-height - 432px);
        rows: root.mode-rows; names: root.mode-names; current: root.mode;
        selected(i) => { root.set-mode(i); root.mode-menu-open = false; }
    }

    // Parked off-screen when closed so the closing animation can play. Tie the scrim to the
    // animated position, not the boolean, so it cannot swallow clicks while the panel travels out.
    // Keep the LFO rack outside the scrim so links can still be dragged onto Max Steps.
    if root.settings-x < root.base-width: Rectangle {
        x: 0px; y: 0px; width: root.base-width; height: root.base-height - 105px;
        background: #00000066;
        TouchArea { clicked => { root.settings-open = false; } }
    }
    Rectangle {
        x: root.settings-x; y: 0px; width: 300px; height: root.base-height;
        background: Theme.surface; border-width: 1px; border-color: Theme.border;
        drop-shadow-blur: 16px; drop-shadow-color: #00000055; drop-shadow-offset-y: 4px;
        animate x { duration: 140ms; easing: ease-in-out; }
        VerticalLayout {
            padding: 12px; spacing: 8px;
            HorizontalLayout {
                height: 24px;
                Text { text: "SETTINGS"; color: Theme.c1; font-size: 12px; font-weight: 700; vertical-alignment: center; }
                Rectangle { width: 74px; height: 22px; border-radius: 4px; background: close-settings.has-hover ? Theme.hi : Theme.control; Text { text: "CLOSE"; color: close-settings.has-hover ? Theme.on-accent : Theme.text; font-size: 9px; horizontal-alignment: center; vertical-alignment: center; } close-settings := TipTouch { hint: "Close settings"; clicked => { root.settings-open = false; } } }
            }
            Text { text: "COLOUR THEME"; color: Theme.text-muted; font-size: 9px; }
            Selector { options: ["Sketch", "Neon", "Lava", "Forest"]; current: root.theme-index; text-size: 10px; selected(i) => { root.set-theme(i); } }
            Text { text: "STARTING POINTS"; color: Theme.text-muted; font-size: 9px; }
            HorizontalLayout {
                spacing: 3px; height: 22px;
                for i in root.preset-names.length: Rectangle {
                    width: (parent.width - 15px) / 6; height: 22px; border-radius: 3px;
                    background: preset-touch.has-hover ? Theme.c2.with-alpha(0.7) : Theme.control;
                    Text { text: root.preset-names[i]; color: preset-touch.has-hover ? Theme.on-accent : Theme.text; font-size: 7px; horizontal-alignment: center; vertical-alignment: center; overflow: elide; }
                    preset-touch := TipTouch { hint: "Load this starting-point preset into the host parameters"; clicked => { root.apply-preset(i); } }
                }
            }
            Text { text: "CONFIG FILE"; color: Theme.text-muted; font-size: 9px; }
            Text { text: root.settings-path; color: Theme.text-muted; font-size: 8px; wrap: word-wrap; }
            Text { text: "STEP SPACING"; color: Theme.text-muted; font-size: 9px; }
            // Turning rounding off lets the loop wrap between grid cells and drift against the grid.
            Rectangle {
                height: 26px; border-radius: 4px;
                background: root.round-steps ? Theme.c1.with-alpha(0.8) : (round-touch.has-hover ? Theme.control-hover : Theme.control);
                Text {
                    x: 8px; width: parent.width - 16px;
                    text: root.round-steps ? "WHOLE STEPS ONLY" : "FRACTIONAL STEPS";
                    color: root.round-steps ? Theme.on-accent : Theme.text;
                    font-size: 9px; vertical-alignment: center;
                }
                round-touch := TipTouch { hint: "Snap the loop length to whole step cells"; clicked => { root.toggle-round-steps(); } }
            }
            Text {
                text: "Whole steps snap the loop to the step grid. Fractional steps turn off in-plugin quantization, so the loop can wrap mid-step and drift against the grid.";
                color: Theme.text-muted; font-size: 9px; wrap: word-wrap;
            }
            Text { text: "PATTERN LIMIT"; color: Theme.text-muted; font-size: 9px; }
            max-steps-box := NumBox { label: "Max steps"; value: root.max-steps; minimum: 64; maximum: 1024; step: 1; mod-target: 15; changed(v) => { root.set-opt(14, v); } }
            // Pattern arrays are allocated for 1024 steps up front, so ceiling changes need no restart.
            Text { text: "Max steps applies immediately; no restart is needed."; color: Theme.text-muted; font-size: 9px; }
            Text { text: "TECHNICAL SUPPORT"; color: Theme.text-muted; font-size: 9px; }
            Rectangle {
                height: 26px; border-radius: 4px;
                background: root.logging-on ? Theme.c1.with-alpha(0.8) : (logging-touch.has-hover ? Theme.control-hover : Theme.control);
                Text { x: 8px; width: parent.width - 16px; text: root.logging-on ? "LOGGING: ON (nrum-seq.log)" : "LOGGING: OFF"; color: root.logging-on ? Theme.on-accent : Theme.text; font-size: 9px; vertical-alignment: center; }
                logging-touch := TipTouch { hint: "Write parameter snapshots to nrum-seq.log"; clicked => { root.toggle-logging(); } }
            }
            Text { text: "Writes mode and parameter snapshots to nrum-seq.log in your home folder."; color: Theme.text-muted; font-size: 9px; wrap: word-wrap; }
            Text { text: "MIDI EXPORT"; color: Theme.text-muted; font-size: 9px; }
            Rectangle {
                height: 26px; border-radius: 4px;
                background: Theme.control; border-width: 1px; border-color: Theme.border;
                midi-input := TextInput {
                    x: 6px; width: parent.width - 12px; height: parent.height;
                    text: root.midi-folder; color: Theme.text; font-size: 9px;
                    vertical-alignment: center;
                    edited => { root.set-midi-folder(self.text); }
                    accepted => { root.set-midi-folder(self.text); }
                }
            }
            Text { text: root.export-status; color: Theme.text-muted; font-size: 9px; wrap: word-wrap; }
            // Push the contact block to the bottom of the panel; the controls stay top-aligned.
            Rectangle { vertical-stretch: 1; }
            // Credit rows are flush; this nested layout removes the inter-row spacing.
            VerticalLayout {
                spacing: 0px;
                Text { text: "CREDITS / CONTACT"; color: Theme.text-muted; font-size: 9px; }
                Text { text: "\{root.credit-author}  ·  nrum seq"; color: Theme.text; font-size: 10px; }
                TextInput { read-only: true; text: root.credit-github; color: Theme.text-muted; font-size: 9px; height: 20px; vertical-alignment: center; }
                TextInput { read-only: true; text: root.credit-support; color: Theme.text-muted; font-size: 9px; height: 20px; vertical-alignment: center; }
                TextInput { read-only: true; text: root.credit-email; color: Theme.text-muted; font-size: 9px; height: 20px; vertical-alignment: center; }
                Text { text: "v" + root.version; color: Theme.text-muted; font-size: 9px; horizontal-alignment: right; }
            }
        }
    }
    }
    // Outside-click catcher for the dropdowns; declared before them so it cannot cover popup rows.
    if root.clock-menu-open || root.wave-menu-open || root.scope-menu-open: Rectangle {
        x: 0px; y: 0px; width: root.base-width; height: root.base-height;
        background: #00000008;
        TouchArea { clicked => { root.clock-menu-open = false; root.wave-menu-open = false; root.scope-menu-open = false; } }
    }
    // Clock-rate dropdown overlay.
    if root.clock-menu-open: DropdownList {
        x: root.clock-menu-x; y: root.clock-menu-y;
        width: 96px; height: 260px;
        options: root.rate-names;
        current: root.rate;
        selected(i) => { root.set-rate(i); root.clock-menu-open = false; }
    }
    // Waveform picker overlay: shows the actual sampled shape, not just its name.
    if root.wave-menu-open: Rectangle {
        x: root.wave-menu-x; y: root.wave-menu-y;
        width: root.wave-menu-target == 0 ? 190px : 160px;
        height: root.wave-paths.length * 26px + 8px;
        border-radius: 4px; background: Theme.surface;
        border-width: 1px; border-color: Theme.border;
        drop-shadow-blur: 12px; drop-shadow-color: #00000055; drop-shadow-offset-y: 3px;
        VerticalLayout {
            padding: 4px; spacing: 2px;
            for i in root.wave-paths.length: Rectangle {
                height: 24px; border-radius: 3px;
                background: (root.wave-menu-target == 0 && i == root.osc-wave)
                    || (root.wave-menu-target == 1 && i == root.lfo1-wave)
                    || (root.wave-menu-target == 2 && i == root.lfo2-wave)
                    || (root.wave-menu-target == 3 && i == root.lfo3-wave)
                    || (root.wave-menu-target == 4 && i == root.lfo4-wave)
                    ? Theme.c1.with-alpha(0.18) : (row-touch.has-hover ? Theme.control-hover : Theme.control);
                Path {
                    x: 6px; y: 4px;
                    width: root.wave-menu-target == 0 ? 54px : parent.width - 12px;
                    height: parent.height - 8px;
                    viewbox-x: 0; viewbox-y: 0; viewbox-width: 100; viewbox-height: 40;
                    commands: root.wave-paths[i];
                    fill: transparent; stroke: Theme.c1; stroke-width: 1.2px;
                }
                Text { visible: root.wave-menu-target == 0; x: 68px; width: parent.width - 74px; height: parent.height; text: i < root.wave-names.length ? root.wave-names[i] : ""; color: Theme.text; font-size: 10px; vertical-alignment: center; overflow: elide; }
                row-touch := TouchArea {
                    clicked => {
                        if (root.wave-menu-target == 0) { root.set-osc-wave(i); }
                        if (root.wave-menu-target == 1) { root.set-lfo-wave(1, i); }
                        if (root.wave-menu-target == 2) { root.set-lfo-wave(2, i); }
                        if (root.wave-menu-target == 3) { root.set-lfo-wave(3, i); }
                        if (root.wave-menu-target == 4) { root.set-lfo-wave(4, i); }
                        root.wave-menu-open = false;
                    }
                }
            }
        }
    }
    // Randomize-scope popup.
    if root.scope-menu-open: Rectangle {
        x: root.scope-menu-x; y: root.scope-menu-y;
        width: 160px; height: 112px;
        border-radius: 4px; background: Theme.surface;
        border-width: 1px; border-color: Theme.border;
        drop-shadow-blur: 12px; drop-shadow-color: #00000055; drop-shadow-offset-y: 3px;
        VerticalLayout {
            padding: 4px; spacing: 3px;
            HorizontalLayout { spacing: 3px;
                ScopeChip { width: 74px; label: "MODE"; active: root.scope-mode; toggled => { root.toggle-scope(0); } }
                ScopeChip { width: 74px; label: "LENGTH"; active: root.scope-length; toggled => { root.toggle-scope(1); } }
            }
            HorizontalLayout { spacing: 3px;
                ScopeChip { width: 74px; label: "RHYTHM"; active: root.scope-rhythm; toggled => { root.toggle-scope(2); } }
                ScopeChip { width: 74px; label: "TONE"; active: root.scope-tone; toggled => { root.toggle-scope(3); } }
            }
            HorizontalLayout { spacing: 3px;
                ScopeChip { width: 74px; label: "CLOCK"; active: root.scope-clock; toggled => { root.toggle-scope(4); } }
                ScopeChip { width: 74px; label: "PHASE"; active: root.scope-phase; toggled => { root.toggle-scope(5); } }
            }
            HorizontalLayout { spacing: 3px;
                ScopeChip { width: 74px; label: "ACID"; active: root.scope-acid; toggled => { root.toggle-scope(6); } }
                ScopeChip { width: 74px; label: "FEEL"; active: root.scope-feel; toggled => { root.toggle-scope(7); } }
            }
        }
    }

    // Read-only modulation matrix, sliding up from below.
    if root.matrix-y < root.base-height: Rectangle {
        x: 0px; y: 0px; width: root.base-width; height: root.base-height;
        background: #00000055;
        TouchArea { clicked => { root.matrix-open = false; } }
    }
    Rectangle {
        x: 0px; y: root.matrix-y; width: root.base-width; height: 300px;
        background: Theme.surface; border-width: 1px; border-color: Theme.border;
        drop-shadow-blur: 16px; drop-shadow-color: #00000055; drop-shadow-offset-y: -4px;
        animate y { duration: 150ms; easing: ease-in-out; }
        VerticalLayout {
            padding: 10px; spacing: 6px;
            HorizontalLayout {
                height: 24px;
                Text { text: "MODULATION MATRIX"; color: Theme.c1; font-size: 14px; font-weight: 700; vertical-alignment: center; }
                Text { horizontal-stretch: 1; text: "drag an LFO point onto a parameter to link · × removes a link"; color: Theme.text-muted; font-size: 11px; horizontal-alignment: right; vertical-alignment: center; }
                Rectangle {
                    width: 62px; height: 22px; border-radius: 4px;
                    background: matrix-close.has-hover ? Theme.hi : Theme.control;
                    Text { text: "CLOSE"; color: matrix-close.has-hover ? Theme.on-accent : Theme.text; font-size: 11px; horizontal-alignment: center; vertical-alignment: center; }
                    matrix-close := TipTouch { hint: "Close the modulation matrix"; clicked => { root.matrix-open = false; } }
                }
            }
            HorizontalLayout {
                height: 18px; spacing: 6px;
                Text { width: 38px; text: "LFO"; color: Theme.text-muted; font-size: 10px; }
                Text { width: 220px; text: "SOURCE"; color: Theme.text-muted; font-size: 10px; }
                Text { width: 150px; text: "TARGET"; color: Theme.text-muted; font-size: 10px; }
                Text { width: 70px; text: "BASE"; color: Theme.text-muted; font-size: 10px; horizontal-alignment: right; }
                Text { width: 70px; text: "VALUE"; color: Theme.text-muted; font-size: 10px; horizontal-alignment: right; }
                Text { width: 70px; text: "DELTA"; color: Theme.text-muted; font-size: 10px; horizontal-alignment: right; }
                Text { width: 24px; text: ""; }
            }
            if root.mod-rows.length == 0: Text {
                text: "No links yet. Drag a colored LFO point onto any numeric parameter.";
                color: Theme.text-muted; font-size: 13px; wrap: word-wrap;
            }
            ScrollView {
                vertical-stretch: 1;
                vertical-scrollbar-policy: as-needed;
                VerticalLayout {
                    spacing: 2px;
                    for row in root.mod-rows: Rectangle {
                        height: 28px; border-radius: 3px;
                        background: row.lfo == 1 ? Theme.c1.with-alpha(0.08) : (row.lfo == 2 ? Theme.c2.with-alpha(0.08) : (row.lfo == 3 ? Theme.c3.with-alpha(0.08) : Theme.hi.with-alpha(0.05)));
                        HorizontalLayout {
                            padding-left: 6px; padding-right: 6px; spacing: 6px;
                            Text { width: 38px; text: "\{row.lfo}"; color: row.lfo == 1 ? Theme.c1 : (row.lfo == 2 ? Theme.c2 : (row.lfo == 3 ? Theme.c3 : Theme.hi)); font-size: 11px; font-weight: 700; vertical-alignment: center; }
                            Text { width: 220px; text: row.source; color: Theme.text-muted; font-size: 11px; vertical-alignment: center; overflow: elide; }
                            Text { width: 150px; text: row.target; color: Theme.text; font-size: 11px; vertical-alignment: center; overflow: elide; }
                            Text { width: 70px; text: row.base; color: Theme.text-muted; font-size: 11px; horizontal-alignment: right; vertical-alignment: center; }
                            Text { width: 70px; text: row.value; color: Theme.c2; font-size: 11px; horizontal-alignment: right; vertical-alignment: center; }
                            Text { width: 70px; text: row.delta; color: Theme.text-muted; font-size: 11px; horizontal-alignment: right; vertical-alignment: center; }
                            Rectangle {
                                width: 24px; height: 28px; border-radius: 3px;
                                background: delete-touch.has-hover ? Theme.c3.with-alpha(0.65) : transparent;
                                Text { width: parent.width; height: parent.height; text: "×"; color: delete-touch.has-hover ? Theme.on-accent : Theme.text-muted; font-size: 14px; horizontal-alignment: center; vertical-alignment: center; }
                                delete-touch := TipTouch { hint: "Remove this LFO-to-parameter link"; clicked => { root.delete-mod(row.lfo, row.target-id); } }
                            }
                        }
                    }
                }
            }
        }
    }

    if ModHover.target >= 0 && ModView.view(ModHover.target).linked && !root.matrix-open && ModDrag.lfo == 0: Rectangle {
        x: Math.max(6px, Math.min(ModHover.x, root.base-width - 326px));
        y: Math.min(ModHover.y + 2px, root.base-height - 26px);
        width: 320px; height: 22px;
        border-radius: 4px; background: Theme.surface;
        border-width: 1px; border-color: Theme.c3;
        drop-shadow-blur: 10px; drop-shadow-color: #00000055; drop-shadow-offset-y: 3px;
        Text {
            x: 8px; width: parent.width - 16px; height: parent.height;
            text: ModView.view(ModHover.target).lfo-text;
            color: Theme.text; font-size: 10px;
            vertical-alignment: center; overflow: elide;
        }
    }
}
