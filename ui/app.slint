import { ScrollView } from "std-widgets.slint";
import { FocusRing, HoverTip, ModDrag, ModHover, ModRegistry, ModView, ModTargetView, ModRow, ModeRow, Opt, TipTouch } from "shared.slint";
export { FocusRing, HoverTip, ModDrag, ModHover, ModRegistry, ModView, ModTargetView, ModRow, ModeRow, Opt } from "shared.slint";
// nrum seq: algorithm-first MIDI drum sequencer. Rust pushes deterministic pattern and view data.
export global Theme {
    in-out property <color> c1: #fde047;
    in-out property <color> c2: #f97316;
    in-out property <color> c3: #dc2626;
    in-out property <color> hi: #38bdf8;
    in-out property <color> bg1: #1b1010;
    in-out property <color> bg2: #201113;
    in-out property <color> bg3: #180e13;
    in-out property <color> surface: #221416;
    in-out property <color> control: #332024;
    in-out property <color> control-hover: #4a2c2f;
    in-out property <color> text: #f3e8e0;
    in-out property <color> text-muted: #b09a94;
    in-out property <color> border: #4a3134;
    in-out property <color> cell-off: #2a1a1c;
    in-out property <color> on-accent: #1a0d0d;
    // Eight distinguishable lane colours used by the phyllotaxis rosettes.
    in-out property <[color]> lanes: [#fde047, #f97316, #dc2626, #38bdf8, #f472b6, #f3e8e0, #ffa87a, #e0a020];
}

// Typographic roles. Sizes name a job, not a number, so the same role stays identical on every
// panel and state. At this density the lower steps sit 1px apart, so weight, case and tone
// carry the rest of the distinction; the crowded chrome cannot spend more room on type.
// No family is named: the plugin ships no font, and a platform face (Consolas) exists only on
// Windows and silently falls back to the UI sans everywhere else.
export global Type {
    // Wordmark only.
    out property <length> display: 24px;
    // Panel headings and the active generator name.
    out property <length> title: 14px;
    // Runs of prose: generator description, empty states, settings explanations.
    out property <length> body: 12px;
    // Values, option labels, matrix rows, compact support copy and the primary actions.
    out property <length> value: 11px;
    // Controls, chips, status text and column headers.
    out property <length> caption: 10px;
    // Metadata that has to fit a tighter box than a caption: axis labels, four-digit badges.
    out property <length> dense: 9px;
    // Glyph sizes are optical, not text roles: a symbol needs its own cap height beside words.
    out property <length> glyph-small: 12px;
    out property <length> glyph: 13px;
    out property <length> glyph-large: 14px;
}

export struct ViewNode { x: length, y: length, r: length, on: bool, cur: bool, label: string, lane: int, link-lane: int, link-step: int, link-len: int }
export struct ModeEntry { group: string, index: int, header: bool }
export struct StepCell { track: int, step: int, hit: bool, playing: bool, velocity: float, probability: float, hit-override: int, edited: bool, ratchet: int, offset: int, length: float }
export struct TrackRow { index: int, name: string, enabled: bool, note: int, cells: [StepCell] }
component Selector inherits Rectangle {
    in property <[string]> options;
    in property <int> current;
    in property <length> text-size: Type.caption;
    callback selected(int);
    height: 28px;
    HorizontalLayout {
        spacing: 4px;
        for i in root.options.length: Rectangle {
            border-radius: 1px;
            background: ta.has-hover ? Theme.control-hover : Theme.control;
            if i == root.current: Rectangle {
                border-radius: 4px;
                background: @linear-gradient(90deg, Theme.c1 0%, Theme.c2 52%, Theme.c3 100%);
            }
            Text {
                width: parent.width; height: parent.height;
                text: root.options[i];
                color: i == root.current ? Theme.on-accent : Theme.text;
                font-size: root.text-size;
                horizontal-alignment: center; vertical-alignment: center;
                overflow: elide;
            }
            ta := TipTouch {
                hint: "Choose " + root.options[i];
                clicked => { root.selected(i); }
                // Enum parameters (rate, waveform, theme) can be stepped with the wheel too.
                scroll-event(e) => {
                    if (e.delta-y != 0px) {
                        root.selected((root.current + (e.delta-y > 0px ? 1 : -1)) < 0 ? 0 : ((root.current + (e.delta-y > 0px ? 1 : -1)) >= root.options.length ? root.options.length - 1 : root.current + (e.delta-y > 0px ? 1 : -1)));
                        accept
                    } else {
                        reject
                    }
                }
            }
        }
    }
}

// One RANDOMIZE scope group. The five chips edit the bits of a single host parameter.
component ScopeChip inherits Rectangle {
    in property <string> label;
    in property <bool> active;
    callback toggled();
    height: 24px; border-radius: 4px;
    background: root.active ? Theme.c1 : (ta.has-hover ? Theme.control-hover : Theme.control);
    Text { text: root.label; color: root.active ? Theme.on-accent : Theme.text; font-size: Type.caption; horizontal-alignment: center; vertical-alignment: center; overflow: elide; }
    ta := TipTouch { hint: "Toggle this RANDOMIZE group"; clicked => { root.toggled(); } }
}

component OptSlider inherits Rectangle {
    in property <Opt> opt;
    in property <int> mod-target: -1;
    in property <string> hint: "Drag or scroll to adjust";
    callback changed(float);
    height: 25px;
    border-radius: 4px; background: Theme.control; clip: true;
    property <bool> edit-open: false;
    property <string> draft: "";
    out property <bool> editing: root.edit-open;
    property <bool> mod-registered: false;
    property <ModTargetView> modview: ModView.view(root.mod-target);
    property <bool> mod-hover: root.mod-target >= 0 && ModDrag.lfo > 0
        && ModDrag.x >= root.absolute-position.x && ModDrag.x <= root.absolute-position.x + root.width
        && ModDrag.y >= root.absolute-position.y && ModDrag.y <= root.absolute-position.y + root.height;
    property <bool> hovered: ta.has-hover;
    property <float> mod-base01: Math.clamp((root.modview.base - root.opt.min) / Math.max(root.opt.max - root.opt.min, 0.0001), 0, 1);
    property <float> mod-value01: Math.clamp((root.modview.value - root.opt.min) / Math.max(root.opt.max - root.opt.min, 0.0001), 0, 1);
    property <float> mod-up01: Math.min(1, root.modview.depth-up * (root.modview.max - root.modview.min) / Math.max(root.opt.max - root.opt.min, 0.0001));
    property <float> mod-down01: Math.min(1, root.modview.depth-down * (root.modview.max - root.modview.min) / Math.max(root.opt.max - root.opt.min, 0.0001));
    property <float> mod-band-low: Math.max(0, root.mod-base01 - root.mod-down01);
    property <float> mod-band-high: Math.min(1, root.mod-base01 + root.mod-up01);
    function report-mod() {
        if (root.mod-target >= 0) {
            ModRegistry.register(root.mod-target, root.visible, root.absolute-position.x, root.absolute-position.y, root.width, root.height);
        }
    }
    Rectangle {
        x: 0px; y: 0px; height: parent.height;
        width: parent.width * Math.clamp((root.opt.value - root.opt.min) / (root.opt.max - root.opt.min), 0, 1);
        background: @linear-gradient(90deg, Theme.c1 0%, Theme.c2 52%, Theme.c3 100%);
        opacity: 0.3;
    }
    if root.modview.linked: Rectangle {
        x: parent.width * root.mod-band-low;
        y: parent.height - 5px;
        width: parent.width * Math.max(0, root.mod-band-high - root.mod-band-low);
        height: 4px;
        background: Theme.c3;
        opacity: 0.20;
    }
    if root.modview.linked: Rectangle {
        x: parent.width * Math.min(root.mod-base01, root.mod-value01);
        y: parent.height - 4px;
        width: parent.width * Math.abs(root.mod-value01 - root.mod-base01);
        height: 3px;
        background: Theme.c3;
        opacity: 0.95;
    }
    if root.modview.linked: Rectangle {
        x: Math.max(0px, Math.min(parent.width - 2px, parent.width * root.mod-value01 - 1px));
        y: parent.height - 5px; width: 2px; height: 5px;
        background: Theme.hi;
    }
    Text { x: 8px; width: parent.width - 16px; height: parent.height; text: root.opt.label; color: Theme.text; font-size: Type.value; vertical-alignment: center; }
    Text { x: 8px; width: parent.width - 16px; height: parent.height; text: root.opt.text; color: Theme.text; font-size: Type.value; horizontal-alignment: right; vertical-alignment: center; }
    ta := TouchArea {
        pointer-event(e) => {
            if (root.hint != "") {
                HoverTip.text = root.hint;
                HoverTip.x = root.absolute-position.x + ta.mouse-x;
                HoverTip.y = root.absolute-position.y + ta.mouse-y;
                HoverTip.owner-x = root.absolute-position.x;
                HoverTip.owner-y = root.absolute-position.y;
            }
            if (e.button == PointerEventButton.left && e.kind == PointerEventKind.down) {
                root.changed(root.opt.min + Math.clamp(ta.mouse-x / ta.width, 0, 1) * (root.opt.max - root.opt.min));
            }
        }
        double-clicked => {
            if (!root.edit-open) {
                root.draft = root.opt.number;
                root.edit-open = true;
            }
        }
        moved => { if (ta.pressed) { root.changed(root.opt.min + Math.clamp(ta.mouse-x / ta.width, 0, 1) * (root.opt.max - root.opt.min)); } }
        // Snap to the parameter's step grid, then move one step per wheel notch.
        scroll-event(e) => {
            if (e.delta-y != 0px) {
                root.changed(Math.clamp(root.opt.min + Math.round((root.opt.value - root.opt.min) / root.opt.step + (e.delta-y > 0px ? 1 : -1)) * root.opt.step, root.opt.min, root.opt.max));
                accept
            } else {
                reject
            }
        }
    }
    property <bool> tip-hover: ta.has-hover;
    changed tip-hover => {
        if (tip-hover) {
            HoverTip.text = root.hint;
            HoverTip.x = root.absolute-position.x + ta.mouse-x;
            HoverTip.y = root.absolute-position.y + ta.mouse-y;
            HoverTip.owner-x = root.absolute-position.x;
            HoverTip.owner-y = root.absolute-position.y;
        } else if (HoverTip.owner-x == root.absolute-position.x && HoverTip.owner-y == root.absolute-position.y) {
            HoverTip.text = "";
        }
    }
    if root.edit-open: Rectangle {
        x: 1px; y: 1px; width: parent.width - 2px; height: parent.height - 2px;
        border-radius: 3px; background: Theme.surface; border-width: 1px; border-color: Theme.c2;
        entry := TextInput {
            x: 4px; width: parent.width - 8px; height: parent.height;
            text: root.draft; color: Theme.text; font-size: Type.value;
            horizontal-alignment: right; vertical-alignment: center;
            edited => { root.draft = self.text; }
            accepted => {
                if (root.draft.is-float()) {
                    root.changed(Math.clamp(root.draft.to-float() * root.opt.scale, root.opt.min, root.opt.max));
                }
                root.edit-open = false;
            }
            key-pressed(event) => {
                if (event.text == Key.Escape) { root.edit-open = false; return accept; }
                return reject;
            }
        }
    }
    if root.mod-hover: Rectangle {
        x: 0px; y: 0px; width: parent.width; height: parent.height;
        border-radius: 4px; border-width: 2px; border-color: Theme.c2;
        background: transparent;
    }
    Timer {
        interval: 30ms;
        running: root.mod-target >= 0 && !root.mod-registered;
        triggered => { root.mod-registered = true; root.report-mod(); }
    }
    Timer {
        interval: 250ms;
        running: root.mod-target >= 0;
        triggered => { root.report-mod(); }
    }
    Timer {
        interval: 40ms;
        running: root.hovered && root.mod-target >= 0 && !root.edit-open;
        triggered => {
            ModHover.target = root.mod-target;
            ModHover.x = root.absolute-position.x;
            ModHover.y = root.absolute-position.y + root.height;
        }
    }
    Timer {
        interval: 40ms;
        running: !root.hovered && ModHover.target == root.mod-target;
        triggered => { ModHover.target = -1; }
    }
    // Keyboard entry for the slider: Tab lands here, arrows step the value, Enter types one.
    // It handles no pointer events, so `ta` still owns dragging.
    key-scope := FocusScope {
        x: 0px; y: 0px; width: parent.width; height: parent.height;
        accessible-role: slider;
        accessible-label: root.opt.label;
        accessible-value: root.opt.text;
        accessible-value-minimum: root.opt.min;
        accessible-value-maximum: root.opt.max;
        accessible-value-step: root.opt.step;
        accessible-action-increment => { root.changed(Math.clamp(root.opt.value + root.opt.step, root.opt.min, root.opt.max)); }
        accessible-action-decrement => { root.changed(Math.clamp(root.opt.value - root.opt.step, root.opt.min, root.opt.max)); }
        key-pressed(event) => {
            if (event.text == Key.LeftArrow || event.text == Key.DownArrow) {
                root.changed(Math.clamp(root.opt.value - root.opt.step, root.opt.min, root.opt.max));
                return accept;
            }
            if (event.text == Key.RightArrow || event.text == Key.UpArrow) {
                root.changed(Math.clamp(root.opt.value + root.opt.step, root.opt.min, root.opt.max));
                return accept;
            }
            if (event.text == Key.Return || event.text == Key.Space) {
                if (!root.edit-open) { root.draft = root.opt.number; root.edit-open = true; }
                return accept;
            }
            reject
        }
        Rectangle {
            visible: key-scope.has-focus;
            width: parent.width; height: parent.height;
            border-width: 1px; border-color: Theme.hi; border-radius: 3px;
            background: transparent;
        }
        changed has-focus => {
            if (key-scope.has-focus && root.hint != "") {
                HoverTip.text = root.hint;
                HoverTip.owner-x = root.absolute-position.x;
                HoverTip.owner-y = root.absolute-position.y;
            } else if (HoverTip.owner-x == root.absolute-position.x && HoverTip.owner-y == root.absolute-position.y) {
                HoverTip.text = "";
            }
        }
    }
}
// Slint's SpinBox is <int>-only, so this carries fractional values such as 16.5 steps. Numbers are
// edited through a draft: Enter, blur or the +/- buttons commit, so typing "512" is not clamped
// after the first digit.
component NumBox inherits Rectangle {
    in property <string> label;
    in property <string> hint: "";
    in property <float> value: 0;
    in property <float> minimum: 0;
    in property <float> maximum: 100;
    in property <float> step: 1;
    in property <int> decimals: 0;
    in property <int> mod-target: -1;
    callback changed(float);
    property <bool> mod-registered: false;
    property <ModTargetView> modview: ModView.view(root.mod-target);
    property <bool> mod-hover: root.mod-target >= 0 && ModDrag.lfo > 0
        && ModDrag.x >= root.absolute-position.x && ModDrag.x <= root.absolute-position.x + root.width
        && ModDrag.y >= root.absolute-position.y && ModDrag.y <= root.absolute-position.y + root.height;
    property <bool> hovered: tap.has-hover;
    property <float> mod-base01: Math.clamp((root.modview.base - root.minimum) / Math.max(root.maximum - root.minimum, 0.0001), 0, 1);
    property <float> mod-value01: Math.clamp((root.modview.value - root.minimum) / Math.max(root.maximum - root.minimum, 0.0001), 0, 1);
    property <float> mod-up01: Math.min(1, root.modview.depth-up * (root.modview.max - root.modview.min) / Math.max(root.maximum - root.minimum, 0.0001));
    property <float> mod-down01: Math.min(1, root.modview.depth-down * (root.modview.max - root.modview.min) / Math.max(root.maximum - root.minimum, 0.0001));
    property <float> mod-band-low: Math.max(0, root.mod-base01 - root.mod-down01);
    property <float> mod-band-high: Math.min(1, root.mod-base01 + root.mod-up01);
    function report-mod() {
        if (root.mod-target >= 0) {
            ModRegistry.register(root.mod-target, root.visible, root.absolute-position.x, root.absolute-position.y, root.width, root.height);
        }
    }

    height: 26px;
    border-radius: 4px;
    background: Theme.control; border-width: 1px; border-color: Theme.border;
    horizontal-stretch: 1;
    // True while the numeric editor is open, so Rust can keep host shortcuts out of typing.
    out property <bool> editing: root.edit-open;
    property <bool> edit-open: false;
    property <bool> focus-pending: false;
    in-out property <string> draft: "";

    function clamp-value(v: float) -> float {
        return Math.clamp(v, root.minimum, root.maximum);
    }
    function nudge(dir: float) {
        // Use the typed draft as the nudge base while the editor is open.
        let base = root.draft.is-float() ? root.draft.to-float() : root.value;
        root.edit-open = false;
        root.changed(root.clamp-value(base + dir * root.step));
    }
    function format-value(v: float) -> string {
        if (root.decimals <= 0) { return Math.round(v); }
        return Math.round(v * 100) / 100;
    }
    function begin-edit() {
        root.draft = root.format-value(root.value);
        root.edit-open = true;
        root.focus-pending = true;
    }
    function commit-edit() {
        if (root.edit-open) {
            if (root.draft.is-float()) { root.changed(root.clamp-value(root.draft.to-float())); }
            root.edit-open = false;
        }
    }
    changed value => {
        if (!root.edit-open) { root.draft = root.format-value(root.value); }
    }

    Text {
        x: 6px; width: parent.width - 12px;
        text: root.label;
        color: Theme.text-muted; font-size: Type.caption; vertical-alignment: center; overflow: elide;
    }
    Text {
        visible: !root.edit-open;
        x: 6px; width: parent.width - 54px; height: parent.height;
        text: root.format-value(root.value);
        color: Theme.text; font-size: Type.value;
        horizontal-alignment: right; vertical-alignment: center;
    }
    if root.modview.linked: Rectangle {
        x: 1px + (parent.width - 35px) * root.mod-band-low;
        y: parent.height - 4px;
        width: (parent.width - 35px) * Math.max(0, root.mod-band-high - root.mod-band-low);
        height: 3px;
        background: Theme.c3;
        opacity: 0.20;
    }
    if root.modview.linked: Rectangle {
        x: 1px + (parent.width - 35px) * Math.min(root.mod-base01, root.mod-value01);
        y: parent.height - 3px;
        width: (parent.width - 35px) * Math.abs(root.mod-value01 - root.mod-base01);
        height: 2px;
        background: Theme.c3;
    }
    down := Rectangle {
        x: parent.width - 48px; y: 1px; width: 24px; height: parent.height - 2px;
        border-radius: 3px; background: down-touch.has-hover ? Theme.control-hover : Theme.control;
        Text { text: "-"; color: Theme.text; font-size: Type.glyph-small; horizontal-alignment: center; vertical-alignment: center; }
        down-touch := TipTouch { hint: "Decrease this value"; clicked => { root.nudge(-1); } }
    }
    up := Rectangle {
        x: parent.width - 24px; y: 1px; width: 24px; height: parent.height - 2px;
        border-radius: 3px; background: up-touch.has-hover ? Theme.control-hover : Theme.control;
        Text { text: "+"; color: Theme.text; font-size: Type.glyph-small; horizontal-alignment: center; vertical-alignment: center; }
        up-touch := TipTouch { hint: "Increase this value"; clicked => { root.nudge(1); } }
    }
    // Click the value to type; wheel outside the buttons to nudge. +/- stay clickable.
    tap := TouchArea {
        x: 0px; y: 0px; width: parent.width - 48px; height: parent.height;
        clicked => { if (!root.edit-open) { root.begin-edit(); } }
        moved => {
            if (root.hint != "") {
                HoverTip.text = root.hint;
                HoverTip.x = root.absolute-position.x + tap.mouse-x;
                HoverTip.y = root.absolute-position.y + tap.mouse-y;
                HoverTip.owner-x = root.absolute-position.x;
                HoverTip.owner-y = root.absolute-position.y;
            }
        }
        changed has-hover => {
            if (tap.has-hover) {
                HoverTip.text = root.hint;
                HoverTip.x = root.absolute-position.x + tap.mouse-x;
                HoverTip.y = root.absolute-position.y + tap.mouse-y;
                HoverTip.owner-x = root.absolute-position.x;
                HoverTip.owner-y = root.absolute-position.y;
            } else if (HoverTip.owner-x == root.absolute-position.x && HoverTip.owner-y == root.absolute-position.y) {
                HoverTip.text = "";
            }
        }
        scroll-event(e) => {
            if (!root.edit-open && e.delta-y != 0px) {
                root.nudge(e.delta-y > 0px ? 1 : -1);
                return accept;
            }
            return reject;
        }
    }
    editor := Rectangle {
        visible: root.edit-open;
        x: 1px; y: 1px; width: parent.width - 49px; height: parent.height - 2px;
        border-radius: 3px; background: Theme.surface; border-width: 1px; border-color: Theme.c2;
        entry := TextInput {
            x: 5px; y: 0px; width: parent.width - 10px; height: parent.height;
            text: root.draft;
            color: Theme.text; font-size: Type.value;
            horizontal-alignment: right; vertical-alignment: center;
            edited => { root.draft = self.text; }
            accepted => { root.commit-edit(); }
            changed has-focus => {
                if (!self.has-focus && root.edit-open) { root.commit-edit(); }
            }
            key-pressed(event) => {
                if (event.text == Key.UpArrow) {
                    if (root.draft.is-float()) { root.draft = root.format-value(root.clamp-value(root.draft.to-float() + root.step)); }
                    return accept;
                }
                if (event.text == Key.DownArrow) {
                    if (root.draft.is-float()) { root.draft = root.format-value(root.clamp-value(root.draft.to-float() - root.step)); }
                    return accept;
                }
                if (event.text == Key.Escape) { root.edit-open = false; return accept; }
                return reject;
            }
        }
    }
    Timer {
        interval: 1ms;
        running: root.focus-pending && root.edit-open;
        triggered => {
            root.focus-pending = false;
            entry.focus();
            entry.select-all();
        }
    }
    if root.mod-hover: Rectangle {
        x: 0px; y: 0px; width: parent.width; height: parent.height;
        border-radius: 4px; border-width: 2px; border-color: Theme.c2;
        background: transparent;
    }
    // Timer-driven registration avoids a Slint 1.16 property-recursion panic.
    Timer {
        interval: 30ms;
        running: root.mod-target >= 0 && !root.mod-registered;
        triggered => { root.mod-registered = true; root.report-mod(); }
    }
    Timer {
        interval: 250ms;
        running: root.mod-target >= 0;
        triggered => { root.report-mod(); }
    }
    Timer {
        interval: 40ms;
        running: root.hovered && root.mod-target >= 0 && !root.edit-open;
        triggered => {
            ModHover.target = root.mod-target;
            ModHover.x = root.absolute-position.x;
            ModHover.y = root.absolute-position.y + root.height;
        }
    }
    Timer {
        interval: 40ms;
        running: !root.hovered && ModHover.target == root.mod-target;
        triggered => { ModHover.target = -1; }
    }
    // Keyboard entry: Tab lands on the value, Enter opens the draft editor, arrows step it.
    num-scope := FocusScope {
        x: 0px; y: 0px; width: parent.width - 48px; height: parent.height;
        accessible-role: spinbox;
        accessible-label: root.label;
        accessible-value: root.format-value(root.value);
        accessible-value-minimum: root.minimum;
        accessible-value-maximum: root.maximum;
        accessible-value-step: root.step;
        accessible-action-increment => { root.nudge(1); }
        accessible-action-decrement => { root.nudge(-1); }
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == Key.Space) {
                if (!root.edit-open) { root.begin-edit(); }
                return accept;
            }
            if (event.text == Key.UpArrow || event.text == Key.RightArrow) { root.nudge(1); return accept; }
            if (event.text == Key.DownArrow || event.text == Key.LeftArrow) { root.nudge(-1); return accept; }
            reject
        }
        Rectangle {
            visible: num-scope.has-focus;
            width: parent.width; height: parent.height;
            border-width: 1px; border-color: Theme.hi; border-radius: 3px;
            background: transparent;
        }
        changed has-focus => {
            if (num-scope.has-focus && root.hint != "") {
                HoverTip.text = root.hint;
                HoverTip.owner-x = root.absolute-position.x;
                HoverTip.owner-y = root.absolute-position.y;
            } else if (HoverTip.owner-x == root.absolute-position.x && HoverTip.owner-y == root.absolute-position.y) {
                HoverTip.text = "";
            }
        }
    }
}

// Collapsed waveform picker with a live LFO phase dot.
component WavePicker inherits Rectangle {
    in property <[string]> paths;
    in property <[string]> names;
    in property <int> current;
    in property <float> anim-phase: 0;
    in property <float> dot-y: 20;
    in property <bool> show-dot: false;
    in property <bool> running: false;
    callback selected(int);
    callback opened(length, length);
    height: 28px; border-radius: 4px;
    background: ta.has-hover ? Theme.control-hover : Theme.control;
    border-width: 1px; border-color: Theme.border;
    Text { x: 8px; width: Math.max(parent.width - 96px, 0px); height: parent.height; text: root.current < root.names.length ? root.names[root.current] : ""; color: Theme.text; font-size: Type.caption; vertical-alignment: center; overflow: elide; }
    Path {
        x: Math.max(parent.width - 76px, 6px); y: 4px;
        width: Math.min(50px, parent.width - 28px); height: parent.height - 8px;
        viewbox-x: 0; viewbox-y: 0; viewbox-width: 100; viewbox-height: 40;
        commands: root.current < root.paths.length ? root.paths[root.current] : "";
        fill: transparent; stroke: Theme.c1; stroke-width: 1.2px;
    }
    if root.show-dot: Rectangle {
        x: Math.max(parent.width - 76px, 6px) + (2.0 + root.anim-phase * 96.0) / 100.0 * Math.min(50px, parent.width - 28px) - 2px;
        y: 4px + (root.dot-y / 40.0) * (parent.height - 8px) - 2px;
        width: 4px; height: 4px; border-radius: 2px;
        background: Theme.hi;
        opacity: root.running ? 0.9 : 0.25;
    }
    Text { x: parent.width - 22px; width: 16px; height: parent.height; text: "▾"; color: Theme.text-muted; font-size: Type.caption; horizontal-alignment: center; vertical-alignment: center; }
    ta := TouchArea {
        clicked => { root.opened(root.absolute-position.x, root.absolute-position.y + root.height); }
        scroll-event(e) => {
            if (e.delta-y != 0px) {
                root.selected(Math.max(0, Math.min(root.current + (e.delta-y > 0px ? 1 : -1), root.paths.length - 1)));
                accept
            } else {
                reject
            }
        }
    }
}

component ModePanel inherits Rectangle {
    // Suppress the position tweens when the user asks for reduced motion.
    in property <bool> reduce-motion: false;
    in property <[ViewNode]> nodes;
    in property <string> edges: "M0 0";
    in property <string> lines: "M0 0";
    in property <string> hand: "M0 0";
    // Matrix pointer position, for the signal x-ray: the marks that produced that step stay
    // legible while every other mark recedes. -1 means no link is being held.
    in property <int> xray-lane: -1;
    in property <int> xray-step: -1;
    in property <bool> xray-active: false;
    callback probe-at(length, length);
    // view.rs builds every panel in a 210-unit space; paths scale through the viewbox and node
    // rectangles are scaled by hand so dots and labels grow with the box.
    property <float> px-per-unit: 1.4285714;   // 300px square drawing / 210-unit geometry
    property <length> draw-offset-x: 30px;      // letterbox the square drawing in the wider card
    width: 360px; height: 300px;
    background: transparent; border-radius: 6px; clip: true;
    Path { x: root.draw-offset-x; y: 0px; width: 300px; height: 300px; viewbox-x: 0; viewbox-y: 0; viewbox-width: 210; viewbox-height: 210; commands: root.edges; fill: transparent; stroke: Theme.border; stroke-width: 1px; }
    Path { x: root.draw-offset-x; y: 0px; width: 300px; height: 300px; viewbox-x: 0; viewbox-y: 0; viewbox-width: 210; viewbox-height: 210; commands: root.lines; fill: transparent; stroke: Theme.c3; stroke-width: 1.4px; }
    Path { x: root.draw-offset-x; y: 0px; width: 300px; height: 300px; viewbox-x: 0; viewbox-y: 0; viewbox-width: 210; viewbox-height: 210; commands: root.hand; fill: transparent; stroke: Theme.hi; stroke-width: 2px; }
    for n in root.nodes: Rectangle {
        // Pebble-box positions change every step; static panels never show the tween.
        animate x, y { duration: root.reduce-motion ? 0ms : 120ms; }
        x: root.draw-offset-x + (n.x - n.r) * root.px-per-unit; y: (n.y - n.r) * root.px-per-unit;
        width: n.r * 2 * root.px-per-unit; height: n.r * 2 * root.px-per-unit;
        border-radius: n.r * root.px-per-unit;
        property <bool> linked: root.xray-step >= 0 && n.link-step >= 0
            && root.xray-step >= n.link-step && root.xray-step < n.link-step + n.link-len
            && (n.link-lane < 0 || n.link-lane == root.xray-lane);
        // The x-ray is a held state, never an animation: the matched marks keep full ink and a
        // focus ring, the rest step back. It lands instantly, like every other state.
        opacity: !root.xray-active || root.xray-step < 0 || linked ? 1.0 : 0.28;
        background: n.cur ? Theme.hi : (n.lane >= 0 ? Theme.lanes[Math.mod(n.lane, 8)].with-alpha(n.on ? 0.95 : 0.35) : (n.on ? Theme.c1 : Theme.cell-off));
        border-width: linked ? 2px : 1px;
        border-color: linked ? Theme.hi : (n.lane >= 0 ? Theme.lanes[Math.mod(n.lane, 8)] : Theme.border);
        // Canvas labels scale with the drawing, so they follow the node radius, not a text role.
        Text { width: parent.width; height: parent.height; text: n.label; font-size: 7px * root.px-per-unit; color: (n.cur || n.on) ? Theme.on-accent : Theme.text; horizontal-alignment: center; vertical-alignment: center; }
    }
    // Read the drawing under the pointer. The host finds the nearest step-linked mark, so the
    // same link works in the other direction: the matrix lights the cell the mark came from.
    probe := TouchArea {
        x: root.draw-offset-x; y: 0px; width: 300px; height: 300px;
        moved => { root.probe-at(probe.mouse-x / root.px-per-unit, probe.mouse-y / root.px-per-unit); }
        changed has-hover => {
            if (!probe.has-hover) { root.probe-at(-9999px, -9999px); }
        }
    }
}

component ModeDropdown inherits Rectangle {
    in property <[ModeRow]> rows;
    in property <[string]> names;
    in property <int> current;
    callback selected(int);
    width: 460px; height: 432px;
    background: Theme.surface; border-width: 1px; border-color: Theme.border;
    drop-shadow-blur: 16px; drop-shadow-color: #00000055; drop-shadow-offset-y: 4px;
    clip: true;
    ScrollView {
        width: parent.width; height: parent.height;
        vertical-scrollbar-policy: as-needed;
        VerticalLayout {
            padding: 8px; spacing: 4px; alignment: start;
            for r in root.rows: Rectangle {
                height: r.header ? 18px : 24px;
                width: 444px;
                border-radius: 3px;
                background: transparent;
                if r.header: Text {
                    x: 6px; width: 432px; height: parent.height;
                    text: r.group; color: Theme.text-muted; font-size: Type.caption; font-weight: 700; vertical-alignment: center; overflow: elide;
                }
                if !r.header: HorizontalLayout {
                    spacing: 6px; padding-left: 0px; padding-right: 0px;
                    Rectangle {
                        horizontal-stretch: 1; height: parent.height; border-radius: 3px;
                        background: r.left == root.current ? @linear-gradient(90deg, Theme.c1 0%, Theme.c2 52%, Theme.c3 100%) : (left-touch.has-hover ? Theme.control-hover : Theme.control);
                        Text { x: 6px; width: parent.width - 12px; height: parent.height; text: root.names[r.left]; color: r.left == root.current ? Theme.on-accent : Theme.text; font-size: Type.value; vertical-alignment: center; overflow: elide; }
                        left-touch := TipTouch { hint: "Select this mode"; clicked => { root.selected(r.left); } }
                    }
                    if r.has-right: Rectangle {
                        horizontal-stretch: 1; height: parent.height; border-radius: 3px;
                        background: r.right == root.current ? @linear-gradient(90deg, Theme.c1 0%, Theme.c2 52%, Theme.c3 100%) : (right-touch.has-hover ? Theme.control-hover : Theme.control);
                        Text { x: 6px; width: parent.width - 12px; height: parent.height; text: root.names[r.right]; color: r.right == root.current ? Theme.on-accent : Theme.text; font-size: Type.value; vertical-alignment: center; overflow: elide; }
                        right-touch := TipTouch { hint: "Select this mode"; clicked => { root.selected(r.right); } }
                    }
                    if !r.has-right: Rectangle { horizontal-stretch: 1; }
                }
            }
        }
    }
}

export component AppWindow inherits Window {
    title: "nrum seq";
    // Fixed layout size: the window never resizes, so the host cannot fight over it.
    in property <length> base-width: 860px;
    in property <length> base-height: 768px;
    preferred-width: root.base-width; preferred-height: root.base-height;
    background: @linear-gradient(135deg, Theme.bg1 0%, Theme.bg2 50%, Theme.bg3 100%);
    in property <int> mode: 0;
    in property <string> version;
    in property <[string]> preset-names;
    in property <float> steps: 16;
    in property <float> max-steps: 256;
    in property <bool> round-steps: true;
    in property <bool> period-minimal: false;
    // Grid cells the generator will fill, mirroring `cell_count_for`: snap rounds, free length
    // takes the ceiling. Header and bounds read this so they cannot disagree with the matrix.
    property <int> cells: root.round-steps ? Math.round(root.steps) : Math.ceil(root.steps);
    // Zoom is a multiplier over the natural cell width, so large patterns still scroll. The
    // matrix draws the derived loop, not the generation window, when a mode creates polymeter.
    property <length> base-cell-width: root.display-cells < 64 ? Math.max(14px, 780px / root.display-cells) : 14px;
    in-out property <float> matrix-zoom: 1.0;
    property <length> matrix-cell-width: root.base-cell-width * root.matrix-zoom;
    // Keep every step visible when the pattern is zoomed out: below 3px a 1px gap would eat the
    // cell entirely, so the gap collapses and only the beat/bar separators remain.
    property <length> matrix-cell-gap: root.matrix-cell-width >= 3px ? 1px : 0px;
    property <length> matrix-cell-radius: root.matrix-cell-width >= 6px ? 2px : 0px;
    property <bool> show-beat-lines: root.matrix-cell-width * root.steps-per-beat >= 4px;
    in-out property <float> matrix-row-zoom: 1.0;
    property <length> matrix-row-height: 22px * root.matrix-row-zoom;
    in-out property <length> matrix-scroll-y: 0px;
    // Musical grid derived from the mode: the step unit comes from the selected generator and
    // the bar/loop from the generated pattern. No clock or meter setting exists.
    in property <float> steps-per-beat: 4.0;
    in property <float> steps-per-bar: 16.0;
    in property <string> timing-summary: "4/4 · step 1/16";
    // A mode-owned polymeter tiles its lane periods over this loop; `display-cells` is what the
    // matrix actually draws. Auto-enabled, read-only: timing is not a user setting.
    in property <bool> loop-view: false;
    in property <bool> loop-capped: false;
    in property <int> loop-steps: 0;
    in property <[int]> lane-steps: [0, 0, 0, 0, 0, 0, 0, 0];
    property <int> display-cells: root.loop-view && root.loop-steps > 0 ? root.loop-steps : root.cells;
    property <int> bar-count: root.steps-per-bar >= 1 ? Math.min(1024, Math.ceil(root.display-cells / root.steps-per-bar)) : 0;
    property <int> beat-count: root.steps-per-beat >= 1 ? Math.min(1024, Math.ceil(root.display-cells / root.steps-per-beat)) : 0;
    // Slint instantiates a repeater body even when it is invisible, so a zoomed-out pattern used
    // to create every bar label and beat rule for nothing. Counts drop to zero instead.
    property <int> beat-line-count: root.show-beat-lines ? root.beat-count : 0;
    property <int> ruler-label-count: root.matrix-cell-width * root.steps-per-bar >= 26px ? root.bar-count : 0;
    // Gate drags snap to a musical fraction of one step.
    in-out property <int> gate-snap-index: 1;
    in-out property <bool> gate-dragging: false;
    in-out property <int> current-step: 0;
    in-out property <bool> follow-step: true;
    in-out property <bool> regen-pulse: false;
    in-out property <length> matrix-x: 0px;
    // Keyboard cursor. Arrows move it while the window focus scope owns focus; Enter applies
    // the active EDIT mode (hit by default). The ring only shows while that scope has focus.
    in-out property <int> cursor-lane: 0;
    in-out property <int> cursor-step: 0;
    // Only draw the cursor once the keyboard has been used: the window scope keeps focus after
    // a mouse click, so `nav.has-focus` alone would leave a ring on screen forever.
    in-out property <bool> cursor-engaged: false;
    property <bool> cursor-visible: nav.has-focus && root.cursor-engaged;
    changed cursor-visible => {
        if (cursor-visible) { root.xray-hover(root.cursor-lane, root.cursor-step); }
    }
    // Signal x-ray. `hover-*` is the step under the matrix pointer, `probe-*` the mark under the
    // drawing pointer. They never feed each other, so the two surfaces stay independently held.
    in-out property <int> hover-lane: -1;
    in-out property <int> hover-step: -1;
    in-out property <int> probe-lane: -1;
    in-out property <int> probe-step: -1;
    // True when the held step actually has a drawing mark. The panel dims only for a real
    // link; an empty cell must not flash the whole drawing.
    in-out property <bool> xray-active: false;
    callback probe-at(length, length);
    callback xray-hover(int, int);
    // `viewport-x` is the content offset and is negative when scrolled right.
    pure function follow-x() -> length {
        let max-offset = Math.max(0px, root.display-cells * root.matrix-cell-width - matrix-scroll.width);
        let offset = Math.max(0px, Math.min(root.current-step * root.matrix-cell-width - matrix-scroll.width * 0.35, max-offset));
        return -offset;
    }
    changed current-step => {
        if (root.follow-step) { root.matrix-x = root.follow-x(); }
    }
    changed follow-step => {
        if (root.follow-step) { root.matrix-x = root.follow-x(); }
    }
    function zoom-matrix(factor: float) {
        let width = Math.max(matrix-scroll.width, 1px);
        let center = (-root.matrix-x + width * 0.5) / Math.max(root.matrix-cell-width, 0.01px);
        let zoom = Math.max(0.02, Math.min(3.0, root.matrix-zoom * factor));
        if (zoom == root.matrix-zoom) { return; }
        root.matrix-zoom = zoom;
        root.follow-step = false;
        let max-offset = Math.max(0px, root.display-cells * root.matrix-cell-width - width);
        let offset = Math.max(0px, Math.min(center * root.matrix-cell-width - width * 0.5, max-offset));
        root.matrix-x = -offset;
    }
    function move-cursor(dlane: int, dstep: int) {
        root.cursor-engaged = true;
        if (root.tracks.length <= 0) { return; }
        let lanes = root.tracks.length;
        let steps = root.tracks[0].cells.length;
        if (steps <= 0) { return; }
        root.cursor-lane = Math.max(0, Math.min(lanes - 1, root.cursor-lane + dlane));
        root.cursor-step = Math.max(0, Math.min(steps - 1, root.cursor-step + dstep));
        root.xray-hover(root.cursor-lane, root.cursor-step);
        root.reveal-cursor();
        HoverTip.text = root.cursor-text();
        // A sentinel owner keeps a nearby hover from clearing the readout.
        HoverTip.owner-x = -1px;
        HoverTip.owner-y = -1px;
    }
    function reveal-cursor() {
        let cell-w = root.matrix-cell-width;
        let view-w = Math.max(matrix-scroll.width, 1px);
        let left = root.cursor-step * cell-w + root.matrix-x;
        if (left < 0px) {
            root.matrix-x = -root.cursor-step * cell-w;
        } else if (left + cell-w > view-w) {
            root.matrix-x = view-w - (root.cursor-step + 1) * cell-w;
        }
        // Never scroll past either end, and stop follow mode from fighting the cursor.
        root.matrix-x = Math.max(Math.min(0px, view-w - root.display-cells * cell-w), Math.min(0px, root.matrix-x));
        root.follow-step = false;
    }
    function cursor-text() -> string {
        if (root.cursor-lane < 0 || root.cursor-lane >= root.tracks.length) { return ""; }
        let row = root.tracks[root.cursor-lane];
        if (root.cursor-step < 0 || root.cursor-step >= row.cells.length) { return ""; }
        let c = row.cells[root.cursor-step];
        return row.name + " · step " + (root.cursor-step + 1)
            + (c.hit ? " · hit" : " · rest")
            + " · " + Math.round(c.velocity * 100) + "% velocity"
            + " · " + Math.round(c.probability * 100) + "% probability"
            + (c.edited ? " · edited" : "");
    }
    function fit-matrix() {
        let width = Math.max(matrix-scroll.width, 1px);
        root.matrix-zoom = Math.max(0.02, Math.min(3.0, width / (root.display-cells * root.base-cell-width)));
        root.follow-step = false;
        root.matrix-x = 0px;
    }
    pure function gate-snap-unit() -> float {
        if (root.gate-snap-index == 0) { return 0.25; }
        if (root.gate-snap-index == 1) { return 0.5; }
        if (root.gate-snap-index == 2) { return 0.75; }
        return 1.0;
    }
    pure function gate-snap-length(value: float) -> float {
        let unit = root.gate-snap-unit();
        return Math.max(unit, Math.min(1.0, Math.round(value / unit) * unit));
    }
    in property <float> pulses: 5;
    in property <float> rotate: 0;
    in property <float> density: 0.65;
    in property <float> probability: 1.0;
    in property <float> velocity: 1.0;
    in property <float> gate: 0.12;
    in property <float> regenerate-every: 0;
    in property <float> randomize-after-lengths: 0;
    in property <float> swing: 0;
    in property <float> seed: 0.271;
    in property <float> phase: 0.0;
    in property <float> osc-rate: 2.0;
    in property <float> ca-rule: 30;
    in property <float> markov-bias: 0;
    in property <float> symmetry: 4;
    in property <int> osc-wave: 0;
    in property <[string]> wave-names;
    in property <[string]> wave-paths;
    in property <bool> lfo1-enabled: true;
    in property <int> lfo1-wave: 0;
    in property <int> lfo1-rate-mode: 0;
    in property <float> lfo1-freq: 0.5;
    in property <float> lfo1-rate: 4.0;
    in property <float> lfo1-depth: 0.0;
    in property <float> lfo1-phase: 0.0;
    in property <int> lfo1-polarity: 0;
    in property <float> lfo1-anim-phase: 0.0;
    in property <float> lfo1-dot-y: 20.0;
    in property <bool> lfo2-enabled: true;
    in property <int> lfo2-wave: 1;
    in property <int> lfo2-rate-mode: 0;
    in property <float> lfo2-freq: 0.25;
    in property <float> lfo2-rate: 8.0;
    in property <float> lfo2-depth: 0.0;
    in property <float> lfo2-phase: 0.0;
    in property <int> lfo2-polarity: 0;
    in property <float> lfo2-anim-phase: 0.0;
    in property <float> lfo2-dot-y: 20.0;
    in property <bool> lfo3-enabled: true;
    in property <int> lfo3-wave: 2;
    in property <int> lfo3-rate-mode: 0;
    in property <float> lfo3-freq: 1.0;
    in property <float> lfo3-rate: 2.0;
    in property <float> lfo3-depth: 0.0;
    in property <float> lfo3-phase: 0.0;
    in property <int> lfo3-polarity: 0;
    in property <float> lfo3-anim-phase: 0.0;
    in property <float> lfo3-dot-y: 20.0;
    in property <bool> lfo4-enabled: true;
    in property <int> lfo4-wave: 3;
    in property <int> lfo4-rate-mode: 0;
    in property <float> lfo4-freq: 2.0;
    in property <float> lfo4-rate: 1.0;
    in property <float> lfo4-depth: 0.0;
    in property <float> lfo4-phase: 0.0;
    in property <int> lfo4-polarity: 0;
    in property <float> lfo4-anim-phase: 0.0;
    in property <float> lfo4-dot-y: 20.0;
    in property <bool> lfo-running: false;
    in-out property <bool> matrix-open: false;
    in-out property <length> matrix-y: root.base-height;
    changed matrix-open => {
        root.matrix-y = root.matrix-open ? root.base-height - 300px : root.base-height;
    }
    in property <[ModRow]> mod-rows;
    in-out property <string> mod-status: "";
    in property <bool> scope-mode: true;
    in property <bool> scope-length: true;
    in property <bool> scope-rhythm: true;
    in property <bool> scope-tone: true;
    in property <bool> scope-phase: true;
    in property <bool> scope-acid: true;
    in property <bool> scope-feel: true;
    in property <string> settings-path: "";
    in property <string> credit-author: "";
    in property <string> credit-github: "";
    in property <string> midi-folder: "";
    // DAW track hosting this instance; empty when the host does not report one.
    in property <string> track-name: "";
    // Any text field with keyboard focus. Rust reads this each frame (see `keys.rs`).
    out property <bool> text-focused: midi-input.has-focus || max-steps-box.editing;
    in-out property <string> export-status: "";
    // -1 forces the first update tick to push the real palette (project or global setting)
    // instead of leaving the Slint defaults visible.
    in property <int> theme-index: -1;
    in-out property <bool> mode-menu-open: false;
    in property <[ModeEntry]> mode-entries;
    in property <[ModeRow]> mode-rows;
    in-out property <length> mode-menu-x: 0px;
    in-out property <length> mode-menu-y: 0px;
    in-out property <bool> wave-menu-open: false;
    // 0 = oscillator picker, 1..4 = LFO slot.
    in-out property <int> wave-menu-target: 0;
    in-out property <length> wave-menu-x: 0px;
    in-out property <length> wave-menu-y: 0px;
    in-out property <bool> scope-menu-open: false;
    in-out property <length> scope-menu-x: 0px;
    in-out property <length> scope-menu-y: 0px;
    in-out property <bool> edit-menu-open: false;
    in-out property <length> edit-menu-x: 0px;
    in-out property <length> edit-menu-y: 0px;
    in-out property <bool> settings-open: false;
    // Settings slide in from the right edge of the fixed 860px layout.
    in-out property <length> settings-x: root.base-width;
    changed settings-open => {
        root.settings-x = root.settings-open ? root.base-width - 300px : root.base-width;
    }
    in property <bool> free-run: false;
    in property <bool> invert-on: false;
    in property <bool> mirror-on: false;
    in property <bool> logging-on: false;
    // User-global preference: suppress tweens and one-shot flashes.
    in-out property <bool> reduce-motion: false;
    in property <bool> generate-on: false;
    in property <[TrackRow]> tracks;
    /// 0 = off, 1 = hit, 2 = probability, 3 = accent, 4 = clear cell, 5 = ratchet, 6 = microtiming, 7 = length.
    in-out property <int> edit-mode: 0;
    property <[string]> edit-mode-names: ["OFF", "HIT", "PROB", "ACC", "CLR", "RAT", "TIME", "GATE"];
    property <[string]> edit-mode-hints: [
        "Edit mode off: clicking a step does nothing",
        "Click a step to cycle auto / force on / force off",
        "Cycle a step's hit probability",
        "Cycle a step's accent",
        "Clear every manual edit on a step",
        "Cycle 1-4 ratchet substeps on a step",
        "Delay a step by 0, 1/8, 1/4 or 1/2 step",
        "Drag a step horizontally to set its gate length"
    ];
    /// Exact timing modes lock cell editing so the matrix shows the generator's own cycle.
    in property <bool> matrix-locked: false;
    in property <[ViewNode]> view-nodes;
    in property <string> view-edges: "M0 0";
    in property <string> view-lines: "M0 0";
    in property <string> view-hand: "M0 0";
    in property <string> mode-math: "";
    callback set-mode(int);
    /// Move the mode selection one notch in the grouped display order.
    callback step-mode(int);
    callback apply-preset(int);
    callback set-osc-wave(int);
    callback set-markov-bias(float);
    callback set-lfo-enabled(int, bool);
    callback set-lfo-wave(int, int);
    callback set-lfo-rate-mode(int, int);
    callback set-lfo-speed(int, float);
    callback set-lfo-depth(int, float);
    callback set-lfo-phase(int, float);
    callback set-lfo-polarity(int, int);
    callback delete-mod(int, int);
    callback set-theme(int);
    callback set-opt(int, float);
    callback toggle-round-steps();
    callback toggle-track(int);
    callback edit-step(int, int, int);
    /// track, step, gate fraction (0.02..1.0), begin-gesture.
    callback edit-gate(int, int, float, bool);
    callback clear-edits();
    callback undo-edit();
    callback redo-edit();
    callback toggle-free-run();
    callback toggle-invert();
    callback toggle-mirror();
    callback toggle-logging();
    callback generate-pressed();
    callback randomize-pressed();
    callback toggle-scope(int);
    callback set-midi-folder(string);
    callback export-midi();
    callback toggle-reduce-motion();

    // Window shortcuts, shared by every focus scope. Controls reject keys they do not use, so
    // the event bubbles up the item tree to whichever scope encloses them.
    function handle-key(text: string) -> bool {
        if (text == "g" || text == "G") { root.regen-pulse = true; root.generate-pressed(); return true; }
        if (text == "r" || text == "R") { root.randomize-pressed(); return true; }
        if (text == "s" || text == "S") { root.settings-open = !root.settings-open; return true; }
        if (nav.has-focus) {
            if (text == Key.LeftArrow) { root.move-cursor(0, -1); return true; }
            if (text == Key.RightArrow) { root.move-cursor(0, 1); return true; }
            if (text == Key.UpArrow) { root.move-cursor(-1, 0); return true; }
            if (text == Key.DownArrow) { root.move-cursor(1, 0); return true; }
            if (text == Key.Home) { root.move-cursor(0, -100000); return true; }
            if (text == Key.End) { root.move-cursor(0, 100000); return true; }
            if (text == Key.Return || text == Key.Space) {
                // Mode 0 has no pointer action; Enter still toggles the hit so arrows are useful.
                root.edit-step(root.cursor-lane, root.cursor-step, root.edit-mode == 0 ? 1 : root.edit-mode);
                HoverTip.text = root.cursor-text();
                return true;
            }
        }
        if (text == Key.Escape) {
            root.settings-open = false;
            root.mode-menu-open = false;
            root.wave-menu-open = false;
            root.scope-menu-open = false;
            root.edit-menu-open = false;
            nav.focus();
            return true;
        }
        return false;
    }

    // Expose only the controls the selected mode uses, labelled for that mode; `GenParams` still
    // carries every field.
    pure function shows-param(mode: int, key: int) -> bool {
        // pulses: hidden for modes that never read p.pulses
        if (key == 1) { return !(mode == 20 || mode == 21 || mode == 23 || mode == 24 || mode == 25 || mode == 26 || mode == 27 || mode == 29 || mode == 32); }
        // seed: hidden where the generator never reads it (the shared accent humanizer still does).
        if (key == 4) { return !(mode == 4 || mode == 11 || mode == 31 || mode == 33 || mode == 34); }
        // phase: only modes that consume p.phase
        if (key == 5) { return mode == 2 || mode == 3 || mode == 4 || mode == 6 || mode == 8 || mode == 13 || mode == 16 || mode == 17 || mode == 18 || mode == 28 || mode == 29 || mode == 30 || mode == 31 || (mode >= 33 && mode <= 38); }
        // osc_rate: oscillator, pebble, kuramoto
        if (key == 6) { return mode == 4 || mode == 16 || mode == 18; }
        // ca_rule: cellular, pebble, sieve, vuza
        if (key == 7) { return mode == 3 || mode == 16 || mode == 17 || mode == 32 || mode == 39; }
        // probability: stochastic/chaos modes
        if (key == 8) { return mode == 20 || mode == 21 || mode == 22 || mode == 23 || mode == 24 || mode == 25 || mode == 26 || mode == 27 || mode == 28 || mode == 29 || mode == 30 || mode == 31 || mode == 32; }
        // symmetry: crystallographic, sieve, cellular initial state and L-system grammar
        if (key == 11) { return mode == 3 || mode == 5 || mode == 12 || mode == 17 || mode == 39; }
        return true;
    }
    pure function pulses-max(mode: int) -> float {
        if (mode == 1) { return 3; } // Eulerian degree is 1 + pulses mod 4
        if (mode == 3) { return 15; } // cellular generation
        if (mode == 17) { return 2; } // 0 = silent, 1-2 = union terms
        if (mode == 30) { return 5; } // Hilbert order
        if (mode == 39) { return 64; } // warm-up generations
        return root.cells;
    }
    pure function pulse-label(mode: int) -> string {
        if (mode == 0) { return "Target pulses"; }
        if (mode == 1) { return "Degree"; }
        if (mode == 3) { return "Generation"; }
        if (mode == 4) { return "Requested hits"; }
        if (mode == 5) { return "Motif density"; }
        if (mode == 6) { return "Target peaks"; }
        if (mode == 7) { return "Walk activity"; }
        if (mode == 8) { return "Envelope cycles"; }
        if (mode == 9) { return "Motif pulses"; }
        if (mode == 15) { return "Target onsets"; }
        if (mode == 16) { return "Shaker impulses"; }
        if (mode == 17) { return "Sieve terms"; }
        if (mode == 18) { return "Target onsets"; }
        if (mode == 28) { return "Rotation (Omega)"; }
        if (mode == 30) { return "Order"; }
        if (mode == 31) { return "Target onsets"; }
        if (mode >= 33 && mode <= 38) { return "Target onsets"; }
        return "Pulses";
    }
    pure function density-label(mode: int) -> string {
        if (mode == 6) { return "Growth (r)"; }
        if (mode == 16) { return "Impact sensitivity"; }
        if (mode == 17) { return "Sieve density"; }
        if (mode == 18) { return "Onset density"; }
        if (mode == 28) { return "Coupling K"; }
        if (mode == 33 || mode == 34) { return "Onset density"; }
        if (mode == 35) { return "Step sigma"; }
        if (mode == 36) { return "Tail alpha"; }
        if (mode == 37) { return "Slope (mu)"; }
        if (mode == 38) { return "Map (a)"; }
        if (mode == 39) { return "Warm-up generations"; }
        return "Density";
    }
    pure function phase-label(mode: int) -> string {
        if (mode == 2) { return "Spiral phase"; }
        if (mode == 3) { return "Generation offset"; }
        if (mode == 6) { return "Initial x"; }
        if (mode == 8) { return "Envelope phase"; }
        if (mode == 13) { return "Phase offset"; }
        if (mode == 16) { return "Gravity tilt"; }
        if (mode == 17) { return "Residue shift"; }
        if (mode == 18) { return "Detune spread"; }
        if (mode == 28) { return "Start phase"; }
        if (mode == 29) { return "Word slope"; }
        if (mode == 30) { return "Rotation"; }
        if (mode == 31) { return "Spiral start"; }
        if (mode == 33 || mode == 34) { return "Window offset"; }
        if (mode == 35 || mode == 36) { return "Start position"; }
        if (mode == 37) { return "Initial x"; }
        if (mode == 38) { return "Start offset"; }
        return "Osc phase";
    }
    pure function osc-label(mode: int) -> string {
        if (mode == 16) { return "Substeps"; }
        if (mode == 18) { return "Coupling"; }
        return "Osc cycles";
    }
    pure function ca-label(mode: int) -> string {
        if (mode == 16) { return "Gravity"; }
        if (mode == 17) { return "Sieve moduli"; }
        if (mode == 39) { return "Rule preset"; }
        return "CA rule";
    }
    pure function regen-label(mode: int) -> string {
        return "Regenerate after (lengths, 0=off)";
    }
    in property <[string]> mode-names;
    property <[string]> mode-help: [
        "Places pulses as evenly as possible around the step ring with Bjorklund spacing. Each lane scales the pulse count by its density profile and anchors its word on a different phase, so the kit interleaves instead of stacking.",
        "Builds a balanced directed graph whose vertices are rest plus the eight drum lanes, then walks every edge once with Hierholzer's algorithm. The Euler circuit becomes the step sequence; density gates which visited lanes actually sound.",
        "Rotates every lane by 1/φ per step (222.49°, the mirror of the 137.51° golden angle) and lays the dots on a √i phyllotaxis rosette; the panel draws all eight lanes and a second 1/φ³ spiral in the inner band. Density and pulse ratio set how much of each lane's wedge fires.",
        "Runs a Wolfram elementary cellular automaton on a ring, one row per generation. Pulses and phase choose which generation each lane reads; the rule number decides how the row evolves.",
        "Evaluates one of eight waveforms (sine, triangle, saw, square, pulse, decay, half-sine, noise) at each step with an explicit phase and cycle count. The waveform orders the steps and a density-derived rank cutoff keeps exactly the requested number.",
        "Tiles a seeded motif across the pattern, then applies a symmetry operation per unit cell: translation, mirror, glide, inversion, screw or centering. Symmetry sets the cell size; density sets how full the motif is.",
        "Iterates the logistic map x[n+1] = r·x[n]·(1−x[n]) with r set by density. Onsets land on local peaks above a per-lane cutoff, so related phrases recur without repeating exactly.",
        "Walks a first-order transition table over rest and the eight drum voices. Weights favour role-compatible moves such as kick→snare or hat→hat; density sets the chance of an event at each step.",
        "Thresholds a smooth raised-cosine envelope whose cycle count is the requested hit count. Each envelope cycle contributes one onset, so accents stay periodic and evenly spread.",
        "Builds each lane from a short motif whose length depends on the lane and pulse count, then concatenates phrases over slow subdivisions. Shifts and phrase rules keep the lanes out of phase.",
        "Selects onsets where integer boundary crossings occur in a maximally even pulse train. The seed rotates the circular origin and modular distance shapes the accents.",
        "Generates a Christoffel/Bresenham word with exactly k onsets whose inter-onset gaps differ by at most one. Each lane gets its own phase origin, so the same word interlocks across the kit.",
        "Rewrites a two-symbol alphabet in parallel for up to sixteen generations, then reads the symbols as lane and accent roles; the panel shows the actual A/B word per step. Seed and variation choose one of four rule families.",
        "Repeats one maximally even pulse train on every lane, each copy circularly offset by a fixed span plus user and seed phase. The result is Reich-style phasing over a shared pattern length.",
        "Gives each lane a fixed integer ratio (1:1, 3:2, 2:1, 5:2, 4:3, 2:3, 5:4, 3:4) over the same pattern duration. Pulse count and density scale the number of onsets per ratio.",
        "Scores every step by metric weight, a lane-dependent shifted weight, and deterministic jitter. The highest-scoring steps become onsets, biasing the result toward offbeats and late subdivisions.",
        "Bounces eight pebbles, one per lane, in a box whose gravity can be tilted and strengthened. Each shaker impulse kicks a rotating third of them; a pebble triggers its drum when its wall impact is harder than the density-derived threshold. The panel animates the recorded positions and flashes the wall each hit struck.",
        "Builds a sieve mask from residue classes modulo small primes: two union terms minus a subtracted term. ca_rule picks the moduli, symmetry and phase pick the residues, the pulse count says how many union terms are active. The panel draws the three lattice rows and the resulting step mask; density keeps a fraction of the members.",
        "Runs eight phase oscillators, one per lane, coupled to their ring neighbours. osc_rate sets the coupling strength, phase the frequency spread, pulses the target onsets, and density the per-lane weight. The panel draws the eight phase pointers, their trails and the mean phase vector, so drift and lock are visible.",
        "Builds normal Euclidean spacing, then accent-hits every odd step. The result reads as a swung version of the same necklace, with the underlying pulse grid unchanged.",
        "Each step flips an independent Bernoulli coin per lane with probability density×probability. Lower values give sparse, unstable patterns; high values approach a solid grid.",
        "Repeats a 12-step African bell figure, rotated by a seeded lane offset and gated by probability. The interlocking rotations make the kit feel like a bell ensemble.",
        "Builds a base pulse train of the requested pulses, then shifts each lane by lane×n/8. The overlapping copies form a polymetric canon with a moving phase relationship.",
        "Thresholds a per-lane sinusoidal activator. Density sets the activation threshold and probability gates each cell. The name is inherited from the family it approximates: this is a sine threshold, not a solved reaction-diffusion system.",
        "Integrates the Lorenz system (σ=10, ρ=28, β=8/3) and fires each lane on local z-peaks. The panel draws the butterfly attractor and the current orbit so the motion is visible while it plays.",
        "Samples the Cantor set at the lane's iteration depth and turns its gaps into rests. The result is a self-similar rhythm with holes at every scale, gated by density and probability.",
        "Generates a Sturmian (Fibonacci-type) word from an irrational slope and fires where floor((i+1)α) changes. The word is maximally even and avoids long runs at any density.",
        "Evolves a base pattern by random mutation and keeps changes with probability p. Density controls mutation rate; the pattern drifts while preserving its original shape.",
        "Arnold circle map: a point walks around a circle; each step it moves by Ω plus a wiggle. Pulses set the rotation number Ω, density sets the coupling K (high density means weak coupling), and phase/seed set the start. Onsets happen when the walk wraps around.",
        "Sturmian word: a maximally even rhythm built from an irrational slope. Onsets fire where floor((i+1)α) changes; no long gaps or clusters.",
        "Hilbert curve: a line that fills a square grid. Pulses select the order, phase rotates it by quarter turns, and seed shifts the curve-to-lane mapping (x+2y+i). Density thins each lane's cells evenly along the curve.",
        "Ulam spiral: write numbers in a spiral; onsets land on prime numbers. Density thins the prime hits.",
        "Vuza-style modular subset: a seeded attack set drawn from a cycle whose modulus is ca_rule clamped to 8–32, with each lane reading the cycle at a different rotation. It has the interlocking texture, but it is not a canonical Vuza tiling.",
        "Thue-Morse: the parity of the 1-bits in each step index (A010060). Each lane reads a shifted window of the same self-similar word; density keeps a spread subset of the 1s, and the infinity series colours the accents.",
        "Rudin-Shapiro: the parity of overlapping 11-pairs in the step index (A020985). Each lane reads a shifted window; density keeps a spread subset of the 1s, with a seven-slot accent contour.",
        "Brownian walk: eight reflected random walks with Gaussian steps. Density sets the step size, phase sets the start position, and each lane fires on its largest steps; the panel shows lane 0's path and step sizes.",
        "Levy flight: a heavy-tailed walk built from Pareto steps. Density sets the tail index (more density means heavier jumps); each lane fires on its largest jumps and the panel shows the walk and step sizes.",
        "Tent map: x' = mu·min(x,1−x), started on the attractor after a transient. Density sets the slope, phase the initial x, and each lane fires on its highest normalized samples; the panel draws the return map.",
        "Henon map: the classic two-dimensional attractor, started near the origin with a transient and an escape guard. Density sets a, each lane fires on its largest x-moves, and the panel draws the attractor path.",
        "Life-like CA: a 16x8 torus runs one generation per step under Life, HighLife, Seeds, Day & Night or a dense survival rule. Pulses sets warm-up generations, density seeds the grid, and a lane fires when its row has live cells; accent follows population."
    ];
    pure function symmetry-label(mode: int) -> string {
        if (mode == 3) { return "Initial state"; }
        if (mode == 12) { return "Grammar"; }
        if (mode == 39) { return "Initial shape"; }
        return "Symmetry";
    }
    pure function symmetry-text(mode: int, value: float) -> string {
        let v = Math.round(value);
        if (mode == 3) {
            if (v == 1) { return "Centre"; }
            if (v == 2) { return "Stripes"; }
            if (v == 3) { return "Solid + gap"; }
            return "Random";
        }
        if (mode == 39) {
            if (v == 1) { return "Centre"; }
            if (v == 2) { return "Stripes"; }
            if (v == 3) { return "Sparse"; }
            return "Random";
        }
        if (mode == 12) {
            if (v == 1) { return "Family A"; }
            if (v == 2) { return "Family B"; }
            if (v == 3) { return "Family C"; }
            if (v == 5) { return "Family D"; }
            return "Auto";
        }
        return "\{v}";
    }

    property <[Opt]> opts: [
        { label: "Steps", min: 1, max: root.max-steps, value: root.steps, text: root.round-steps ? "\{Math.round(root.steps)}" : "\{Math.round(root.steps * 1000) / 1000}", step: root.round-steps ? 1 : 0.01, number: root.round-steps ? "\{Math.round(root.steps)}" : "\{Math.round(root.steps * 1000) / 1000}", scale: 1 },
        { label: root.pulse-label(root.mode), min: 0, max: root.pulses-max(root.mode), value: Math.min(root.pulses, root.pulses-max(root.mode)), text: "\{Math.round(Math.min(root.pulses, root.pulses-max(root.mode)))}", step: 1, number: "\{Math.round(Math.min(root.pulses, root.pulses-max(root.mode)))}", scale: 1 },
        { label: "Rotate", min: 0, max: Math.max(root.cells - 1, 0), value: Math.min(root.rotate, Math.max(root.cells - 1, 0)), text: "\{Math.round(Math.min(root.rotate, Math.max(root.cells - 1, 0)))}", step: 1, number: "\{Math.round(Math.min(root.rotate, Math.max(root.cells - 1, 0)))}", scale: 1 },
        { label: root.density-label(root.mode), min: 0, max: 1, value: root.density, text: "\{Math.round(root.density * 100)}%", step: 0.01, number: "\{Math.round(root.density * 100)}", scale: 0.01 },
        { label: "Seed", min: 0, max: 1, value: root.seed, text: "\{Math.round(root.seed * 1000) / 1000}", step: 0.001, number: "\{Math.round(root.seed * 1000) / 1000}", scale: 1 },
        { label: root.phase-label(root.mode), min: 0, max: 1, value: root.phase, text: "\{Math.round(root.phase * 360)}°", step: 0.01, number: "\{Math.round(root.phase * 360)}", scale: 1.0 / 360.0 },
        { label: root.osc-label(root.mode), min: root.mode == 16 ? 1 : 0.125, max: root.mode == 16 ? 16 : 8, value: root.mode == 16 ? Math.max(root.osc-rate, 1) : root.osc-rate, text: root.mode == 16 ? "\{Math.round(Math.max(root.osc-rate, 1))}" : "\{Math.round(root.osc-rate * 100) / 100}", step: root.mode == 16 ? 1 : 0.125, number: root.mode == 16 ? "\{Math.round(Math.max(root.osc-rate, 1))}" : "\{Math.round(root.osc-rate * 100) / 100}", scale: 1 },
        { label: root.ca-label(root.mode), min: 0, max: 255, value: root.ca-rule, text: root.mode == 16 ? "\{Math.round(root.ca-rule / 255 * 100)}%" : "\{Math.round(root.ca-rule)}", step: 1, number: root.mode == 16 ? "\{Math.round(root.ca-rule / 255 * 100)}" : "\{Math.round(root.ca-rule)}", scale: root.mode == 16 ? 2.55 : 1 },
        { label: "Probability", min: 0, max: 1, value: root.probability, text: "\{Math.round(root.probability * 100)}%", step: 0.01, number: "\{Math.round(root.probability * 100)}", scale: 0.01 },
        { label: "Velocity", min: 0.01, max: 1, value: root.velocity, text: "\{Math.round(root.velocity * 100)}%", step: 0.01, number: "\{Math.round(root.velocity * 100)}", scale: 0.01 },
        { label: root.regen-label(root.mode), min: 0, max: 256, value: root.regenerate-every, text: "\{Math.round(root.regenerate-every)}", step: 1, number: "\{Math.round(root.regenerate-every)}", scale: 1 },
        { label: root.symmetry-label(root.mode), min: 1, max: 8, value: root.symmetry, text: root.symmetry-text(root.mode, root.symmetry), step: 1, number: "\{Math.round(root.symmetry)}", scale: 1 },
        { label: "Randomize after lengths", min: 0, max: 256, value: root.randomize-after-lengths, text: "\{Math.round(root.randomize-after-lengths)}", step: 1, number: "\{Math.round(root.randomize-after-lengths)}", scale: 1 },
        { label: "Swing", min: 0, max: 0.5, value: root.swing, text: "\{Math.round(root.swing * 300)}%", step: 0.01, number: "\{Math.round(root.swing * 300)}", scale: 1.0 / 300.0 },
        { label: "Gate", min: 0.02, max: 1, value: root.gate, text: "\{Math.round(root.gate * 100)}%", step: 0.01, number: "\{Math.round(root.gate * 100)}", scale: 0.01 },
        { label: "Transition bias", min: 0, max: 255, value: root.markov-bias, text: "\{Math.round(root.markov-bias)}", step: 1, number: "\{Math.round(root.markov-bias)}", scale: 1 }
    ];

    // One fixed 860x768 coordinate space; the matrix scrolls fixed-width cells, so nothing reflows.
    // Also the keyboard root: it owns focus at startup and maps window shortcuts.
    nav := FocusScope {
        width: root.base-width; height: root.base-height;
        init => { self.focus(); }
        key-pressed(event) => {
            if (root.handle-key(event.text)) { return accept; }
            reject
        }

        // Faint graph paper for Sketch; it sits below the layout so only gaps between cards show it.
        Rectangle {
            visible: root.theme-index == 0;
            for i in 38: Rectangle { y: (i + 1) * 20px; height: 1px; background: Theme.border.with-alpha(0.16); }
            for i in 43: Rectangle { x: (i + 1) * 20px; width: 1px; height: parent.height; background: Theme.border.with-alpha(0.16); }
        }
        Timer {
            interval: 180ms;
            running: root.regen-pulse;
            triggered => { root.regen-pulse = false; }
        }
        Timer {
            interval: 4s;
            running: root.mod-status != "";
            triggered => { root.mod-status = ""; }
        }
        Rectangle {
            // Generate answers with one bloom over the drawing: quick to arrive, slow to leave,
            // so the panel reads as changed without the pattern itself moving.
            width: parent.width; height: parent.height;
            opacity: 0;
            background: @linear-gradient(135deg, Theme.c1 0%, Theme.c2 50%, Theme.c3 100%);
            states [
                pulse when root.regen-pulse: {
                    opacity: 0.16;
                    in { animate opacity { duration: root.reduce-motion ? 0ms : 70ms; easing: ease-out; } }
                    out { animate opacity { duration: root.reduce-motion ? 0ms : 450ms; easing: ease-in-out; } }
                }
            ]
        }

    VerticalLayout {
        padding: 14px; spacing: 8px;
        HorizontalLayout {
            height: 34px; spacing: 6px;
            Text { text: "nrum seq"; color: Theme.text; font-size: Type.display; font-weight: 700; letter-spacing: 0.5px; vertical-alignment: center; }
            Text { visible: root.track-name != ""; text: "· \{root.track-name}"; color: Theme.text-muted; font-size: Type.caption; vertical-alignment: center; overflow: elide; }
            // Hover descriptions live in the bottom status strip, clear of the pointer.
            Rectangle { horizontal-stretch: 1; }
            Rectangle { width: 72px; height: 24px; border-radius: 4px; background: root.free-run ? Theme.c1.with-alpha(0.22) : Theme.control; Text { text: "free-run"; color: Theme.text; font-size: Type.caption; horizontal-alignment: center; vertical-alignment: center; } free-touch := TipTouch { hint: "Run the internal clock when the host transport is stopped"; clicked => { root.toggle-free-run(); } } }
            Text { text: root.free-run ? "FREE-RUN CLOCK: ON" : "SYNC: HOST TRANSPORT"; color: root.free-run ? Theme.c1 : Theme.text-muted; font-size: Type.caption; vertical-alignment: center; }
            Text { text: root.loop-capped ? "CAPPED · loop exceeds 1024 steps" : root.timing-summary; color: root.loop-capped ? Theme.c3 : Theme.text-muted; font-size: Type.caption; vertical-alignment: center; overflow: elide; }
            Rectangle {
                width: 112px; height: 30px; border-radius: 5px; background: Theme.hi;
                border-width: generate-touch.has-hover ? 2px : 0px; border-color: Theme.c1;
                Text { text: root.generate-on ? "RE-GENERATE ↻" : "GENERATE ↻"; color: Theme.on-accent; font-size: Type.value; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                // The shared focus ring is the same hue as this fill, so the primary action carries
                // its own contrasting inset ring.
                if generate-touch.has-focus: Rectangle {
                    x: 2px; y: 2px; width: parent.width - 4px; height: parent.height - 4px;
                    border-radius: 3px; border-width: 1px; border-color: Theme.on-accent; background: transparent;
                }
                generate-touch := TipTouch { hint: "Create a new deterministic variation of the current pattern"; clicked => { root.regen-pulse = true; root.generate-pressed(); } }
            }
            Rectangle { width: 112px; height: 30px; border-radius: 5px; background: randomize-touch.has-hover ? Theme.control-hover : Theme.control; Text { text: "RANDOMIZE ⚄"; color: Theme.text; font-size: Type.value; horizontal-alignment: center; vertical-alignment: center; } randomize-touch := TipTouch { hint: "Randomize the parameter groups enabled in RANDOMIZE SCOPE"; clicked => { root.randomize-pressed(); } } }
            Rectangle { width: 40px; height: 30px; border-radius: 5px; background: settings-touch.has-hover ? Theme.c2 : Theme.control; Text { text: "⚙"; color: settings-touch.has-hover ? Theme.on-accent : Theme.text; font-size: Type.glyph-large; horizontal-alignment: center; vertical-alignment: center; } settings-touch := TipTouch { hint: "Open settings: theme, presets, limits, export and credits"; clicked => { root.settings-open = !root.settings-open; } } }
        }
        HorizontalLayout {
            // 300px fits the description and live math line without squeezing the sliders.
            height: 300px; spacing: 10px;
            ModePanel {
                nodes: root.view-nodes; edges: root.view-edges; lines: root.view-lines; hand: root.view-hand;
                reduce-motion: root.reduce-motion;
                xray-lane: root.hover-step >= 0 ? root.hover-lane : (root.cursor-visible ? root.cursor-lane : -1);
                xray-step: root.hover-step >= 0 ? root.hover-step : (root.cursor-visible ? root.cursor-step : -1);
                xray-active: root.xray-active;
                probe-at(x, y) => { root.probe-at(x, y); }
            }
            VerticalLayout {
                spacing: 3px; alignment: start;
                mode-header := Rectangle {
                    height: 30px; border-radius: 4px;
                    background: mode-menu-touch.has-hover ? Theme.control-hover : Theme.control;
                    Text { x: 8px; width: parent.width - 16px; height: parent.height; text: "MODE  ·  \{root.mode-names[root.mode]}  ▾"; color: Theme.c1; font-size: Type.title; font-weight: 700; vertical-alignment: center; overflow: elide; }
                    mode-menu-touch := TipTouch { hint: "Open the grouped generator mode list";
                        clicked => {
                            root.mode-menu-open = !root.mode-menu-open;
                            if (root.mode-menu-open) {
                                root.mode-menu-x = mode-header.absolute-position.x;
                                root.mode-menu-y = mode-header.absolute-position.y + mode-header.height + 2px;
                            }
                        }
                        scroll-event(e) => {
                            if (e.delta-y != 0px) {
                                root.step-mode(e.delta-y > 0px ? 1 : -1);
                                accept
                            } else {
                                reject
                            }
                        }
                    }
                }
                Text { text: root.mode-help[root.mode]; color: Theme.text; font-size: Type.body; horizontal-alignment: left; wrap: word-wrap; }
                // Live formula with the current snapshot, pushed from the generator's own helpers.
                Text { text: root.mode-math; color: Theme.text-muted; font-size: Type.value; font-italic: true; horizontal-alignment: left; wrap: word-wrap; }
                Rectangle { height: 2px; }
                HorizontalLayout { spacing: 5px;
                    OptSlider { opt: root.opts[0]; mod-target: 0; changed(v) => { root.set-opt(0, v); } }
                    if root.shows-param(root.mode, 1): OptSlider { opt: root.opts[1]; mod-target: 1; changed(v) => { root.set-opt(1, v); } }
                    OptSlider { opt: root.opts[2]; mod-target: 2; changed(v) => { root.set-opt(2, v); } }
                    OptSlider { opt: root.opts[3]; mod-target: 3; changed(v) => { root.set-opt(3, v); } }
                }
                HorizontalLayout {
                    spacing: 5px;
                    OptSlider { opt: root.opts[4]; mod-target: 4; changed(v) => { root.set-opt(4, v); } }
                    if root.shows-param(root.mode, 5): OptSlider { opt: root.opts[5]; mod-target: 5; changed(v) => { root.set-opt(5, v); } }
                    if root.shows-param(root.mode, 6): OptSlider { opt: root.opts[6]; mod-target: 6; changed(v) => { root.set-opt(6, v); } }
                    if root.shows-param(root.mode, 7): OptSlider { opt: root.opts[7]; mod-target: 7; changed(v) => { root.set-opt(7, v); } }
                }
                HorizontalLayout { spacing: 5px;
                    OptSlider { horizontal-stretch: 1; opt: root.opts[8]; mod-target: 8; changed(v) => { root.set-opt(8, v); } }
                    OptSlider { width: 100px; opt: root.opts[9]; mod-target: 11; changed(v) => { root.set-opt(9, v); } }
                    OptSlider { width: 100px; opt: root.opts[13]; mod-target: 9; changed(v) => { root.set-opt(13, v); } }
                    OptSlider { width: 82px; opt: root.opts[14]; mod-target: 10; changed(v) => { root.set-opt(15, v); } }
                }
                if root.shows-param(root.mode, 11): HorizontalLayout { spacing: 5px; OptSlider { opt: root.opts[11]; mod-target: 13; changed(v) => { root.set-opt(11, v); } } }
                if root.mode == 7: HorizontalLayout { spacing: 5px; OptSlider { width: 170px; opt: root.opts[15]; changed(v) => { root.set-markov-bias(v); } } Text { horizontal-stretch: 1; text: "rest · repeat · role · novelty (2 bits each)"; color: Theme.text-muted; font-size: Type.caption; vertical-alignment: center; overflow: elide; } }
                if root.mode == 4: HorizontalLayout {
                    WavePicker {
                        width: 200px; height: 28px;
                        paths: root.wave-paths; names: root.wave-names; current: root.osc-wave;
                        selected(i) => { root.set-osc-wave(i); }
                        opened(x, y) => {
                            root.wave-menu-open = true;
                            root.wave-menu-target = 0;
                            root.wave-menu-x = x;
                            root.wave-menu-y = y + 2px;
                        }
                    }
                    Rectangle { horizontal-stretch: 1; }
                }
            }
        }
        HorizontalLayout { spacing: 4px;
            Rectangle { width: 62px; height: 24px; border-radius: 3px; background: root.invert-on ? Theme.c2.with-alpha(0.35) : Theme.control; Text { text: "INVERT"; color: Theme.text; font-size: Type.caption; horizontal-alignment: center; vertical-alignment: center; } invert-touch := TipTouch { hint: "Swap every generated hit with a rest"; clicked => { root.toggle-invert(); } } }
            Rectangle { width: 62px; height: 24px; border-radius: 3px; background: root.mirror-on ? Theme.c3.with-alpha(0.35) : Theme.control; Text { text: "MIRROR"; color: Theme.text; font-size: Type.caption; horizontal-alignment: center; vertical-alignment: center; } mirror-touch := TipTouch { hint: "Reverse the generated steps after rotation"; clicked => { root.toggle-mirror(); } } }
            if !root.matrix-locked: Rectangle {
                width: 104px; height: 24px; border-radius: 3px;
                background: root.edit-mode != 0 ? Theme.c2.with-alpha(0.35) : (edit-menu-touch.has-hover ? Theme.control-hover : Theme.control);
                Text {
                    text: "EDIT · " + root.edit-mode-names[root.edit-mode] + " ▾";
                    color: root.edit-mode != 0 ? Theme.text : Theme.text-muted;
                    font-size: Type.caption; horizontal-alignment: center; vertical-alignment: center; overflow: elide;
                }
                edit-menu-touch := TipTouch { hint: "Choose what clicking a matrix step edits";
                    clicked => {
                        root.edit-menu-open = !root.edit-menu-open;
                        if (root.edit-menu-open) {
                            root.edit-menu-x = edit-menu-touch.absolute-position.x;
                            root.edit-menu-y = edit-menu-touch.absolute-position.y + edit-menu-touch.height + 2px;
                            root.mode-menu-open = false;
                            root.scope-menu-open = false;
                        }
                    }
                }
            }
            if !root.matrix-locked: Rectangle { width: 44px; height: 24px; border-radius: 3px; background: undo-touch.has-hover ? Theme.control-hover : Theme.control; Text { text: "UNDO"; color: Theme.text; font-size: Type.caption; horizontal-alignment: center; vertical-alignment: center; } undo-touch := TipTouch { hint: "Undo the last manual step edit"; clicked => { root.undo-edit(); } } }
            if !root.matrix-locked: Rectangle { width: 44px; height: 24px; border-radius: 3px; background: redo-touch.has-hover ? Theme.control-hover : Theme.control; Text { text: "REDO"; color: Theme.text; font-size: Type.caption; horizontal-alignment: center; vertical-alignment: center; } redo-touch := TipTouch { hint: "Redo the last undone step edit"; clicked => { root.redo-edit(); } } }
            if !root.matrix-locked: Rectangle { width: 8px; }
            if !root.matrix-locked: Rectangle { width: 54px; height: 24px; border-radius: 3px; background: clear-edits-touch.has-hover ? Theme.hi : Theme.control; Text { text: "CLR ALL"; color: clear-edits-touch.has-hover ? Theme.on-accent : Theme.text; font-size: Type.caption; horizontal-alignment: center; vertical-alignment: center; } clear-edits-touch := TipTouch { hint: "Clear all manual step edits in this pattern"; clicked => { root.clear-edits(); } } }
            if root.edit-mode == 7: Rectangle { width: 64px; height: 24px; border-radius: 3px; background: Theme.control; Text { text: "SNAP " + (root.gate-snap-index == 0 ? "1/4" : (root.gate-snap-index == 1 ? "1/2" : (root.gate-snap-index == 2 ? "3/4" : "1"))); color: Theme.text; font-size: Type.caption; horizontal-alignment: center; vertical-alignment: center; } gate-snap-touch := TipTouch { hint: "Gate snap: click to cycle 1/4, 1/2, 3/4 or 1 step"; clicked => { root.gate-snap-index = Math.mod(root.gate-snap-index + 1, 4); } } }
            Rectangle { horizontal-stretch: 1; }
            Rectangle { width: 24px; height: 24px; border-radius: 3px; background: zoom-out.has-hover ? Theme.control-hover : Theme.control; Text { text: "−"; color: Theme.text; font-size: Type.glyph; horizontal-alignment: center; vertical-alignment: center; } zoom-out := TipTouch { hint: "Zoom the matrix out"; clicked => { root.zoom-matrix(0.8); } } }
            Rectangle { width: 24px; height: 24px; border-radius: 3px; background: zoom-in.has-hover ? Theme.control-hover : Theme.control; Text { text: "+"; color: Theme.text; font-size: Type.glyph; horizontal-alignment: center; vertical-alignment: center; } zoom-in := TipTouch { hint: "Zoom the matrix in"; clicked => { root.zoom-matrix(1.25); } } }
            Rectangle { width: 36px; height: 24px; border-radius: 3px; background: fit-touch.has-hover ? Theme.control-hover : Theme.control; Text { text: "FIT"; color: Theme.text; font-size: Type.caption; horizontal-alignment: center; vertical-alignment: center; } fit-touch := TipTouch { hint: "Fit the whole pattern in the matrix"; clicked => { root.fit-matrix(); } } }
            Rectangle { width: 28px; height: 24px; border-radius: 3px; background: row-out.has-hover ? Theme.control-hover : Theme.control; Text { text: "V−"; color: Theme.text; font-size: Type.caption; horizontal-alignment: center; vertical-alignment: center; } row-out := TipTouch { hint: "Make lane rows shorter (vertical zoom out)"; clicked => { root.matrix-row-zoom = Math.max(0.65, root.matrix-row-zoom * 0.85); } } }
            Rectangle { width: 28px; height: 24px; border-radius: 3px; background: row-in.has-hover ? Theme.control-hover : Theme.control; Text { text: "V+"; color: Theme.text; font-size: Type.caption; horizontal-alignment: center; vertical-alignment: center; } row-in := TipTouch { hint: "Make lane rows taller (vertical zoom in)"; clicked => { root.matrix-row-zoom = Math.min(1.55, root.matrix-row-zoom * 1.15); } } }
            Rectangle { width: 86px; height: 24px; border-radius: 3px; background: root.follow-step ? Theme.c1.with-alpha(0.16) : (follow-touch.has-hover ? Theme.control-hover : Theme.control); Text { text: root.follow-step ? "FOLLOW: ON" : "FOLLOW: OFF"; color: root.follow-step ? Theme.c1 : Theme.text-muted; font-size: Type.caption; horizontal-alignment: center; vertical-alignment: center; } follow-touch := TipTouch { hint: "Keep the matrix scrolled to the playhead"; clicked => { root.follow-step = !root.follow-step; } } }
        }
        HorizontalLayout {
            spacing: 4px;
            labels-scroll := ScrollView {
                width: 100px; height: 288px;
                vertical-scrollbar-policy: always-off;
                horizontal-scrollbar-policy: always-off;
                viewport-height: 14px + root.tracks.length * root.matrix-row-height + (root.tracks.length - 1) * 2px;
                viewport-y <=> root.matrix-scroll-y;
                VerticalLayout {
                    spacing: 2px;
                    Rectangle { height: 14px; }
                    for track in root.tracks: Rectangle {
                        width: 100px; height: root.matrix-row-height; border-radius: 3px;
                        background: track.enabled ? Theme.control : Theme.cell-off;
                        Text { x: 4px; width: parent.width - 36px; height: parent.height; text: track.name; color: track.enabled ? Theme.text : Theme.text-muted.with-alpha(0.55); font-size: Type.caption; vertical-alignment: center; overflow: elide; }
                        // Mode-owned cycle length: a filled badge means this lane has its own period.
                        Text {
                            x: parent.width - 32px; width: 28px; height: parent.height;
                            text: root.loop-view && root.lane-steps[track.index] > 0 ? "↻\{root.lane-steps[track.index]}" : "";
                            color: root.loop-view && root.lane-steps[track.index] > 0 ? Theme.c2 : Theme.text-muted.with-alpha(0.5);
                            // Four digits are the 1024-step ceiling; step down inside the 28px badge.
                            font-size: root.lane-steps[track.index] >= 1000 ? Type.dense : Type.caption;
                            horizontal-alignment: center; vertical-alignment: center;
                        }
                        TipTouch {
                            hint: track.name + " · note " + track.note
                                + " · cycle " + (root.lane-steps[track.index] > 0 ? "\{root.lane-steps[track.index]}" : "master")
                                + " · click to enable or disable";
                            clicked => { root.toggle-track(track.index); }
                        }
                    }
                }
            }
            matrix-scroll := ScrollView {
                horizontal-stretch: 1; height: 288px;
                vertical-scrollbar-policy: as-needed;
                horizontal-scrollbar-policy: as-needed;
                viewport-width: root.display-cells * root.matrix-cell-width;
                viewport-height: 14px + root.tracks.length * root.matrix-row-height + (root.tracks.length - 1) * 2px;
                viewport-x <=> root.matrix-x;
                viewport-y <=> root.matrix-scroll-y;
                // User drags/wheel disable following; the follow write lands on `follow-x()`.
                scrolled() => {
                    if (Math.abs(root.matrix-x - root.follow-x()) > 2px) { root.follow-step = false; }
                }
                VerticalLayout {
                    width: root.display-cells * root.matrix-cell-width;
                    spacing: 2px;
                    // Bar/beat ruler. Positions are exact floats from the mode's step unit and
                    // the pattern's implied meter, so fractional and odd meters land between cells.
                    Rectangle {
                        width: parent.width; height: 14px;
                        background: Theme.surface.with-alpha(0.35);
                        for b in root.bar-count: Rectangle {
                            visible: b > 0;
                            x: b * root.steps-per-bar * root.matrix-cell-width;
                            width: 1px; height: parent.height;
                            background: Theme.c1.with-alpha(0.35);
                        }
                        for i in root.beat-line-count: Rectangle {
                            visible: i > 0;
                            x: i * root.steps-per-beat * root.matrix-cell-width;
                            width: 1px; height: parent.height;
                            background: Theme.text-muted.with-alpha(0.24);
                        }
                        Rectangle {
                            visible: root.loop-view && root.loop-steps > 0;
                            x: root.loop-steps * root.matrix-cell-width - 1px;
                            width: 1px; height: parent.height;
                            background: Theme.hi;
                        }
                        for b in root.ruler-label-count: Text {
                            x: b * root.steps-per-bar * root.matrix-cell-width + 2px;
                            width: Math.max(20px, root.matrix-cell-width * root.steps-per-bar - 4px);
                            height: parent.height;
                            text: "\{b + 1}";
                            color: Theme.text-muted; font-size: Type.caption; vertical-alignment: center;
                        }
                    }
                    for track in root.tracks: Rectangle {
                        height: root.matrix-row-height;
                        // Meter lines behind the cells; hits stay readable above them.
                        for i in root.beat-line-count: Rectangle {
                            visible: i > 0;
                            x: i * root.steps-per-beat * root.matrix-cell-width;
                            width: 1px; height: parent.height;
                            background: Theme.text-muted.with-alpha(0.45);
                        }
                        for b in root.bar-count: Rectangle {
                            visible: b > 0;
                            x: b * root.steps-per-bar * root.matrix-cell-width;
                            width: 1px; height: parent.height;
                            background: Theme.c1.with-alpha(0.40);
                        }
                        Rectangle {
                            visible: root.loop-view && root.loop-steps > 0;
                            x: root.loop-steps * root.matrix-cell-width - 1px;
                            width: 1px; height: parent.height;
                            background: Theme.hi.with-alpha(0.65);
                        }
                        HorizontalLayout {
                            spacing: 0px;
                            for cell in track.cells: Rectangle {
                                width: root.matrix-cell-width; height: parent.height;
                                cell-box := Rectangle {
                                    x: 0px; y: 0px;
                                    width: parent.width - root.matrix-cell-gap; height: parent.height;
                                    border-radius: root.matrix-cell-radius;
                                    // Alternate bars so long patterns remain readable when zoomed out.
                                    background: Math.mod(Math.floor(cell.step / root.steps-per-bar), 2) == 0
                                        ? (cell.hit ? Theme.cell-off : Theme.surface)
                                        : Theme.cell-off.with-alpha(cell.hit ? 0.78 : 0.85);
                                    opacity: track.enabled ? 1.0 : 0.35;
                                    property <bool> cursor-cell: root.cursor-visible
                                        && cell.step == root.cursor-step && track.index == root.cursor-lane;
                                    property <bool> probe-cell: root.probe-step >= 0 && cell.step == root.probe-step
                                        && (root.probe-lane < 0 || root.probe-lane == track.index);
                                    border-width: probe-cell ? 2px : (cell.playing ? 2px : (cursor-cell ? 2px : (cell.edited ? 1px : 0px)));
                                    border-color: probe-cell ? Theme.hi : (cell.playing ? Theme.hi : (cursor-cell ? Theme.c1 : Theme.border));
                                    if cell.playing: Rectangle {
                                        x: 0px; y: 0px; width: parent.width; height: parent.height;
                                        background: Theme.hi.with-alpha(0.08);
                                    }
                                    // Meter lines are drawn once per row behind the cells; drawing them
                                    // per cell as well doubled the hottest repeater.
                                    // One note body per ratchet segment: width = gate,
                                    // height = velocity, opacity = probability, lane colour = lane.
                                    property <int> segments: cell.ratchet < 1 ? 1 : cell.ratchet;
                                    property <length> body-x: 1px + (parent.width - 3px) * Math.min(0.9, cell.offset / 127.0);
                                    property <length> body-w: Math.min(parent.width, Math.max(2px, (parent.width - 3px) * Math.min(cell.length, 1.0 - Math.min(0.9, cell.offset / 127.0))));
                                    if cell.hit: Rectangle {
                                        x: 0px; y: 0px; width: parent.width; height: parent.height;
                                        for r in cell-box.segments: Rectangle {
                                            x: cell-box.body-x + (cell-box.body-w / cell-box.segments) * r + 0.5px;
                                            width: Math.max(1px, cell-box.body-w / cell-box.segments - 1px);
                                            y: 2px + (1.0 - cell.velocity) * (parent.height - 4px);
                                            height: Math.max(2px, cell.velocity * (parent.height - 4px));
                                            border-radius: 1px;
                                            background: Theme.lanes[Math.mod(track.index, 8)].with-alpha(0.30 + 0.70 * cell.probability);
                                        }
                                    }
                                    // Probability indicator: top strip whose opacity encodes probability.
                                    if cell.hit && cell.probability < 1.0: Rectangle {
                                        x: 1px; y: 1px;
                                        width: parent.width - 3px; height: 2px;
                                        border-radius: 1px;
                                        background: Theme.on-accent.with-alpha(0.9 * (1.0 - cell.probability));
                                    }
                                    // Manual edit markers: force-on bottom-right, force-off top-right.
                                    if cell.hit-override == 1: Rectangle {
                                        x: parent.width - 4px; y: parent.height - 4px; width: 3px; height: 3px;
                                        border-radius: 1px; background: Theme.c2;
                                    }
                                    if cell.hit-override == 2: Rectangle {
                                        x: parent.width - 4px; y: 1px; width: 3px; height: 3px;
                                        border-radius: 1px; background: Theme.hi;
                                    }
                                }
                            }
                        }
                        xray-ta := TouchArea {
                            x: 0px; y: 0px; width: parent.width; height: parent.height;
                            // `moved` means "dragging", not "hovering"; a plain TouchArea reports
                            // hover through has-hover and mouse-x, so watch those instead.
                            property <int> hovered-step: Math.max(0, Math.min(root.display-cells - 1,
                                Math.floor(xray-ta.mouse-x / root.matrix-cell-width)));
                            changed hovered-step => {
                                if (xray-ta.has-hover) {
                                    root.hover-lane = track.index;
                                    root.hover-step = xray-ta.hovered-step;
                                    root.xray-hover(track.index, xray-ta.hovered-step);
                                }
                            }
                            changed has-hover => {
                                if (xray-ta.has-hover) {
                                    root.hover-lane = track.index;
                                    root.hover-step = xray-ta.hovered-step;
                                    root.xray-hover(track.index, xray-ta.hovered-step);
                                } else if (root.hover-lane == track.index) {
                                    root.hover-lane = -1;
                                    root.hover-step = -1;
                                    if (root.cursor-visible) {
                                        root.xray-hover(root.cursor-lane, root.cursor-step);
                                    } else {
                                        root.xray-hover(-1, -1);
                                    }
                                }
                            }
                        }
                        if root.edit-mode > 0: Rectangle {
                            x: 0px; y: 0px; width: parent.width; height: parent.height;
                            background: transparent;
                            editor-ta := TouchArea {
                                pointer-event(e) => {
                                    let step = Math.floor(editor-ta.mouse-x / root.matrix-cell-width);
                                    let fraction = (editor-ta.mouse-x / root.matrix-cell-width) - step;
                                    root.hover-lane = track.index;
                                    root.hover-step = Math.max(0, Math.min(root.display-cells - 1, step));
                                    root.xray-hover(track.index, root.hover-step);
                                    if (root.edit-mode == 7) {
                                        if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                                            root.gate-dragging = true;
                                            root.edit-gate(track.index, step, root.gate-snap-length(fraction), true);
                                        } else if (e.kind == PointerEventKind.move && root.gate-dragging) {
                                            root.edit-gate(track.index, step, root.gate-snap-length(fraction), false);
                                        } else if (e.kind == PointerEventKind.up || e.kind == PointerEventKind.cancel) {
                                            root.gate-dragging = false;
                                        }
                                    } else if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                                        root.edit-step(track.index, step, root.edit-mode);
                                    }
                                }
                                changed has-hover => {
                                    if (!editor-ta.has-hover && root.hover-lane == track.index) {
                                        root.hover-lane = -1;
                                        root.hover-step = -1;
                                        if (root.cursor-visible) {
                                            root.xray-hover(root.cursor-lane, root.cursor-step);
                                        } else {
                                            root.xray-hover(-1, -1);
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        HorizontalLayout {
            height: 27px; spacing: 5px;
            HorizontalLayout {
                spacing: 0px;
                OptSlider { width: 205px; opt: root.opts[12]; mod-target: 14; changed(v) => { root.set-opt(12, v); } }
                scope-gear := Rectangle {
                    width: 25px; height: 25px; border-radius: 4px;
                    background: root.scope-menu-open ? Theme.c2 : (scope-touch.has-hover ? Theme.control-hover : Theme.control);
                    Text { text: "⚙"; color: root.scope-menu-open ? Theme.on-accent : Theme.text; font-size: Type.glyph-small; horizontal-alignment: center; vertical-alignment: center; }
                    scope-touch := TipTouch { hint: "Toggle this group for RANDOMIZE";
                        clicked => {
                            root.scope-menu-open = !root.scope-menu-open;
                            if (root.scope-menu-open) {
                                root.scope-menu-x = scope-gear.absolute-position.x + scope-gear.width - 160px;
                                root.scope-menu-y = scope-gear.absolute-position.y - 118px;
                            }
                        }
                    }
                }
            }
            OptSlider { width: 230px; opt: root.opts[10]; mod-target: 12; changed(v) => { root.set-opt(10, v); } }
            Rectangle { horizontal-stretch: 1; }
            Rectangle {
                width: 96px; height: 24px; border-radius: 4px;
                background: export-touch.has-hover ? Theme.c2 : Theme.control;
                Text { text: "EXPORT MIDI"; color: export-touch.has-hover ? Theme.on-accent : Theme.text; font-size: Type.caption; horizontal-alignment: center; vertical-alignment: center; }
                export-touch := TipTouch { hint: "Write one loop as a Standard MIDI File"; clicked => { root.export-midi(); } }
            }
        }
        // Thin status strip: hover descriptions and edit/export feedback live here, clear of the
        // pointer and out of the header. Keep the inset and alignment identical to nelody seq.
        Rectangle {
            height: 20px; border-radius: 3px;
            background: Theme.surface.with-alpha(0.55);
            border-width: 1px; border-color: Theme.border.with-alpha(0.7);
            Text {
                x: 8px; width: parent.width - 16px; height: parent.height;
                text: HoverTip.text != ""
                    ? HoverTip.text
                    : (root.mod-status != ""
                        ? root.mod-status
                        : (root.export-status != ""
                            ? root.export-status
                            : "height = velocity · width = gate · opacity = probability · segments = ratchet · drag GATE to edit"));
                color: HoverTip.text != "" ? Theme.text : Theme.text-muted;
                font-size: Type.caption; horizontal-alignment: left; vertical-alignment: center; overflow: elide;
            }
        }
    }

    // Floating LFO number follows the pointer while a modulation point is dragged.
    if ModDrag.lfo > 0: Rectangle {
        x: ModDrag.x - 11px; y: ModDrag.y - 11px; width: 22px; height: 22px;
        border-radius: 11px;
        background: ModDrag.lfo == 1 ? Theme.c1 : (ModDrag.lfo == 2 ? Theme.c2 : (ModDrag.lfo == 3 ? Theme.c3 : Theme.hi));
        border-width: 2px; border-color: Theme.on-accent;
        Text { text: "\{ModDrag.lfo}"; color: Theme.on-accent; font-size: Type.caption; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
    }

    // Grouped mode dropdown (nelody seq-style), anchored to the mode header.
    if root.mode-menu-open: Rectangle {
        x: 0px; y: 0px; width: root.base-width; height: root.base-height;
        background: #00000044;
        TouchArea { clicked => { root.mode-menu-open = false; } }
    }
    if root.mode-menu-open: ModeDropdown {
        x: Math.min(root.mode-menu-x, root.base-width - 460px);
        y: Math.min(root.mode-menu-y, root.base-height - 432px);
        rows: root.mode-rows; names: root.mode-names; current: root.mode;
        selected(i) => { root.set-mode(i); root.mode-menu-open = false; }
    }

    // Parked off-screen when closed so the closing animation can play. Tie the scrim to the
    // animated position, not the boolean, so it cannot swallow clicks while the panel travels out.
    if root.settings-x < root.base-width: Rectangle {
        x: 0px; y: 0px; width: root.base-width; height: root.base-height;
        background: #00000066;
        TouchArea { clicked => { root.settings-open = false; } }
    }
    Rectangle {
        // Parked off-window, so it must leave the tab order and the AT tree entirely; tying
        // visibility to the animated position keeps the slide-out playable.
        visible: root.settings-x < root.base-width;
        x: root.settings-x; y: 0px; width: 300px; height: root.base-height;
        background: Theme.surface; border-width: 1px; border-color: Theme.border;
        drop-shadow-blur: 16px; drop-shadow-color: #00000055; drop-shadow-offset-y: 4px;
        animate x { duration: root.reduce-motion ? 0ms : 140ms; easing: ease-in-out; }
        VerticalLayout {
            padding: 12px; spacing: 8px;
            HorizontalLayout {
                height: 24px;
                Text { text: "SETTINGS"; color: Theme.c1; font-size: Type.title; font-weight: 700; vertical-alignment: center; }
                Rectangle { width: 74px; height: 24px; border-radius: 4px; background: close-settings.has-hover ? Theme.hi : Theme.control; Text { text: "CLOSE"; color: close-settings.has-hover ? Theme.on-accent : Theme.text; font-size: Type.caption; horizontal-alignment: center; vertical-alignment: center; } close-settings := TipTouch { hint: "Close settings"; clicked => { root.settings-open = false; } } }
            }
            Text { text: "COLOUR THEME"; color: Theme.text-muted; font-size: Type.caption; font-weight: 700; letter-spacing: 0.5px; }
            Selector { options: ["Sketch", "Neon", "Lava", "Forest"]; current: root.theme-index; text-size: Type.caption; selected(i) => { root.set-theme(i); } }
            Text { text: "STARTING POINTS"; color: Theme.text-muted; font-size: Type.caption; font-weight: 700; letter-spacing: 0.5px; }
            HorizontalLayout {
                spacing: 3px; height: 24px;
                for i in root.preset-names.length: Rectangle {
                    width: (parent.width - 15px) / 6; height: 24px; border-radius: 3px;
                    background: preset-touch.has-hover ? Theme.c2 : Theme.control;
                    Text { text: root.preset-names[i]; color: preset-touch.has-hover ? Theme.on-accent : Theme.text; font-size: Type.caption; horizontal-alignment: center; vertical-alignment: center; overflow: elide; }
                    preset-touch := TipTouch { hint: "Load this starting-point preset into the host parameters"; clicked => { root.apply-preset(i); } }
                }
            }
            Text { text: "CONFIG FILE"; color: Theme.text-muted; font-size: Type.caption; font-weight: 700; letter-spacing: 0.5px; }
            Text { text: root.settings-path; color: Theme.text-muted; font-size: Type.value; wrap: word-wrap; }
            Text { text: "PATTERN LIMIT"; color: Theme.text-muted; font-size: Type.caption; font-weight: 700; letter-spacing: 0.5px; }
            max-steps-box := NumBox { label: "Max steps"; hint: "Pattern ceiling: click the value to type, scroll to step"; value: root.max-steps; minimum: 64; maximum: 1024; step: 1; mod-target: 15; changed(v) => { root.set-opt(14, v); } }
            // Pattern arrays are allocated for 1024 steps up front, so ceiling changes need no restart.
            Text { text: "Max steps applies immediately; no restart is needed."; color: Theme.text-muted; font-size: Type.value; }
            Selector { options: ["Master Loop", "Minimal Periods"]; current: root.period-minimal ? 1 : 0; selected(i) => { root.set-opt(16, i); } }
            Text { text: "Minimal periods shorten repeating lane words into true polymeter; they are capped at 1024 steps."; color: Theme.text-muted; font-size: Type.value; wrap: word-wrap; }
            Text { text: "INTERFACE"; color: Theme.text-muted; font-size: Type.caption; font-weight: 700; letter-spacing: 0.5px; }
            Rectangle {
                height: 26px; border-radius: 4px;
                background: root.reduce-motion ? Theme.c1 : (motion-touch.has-hover ? Theme.control-hover : Theme.control);
                Text { x: 8px; width: parent.width - 16px; text: root.reduce-motion ? "REDUCE MOTION: ON" : "REDUCE MOTION: OFF"; color: root.reduce-motion ? Theme.on-accent : Theme.text; font-size: Type.caption; vertical-alignment: center; }
                motion-touch := TipTouch { hint: "Skip panel slides and node tweens"; clicked => { root.toggle-reduce-motion(); } }
            }
            Text { text: "Stops the drawing-panel tweens and the panel slide animations."; color: Theme.text-muted; font-size: Type.value; wrap: word-wrap; }
            Text { text: "TECHNICAL SUPPORT"; color: Theme.text-muted; font-size: Type.caption; font-weight: 700; letter-spacing: 0.5px; }
            Rectangle {
                height: 26px; border-radius: 4px;
                background: root.logging-on ? Theme.c1 : (logging-touch.has-hover ? Theme.control-hover : Theme.control);
                Text { x: 8px; width: parent.width - 16px; text: root.logging-on ? "LOGGING: ON (nrum-seq.log)" : "LOGGING: OFF"; color: root.logging-on ? Theme.on-accent : Theme.text; font-size: Type.caption; vertical-alignment: center; }
                logging-touch := TipTouch { hint: "Write parameter snapshots to nrum-seq.log"; clicked => { root.toggle-logging(); } }
            }
            Text { text: "Writes mode and parameter snapshots to nrum-seq.log in your home folder."; color: Theme.text-muted; font-size: Type.value; wrap: word-wrap; }
            Text { text: "MIDI EXPORT"; color: Theme.text-muted; font-size: Type.caption; font-weight: 700; letter-spacing: 0.5px; }
            Rectangle {
                height: 26px; border-radius: 4px;
                background: Theme.control; border-width: 1px; border-color: Theme.border;
                midi-input := TextInput {
                    x: 6px; width: parent.width - 12px; height: parent.height;
                    text: root.midi-folder; color: Theme.text; font-size: Type.caption;
                    vertical-alignment: center;
                    edited => { root.set-midi-folder(self.text); }
                    accepted => { root.set-midi-folder(self.text); }
                }
            }
            Text { text: root.export-status; color: Theme.text-muted; font-size: Type.value; wrap: word-wrap; }
            // Push the contact block to the bottom of the panel; the controls stay top-aligned.
            Rectangle { vertical-stretch: 1; }
            // Credit rows are flush; this nested layout removes the inter-row spacing.
            VerticalLayout {
                spacing: 0px;
                Text { text: "CREDITS / CONTACT"; color: Theme.text-muted; font-size: Type.caption; font-weight: 700; letter-spacing: 0.5px; }
                Text { text: "\{root.credit-author}  ·  nrum seq"; color: Theme.text; font-size: Type.caption; }
                TextInput { read-only: true; text: root.credit-github; color: Theme.text-muted; font-size: Type.caption; height: 20px; vertical-alignment: center; }
                Text { text: "v" + root.version; color: Theme.text-muted; font-size: Type.caption; horizontal-alignment: right; }
            }
        }
    }
    }
    // Edit-mode picker: one chip in the toolbar, a 2x4 grid of modes here.
    if root.edit-menu-open: Rectangle {
        x: Math.min(root.edit-menu-x, root.base-width - 300px);
        y: Math.min(root.edit-menu-y, root.base-height - 132px);
        width: 292px; height: 124px;
        border-radius: 4px; background: Theme.surface;
        border-width: 1px; border-color: Theme.border;
        drop-shadow-blur: 12px; drop-shadow-color: #00000055; drop-shadow-offset-y: 3px;
        GridLayout {
            padding: 6px; spacing: 4px;
            for i in 8: Rectangle {
                row: i / 2; col: Math.mod(i, 2);
                height: 28px; border-radius: 3px;
                background: root.edit-mode == i ? Theme.c2.with-alpha(0.35) : (edit-touch.has-hover ? Theme.control-hover : Theme.control);
                Text {
                    width: parent.width;
                    text: root.edit-mode-names[i];
                    color: root.edit-mode == i ? Theme.text : Theme.text-muted;
                    font-size: Type.value; horizontal-alignment: center; vertical-alignment: center;
                }
                edit-touch := TipTouch {
                    hint: root.edit-mode-hints[i];
                    clicked => { root.edit-mode = i; root.edit-menu-open = false; }
                }
            }
        }
    }
    // Outside-click catcher for the dropdowns; declared before them so it cannot cover popup rows.
    if root.wave-menu-open || root.scope-menu-open || root.edit-menu-open: Rectangle {
        x: 0px; y: 0px; width: root.base-width; height: root.base-height;
        background: #00000008;
        TouchArea { clicked => {
            root.wave-menu-open = false;
            root.scope-menu-open = false;
            root.edit-menu-open = false;
        } }
    }
    // Waveform picker overlay: shows the actual sampled shape, not just its name.
    if root.wave-menu-open: Rectangle {
        x: root.wave-menu-x; y: root.wave-menu-y;
        width: root.wave-menu-target == 0 ? 190px : 160px;
        height: root.wave-paths.length * 26px + 8px;
        border-radius: 4px; background: Theme.surface;
        border-width: 1px; border-color: Theme.border;
        drop-shadow-blur: 12px; drop-shadow-color: #00000055; drop-shadow-offset-y: 3px;
        VerticalLayout {
            padding: 4px; spacing: 2px;
            for i in root.wave-paths.length: Rectangle {
                height: 24px; border-radius: 3px;
                background: (root.wave-menu-target == 0 && i == root.osc-wave)
                    || (root.wave-menu-target == 1 && i == root.lfo1-wave)
                    || (root.wave-menu-target == 2 && i == root.lfo2-wave)
                    || (root.wave-menu-target == 3 && i == root.lfo3-wave)
                    || (root.wave-menu-target == 4 && i == root.lfo4-wave)
                    ? Theme.c1.with-alpha(0.18) : (row-touch.has-hover ? Theme.control-hover : Theme.control);
                Path {
                    x: 6px; y: 4px;
                    width: root.wave-menu-target == 0 ? 54px : parent.width - 12px;
                    height: parent.height - 8px;
                    viewbox-x: 0; viewbox-y: 0; viewbox-width: 100; viewbox-height: 40;
                    commands: root.wave-paths[i];
                    fill: transparent; stroke: Theme.c1; stroke-width: 1.2px;
                }
                Text { visible: root.wave-menu-target == 0; x: 68px; width: parent.width - 74px; height: parent.height; text: i < root.wave-names.length ? root.wave-names[i] : ""; color: Theme.text; font-size: Type.caption; vertical-alignment: center; overflow: elide; }
                row-touch := TouchArea {
                    clicked => {
                        if (root.wave-menu-target == 0) { root.set-osc-wave(i); }
                        if (root.wave-menu-target == 1) { root.set-lfo-wave(1, i); }
                        if (root.wave-menu-target == 2) { root.set-lfo-wave(2, i); }
                        if (root.wave-menu-target == 3) { root.set-lfo-wave(3, i); }
                        if (root.wave-menu-target == 4) { root.set-lfo-wave(4, i); }
                        root.wave-menu-open = false;
                    }
                }
            }
        }
    }
    if root.scope-menu-open: Rectangle {
        x: root.scope-menu-x; y: root.scope-menu-y;
        width: 160px; height: 112px;
        border-radius: 4px; background: Theme.surface;
        border-width: 1px; border-color: Theme.border;
        drop-shadow-blur: 12px; drop-shadow-color: #00000055; drop-shadow-offset-y: 3px;
        VerticalLayout {
            padding: 4px; spacing: 3px;
            HorizontalLayout { spacing: 3px;
                ScopeChip { width: 74px; label: "MODE"; active: root.scope-mode; toggled => { root.toggle-scope(0); } }
                ScopeChip { width: 74px; label: "LENGTH"; active: root.scope-length; toggled => { root.toggle-scope(1); } }
            }
            HorizontalLayout { spacing: 3px;
                ScopeChip { width: 74px; label: "RHYTHM"; active: root.scope-rhythm; toggled => { root.toggle-scope(2); } }
                ScopeChip { width: 74px; label: "TONE"; active: root.scope-tone; toggled => { root.toggle-scope(3); } }
            }
            HorizontalLayout { spacing: 3px;
                ScopeChip { width: 74px; label: "PHASE"; active: root.scope-phase; toggled => { root.toggle-scope(5); } }
            }
            HorizontalLayout { spacing: 3px;
                ScopeChip { width: 74px; label: "ACID"; active: root.scope-acid; toggled => { root.toggle-scope(6); } }
                ScopeChip { width: 74px; label: "FEEL"; active: root.scope-feel; toggled => { root.toggle-scope(7); } }
            }
        }
    }

    if ModHover.target >= 0 && ModView.view(ModHover.target).linked && !root.matrix-open && ModDrag.lfo == 0: Rectangle {
        x: Math.max(6px, Math.min(ModHover.x, root.base-width - 326px));
        y: Math.min(ModHover.y + 2px, root.base-height - 26px);
        width: 320px; height: 22px;
        border-radius: 4px; background: Theme.surface;
        border-width: 1px; border-color: Theme.c3;
        drop-shadow-blur: 10px; drop-shadow-color: #00000055; drop-shadow-offset-y: 3px;
        Text {
            x: 8px; width: parent.width - 16px; height: parent.height;
            text: ModView.view(ModHover.target).lfo-text;
            color: Theme.text; font-size: Type.caption;
            horizontal-alignment: left; vertical-alignment: center; overflow: elide;
        }
    }
}
