import { ScrollView } from "std-widgets.slint";
// nDrum: algorithm-first MIDI drum sequencer. Rust pushes deterministic pattern and view data.
export global Theme {
    in-out property <color> c1: #2dd4bf;
    in-out property <color> c2: #60a5fa;
    in-out property <color> c3: #a78bfa;
    in-out property <color> hi: #fb923c;
    in-out property <color> bg1: #12161a;
    in-out property <color> bg2: #12141a;
    in-out property <color> bg3: #14121c;
}

export struct ViewNode { x: length, y: length, r: length, on: bool, cur: bool, label: string }
export struct StepCell { track: int, step: int, hit: bool, playing: bool, velocity: float, probability: float }
export struct TrackRow { index: int, name: string, enabled: bool, cells: [StepCell] }
export struct Opt { label: string, min: float, max: float, value: float, text: string, step: float }

component Selector inherits Rectangle {
    in property <[string]> options;
    in property <int> current;
    in property <length> text-size: 10px;
    callback selected(int);
    height: 28px;
    HorizontalLayout {
        spacing: 4px;
        for i in root.options.length: Rectangle {
            border-radius: 1px;
            background: ta.has-hover ? #3b414a : #282d34;
            if i == root.current: Rectangle {
                border-radius: 4px;
                background: @linear-gradient(90deg, Theme.c1 0%, Theme.c2 52%, Theme.c3 100%);
            }
            Text {
                width: parent.width; height: parent.height;
                text: root.options[i];
                color: i == root.current ? #0b0f14 : #d1d5db;
                font-size: root.text-size;
                horizontal-alignment: center; vertical-alignment: center;
                overflow: elide;
            }
            ta := TouchArea {
                clicked => { root.selected(i); }
                // Enum parameters (rate, waveform, theme) can be stepped with the wheel too.
                scroll-event(e) => {
                    if (e.delta-y != 0px) {
                        root.selected((root.current + (e.delta-y < 0px ? 1 : -1)) < 0 ? 0 : ((root.current + (e.delta-y < 0px ? 1 : -1)) >= root.options.length ? root.options.length - 1 : root.current + (e.delta-y < 0px ? 1 : -1)));
                        accept
                    } else {
                        reject
                    }
                }
            }
        }
    }
}

// Eight waveform names do not fit the options column in one legible row, so the picker
// lays them out as a 2x4 grid. Names come from Rust (`OscWave::variants()`), so adding a
// waveform only touches the enum.
component WaveGrid inherits Rectangle {
    in property <[string]> options;
    in property <int> current;
    callback selected(int);
    height: 42px;
    GridLayout {
        spacing: 3px;
        for i in root.options.length: Rectangle {
            border-radius: 3px;
            background: i == root.current ? @linear-gradient(90deg, Theme.c1 0%, Theme.c2 52%, Theme.c3 100%) : (ta.has-hover ? #3b414a : #282d34);
            Text { text: root.options[i]; color: i == root.current ? #0b0f14 : #d1d5db; font-size: 8px; horizontal-alignment: center; vertical-alignment: center; overflow: elide; }
            ta := TouchArea {
                clicked => { root.selected(i); }
                // The wheel steps the waveform, matching every other picker.
                scroll-event(e) => {
                    if (e.delta-y != 0px) {
                        root.selected(Math.max(0, Math.min(root.current + (e.delta-y < 0px ? 1 : -1), root.options.length - 1)));
                        accept
                    } else {
                        reject
                    }
                }
            }
        }
    }
}

// One RANDOMIZE scope group. The five chips edit the bits of a single host parameter.
component ScopeChip inherits Rectangle {
    in property <string> label;
    in property <bool> active;
    callback toggled();
    height: 22px; border-radius: 4px;
    background: root.active ? Theme.c1.with-alpha(0.8) : (ta.has-hover ? #3b414a : #2a3038);
    Text { text: root.label; color: root.active ? #0b0f14 : #d1d5db; font-size: 8px; horizontal-alignment: center; vertical-alignment: center; overflow: elide; }
    ta := TouchArea { clicked => { root.toggled(); } }
}

component OptSlider inherits Rectangle {
    in property <Opt> opt;
    callback changed(float);
    height: 25px;
    border-radius: 4px; background: #282d34; clip: true;
    Rectangle {
        x: 0px; y: 0px; height: parent.height;
        width: parent.width * Math.clamp((root.opt.value - root.opt.min) / (root.opt.max - root.opt.min), 0, 1);
        background: @linear-gradient(90deg, Theme.c1 0%, Theme.c2 52%, Theme.c3 100%);
        opacity: 0.55;
    }
    Text { x: 8px; width: parent.width - 16px; height: parent.height; text: root.opt.label; color: #e5e7eb; font-size: 11px; vertical-alignment: center; }
    Text { x: 8px; width: parent.width - 16px; height: parent.height; text: root.opt.text; color: #f3f4f6; font-size: 11px; horizontal-alignment: right; vertical-alignment: center; }
    ta := TouchArea {
        pointer-event(e) => {
            if (e.button == PointerEventButton.left && e.kind == PointerEventKind.down) {
                root.changed(root.opt.min + Math.clamp(ta.mouse-x / ta.width, 0, 1) * (root.opt.max - root.opt.min));
            }
        }
        moved => { if (ta.pressed) { root.changed(root.opt.min + Math.clamp(ta.mouse-x / ta.width, 0, 1) * (root.opt.max - root.opt.min)); } }
        // Wheel editing is active only while this control is hovered. Snap to the
        // parameter's step grid first, then move exactly one step per wheel notch.
        scroll-event(e) => {
            if (e.delta-y != 0px) {
                root.changed(Math.clamp(root.opt.min + Math.round((root.opt.value - root.opt.min) / root.opt.step + (e.delta-y < 0px ? 1 : -1)) * root.opt.step, root.opt.min, root.opt.max));
                accept
            } else {
                reject
            }
        }
    }
}
// Slint's SpinBox is <int>-only, so this carries fractional values such as 16.5 steps.
// Text entry plus arrow keys plus wheel, with no pixel-density limit on the value.
component NumBox inherits Rectangle {
    in property <string> label;
    in property <float> value: 0;
    in property <float> minimum: 0;
    in property <float> maximum: 100;
    in property <float> step: 1;
    in property <int> decimals: 0;
    callback changed(float);

    height: 26px;
    border-radius: 4px;
    background: #282d34; border-width: 1px; border-color: #3b414a;
    horizontal-stretch: 1;

    function clamp-value(v: float) -> float {
        return Math.clamp(v, root.minimum, root.maximum);
    }
    function nudge(dir: float) {
        root.changed(root.clamp-value(root.value + dir * root.step));
    }
    function format-value(v: float) -> string {
        if (root.decimals <= 0) { return Math.round(v); }
        return Math.round(v * 100) / 100;
    }

    Text {
        x: 6px; width: parent.width - 12px;
        text: root.label;
        color: #9ca3af; font-size: 9px; vertical-alignment: center; overflow: elide;
    }
    down := Rectangle {
        x: parent.width - 34px; y: 1px; width: 16px; height: parent.height - 2px;
        border-radius: 3px; background: down-touch.has-hover ? #454c56 : #333941;
        Text { text: "-"; color: #e5e7eb; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
        down-touch := TouchArea { clicked => { root.nudge(-1); } }
    }
    up := Rectangle {
        x: parent.width - 17px; y: 1px; width: 16px; height: parent.height - 2px;
        border-radius: 3px; background: up-touch.has-hover ? #454c56 : #333941;
        Text { text: "+"; color: #e5e7eb; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
        up-touch := TouchArea { clicked => { root.nudge(1); } }
    }
    // Wheel nudges anywhere on the control. Declared before `input` so it sits underneath the
    // text field: clicks and typing still reach the TextInput, and since TextInput has no
    // scroll handler the wheel falls through to this area.
    wheel := TouchArea {
        scroll-event(e) => {
            if (e.delta-y != 0px) {
                root.nudge(e.delta-y < 0px ? 1 : -1);
                return accept;
            }
            return reject;
        }
    }
    input := TextInput {
        x: 6px; width: parent.width - 42px; height: parent.height;
        color: #e5e7eb; font-size: 11px;
        horizontal-alignment: right; vertical-alignment: center;
        text: root.format-value(root.value);
        // Only accept complete numbers; a lone "-" or "1." must not be committed.
        edited => {
            if (self.text.is-float()) { root.changed(root.clamp-value(self.text.to-float())); }
            else { self.text = root.format-value(root.value); }
        }
        accepted => { self.text = root.format-value(root.value); }
        key-pressed(event) => {
            if (event.text == Key.UpArrow) { root.nudge(1); return accept; }
            if (event.text == Key.DownArrow) { root.nudge(-1); return accept; }
            return reject;
        }
    }
}

component ModePanel inherits Rectangle {
    in property <[ViewNode]> nodes;
    in property <string> edges: "M0 0";
    in property <string> lines: "M0 0";
    in property <string> hand: "M0 0";
    // view.rs builds every panel in a 210-unit space. The paths scale through the viewbox;
    // the node rectangles are scaled by hand so dots and labels grow with the box.
    property <float> px-per-unit: 1.4285714;   // 300px panel / 210-unit geometry
    width: 210px * root.px-per-unit; height: 210px * root.px-per-unit;
    background: #1b1e24; border-radius: 6px; clip: true;
    Path { x: 0px; y: 0px; width: parent.width; height: parent.height; viewbox-x: 0; viewbox-y: 0; viewbox-width: 210; viewbox-height: 210; commands: root.edges; fill: transparent; stroke: #3b4350; stroke-width: 1px; }
    Path { x: 0px; y: 0px; width: parent.width; height: parent.height; viewbox-x: 0; viewbox-y: 0; viewbox-width: 210; viewbox-height: 210; commands: root.lines; fill: transparent; stroke: Theme.c3; stroke-width: 1.4px; }
    Path { x: 0px; y: 0px; width: parent.width; height: parent.height; viewbox-x: 0; viewbox-y: 0; viewbox-width: 210; viewbox-height: 210; commands: root.hand; fill: transparent; stroke: Theme.hi; stroke-width: 2px; }
    for n in root.nodes: Rectangle {
        // Pebble-box positions change every step; the tween reads as motion. Other panels'
        // nodes are static, so the animation never shows there.
        animate x, y { duration: 120ms; }
        x: (n.x - n.r) * root.px-per-unit; y: (n.y - n.r) * root.px-per-unit;
        width: n.r * 2 * root.px-per-unit; height: n.r * 2 * root.px-per-unit;
        border-radius: n.r * root.px-per-unit;
        background: n.cur ? Theme.hi : (n.on ? Theme.c1 : #2a2e35);
        border-width: 1px; border-color: #4b5563;
        Text { width: parent.width; height: parent.height; text: n.label; font-size: 7px * root.px-per-unit; color: #04201d; horizontal-alignment: center; vertical-alignment: center; }
    }
}

export component AppWindow inherits Window {
    title: "nDrum";
    // Fixed layout size: the window never resizes (a live resize glitched the GL surface),
    // so the host cannot be fought over it.
    in property <length> base-width: 860px;
    in property <length> base-height: 760px;
    preferred-width: root.base-width; preferred-height: root.base-height;
    background: @linear-gradient(135deg, Theme.bg1 0%, Theme.bg2 50%, Theme.bg3 100%);
    in property <int> mode: 0;
    // The mode list is taller than its viewport, and the wheel now changes the mode instead
    // of scrolling it, so the list has to follow the selection. 32px per row (28px + 4px
    // spacing), 300px viewport plus the list's own padding, so the cap follows the mode count.
    // A Flickable/ScrollView viewport moves up by going NEGATIVE; the previous positive value
    // was clamped to 0, so modes 8-15 could be selected but never scrolled into view.
    in-out property <length> mode-scroll-y: 0px;
    changed mode => {
        root.mode-scroll-y = -Math.max(0px, Math.min(mode * 32px - 116px, root.mode-names.length * 32px - 332px));
    }
    in property <float> steps: 16;
    in property <bool> round-steps: true;
    in property <float> pulses: 5;
    in property <float> rotate: 0;
    in property <float> density: 0.65;
    in property <float> probability: 1.0;
    in property <float> velocity: 1.0;
    in property <float> regenerate-every: 0;
    in property <float> randomize-after-lengths: 0;
    in property <float> swing: 0;
    in property <float> seed: 0.271;
    in property <float> phase: 0.0;
    in property <float> osc-rate: 2.0;
    in property <float> ca-rule: 30;
    in property <float> symmetry: 4;
    in property <int> rate: 3;
    in property <int> osc-wave: 0;
    in property <[string]> wave-names;
    in property <bool> scope-mode: true;
    in property <bool> scope-length: true;
    in property <bool> scope-rhythm: true;
    in property <bool> scope-tone: true;
    in property <bool> scope-feel: true;
    in property <string> credit-author: "";
    in property <string> credit-github: "";
    in property <string> credit-email: "";
    in property <string> credit-support: "";
    in property <int> theme-index: 0;
    in-out property <bool> settings-open: false;
    // Settings slide in from the right edge of the fixed 860px layout; see the panel at the
    // bottom of this component.
    in-out property <length> settings-x: root.base-width;
    changed settings-open => {
        root.settings-x = root.settings-open ? 0px : root.base-width;
    }
    in property <bool> free-run: false;
    in property <bool> generate-on: false;
    in property <[TrackRow]> tracks;
    in property <[ViewNode]> view-nodes;
    in property <string> view-edges: "M0 0";
    in property <string> view-lines: "M0 0";
    in property <string> view-hand: "M0 0";
    in property <string> mode-math: "";
    callback set-mode(int);
    callback set-rate(int);
    callback set-osc-wave(int);
    callback set-theme(int);
    callback set-opt(int, float);
    callback toggle-round-steps();
    callback toggle-track(int);
    callback toggle-free-run();
    callback generate-pressed();
    callback randomize-pressed();
    callback toggle-scope(int);

    // Only expose mode-specific controls the selected mode actually uses, and label them with
    // what they mean in that mode. `GenParams` still carries every field; this is presentation.
    pure function shows-param(mode: int, key: int) -> bool {
        if (key == 5) { return mode == 2 || mode == 3 || mode == 4 || mode == 6 || mode == 8 || mode == 13 || mode == 16 || mode == 17 || mode == 18 || mode == 19; }
        if (key == 6) { return mode == 4 || mode == 16 || mode == 17 || mode == 19; }
        if (key == 7) { return mode == 3 || mode == 17 || mode == 18; } // Pebble reuses the CA knob as gravity
        if (key == 11) { return mode == 5 || mode == 18; }
        return true;
    }
    pure function pulses-max(mode: int) -> float {
        if (mode == 1) { return 3; } // Eulerian degree is 1 + pulses mod 4
        if (mode == 3) { return 15; } // cellular generation
        if (mode == 18) { return 2; } // 0 = silent, 1-2 = union terms
        return Math.ceil(root.steps);
    }
    pure function pulse-label(mode: int) -> string {
        if (mode == 0) { return "Target pulses"; }
        if (mode == 1) { return "Degree"; }
        if (mode == 3) { return "Generation"; }
        if (mode == 4) { return "Requested hits"; }
        if (mode == 5) { return "Motif density"; }
        if (mode == 6) { return "Target peaks"; }
        if (mode == 7) { return "Walk activity"; }
        if (mode == 8) { return "Envelope cycles"; }
        if (mode == 9) { return "Motif pulses"; }
        if (mode == 15 || mode == 16) { return "Target onsets"; }
        if (mode == 17) { return "Shaker impulses"; }
        if (mode == 18) { return "Sieve terms"; }
        if (mode == 19) { return "Target onsets"; }
        return "Pulses";
    }
    pure function density-label(mode: int) -> string {
        if (mode == 6) { return "Growth (r)"; }
        if (mode == 16) { return "Onset density"; }
        if (mode == 17) { return "Impact sensitivity"; }
        if (mode == 18) { return "Sieve density"; }
        if (mode == 19) { return "Onset density"; }
        return "Density";
    }
    pure function phase-label(mode: int) -> string {
        if (mode == 2) { return "Spiral phase"; }
        if (mode == 3) { return "Generation offset"; }
        if (mode == 6) { return "Initial x"; }
        if (mode == 8) { return "Envelope phase"; }
        if (mode == 13) { return "Phase offset"; }
        if (mode == 16) { return "Orbit phase"; }
        if (mode == 17) { return "Gravity tilt"; }
        if (mode == 18) { return "Residue shift"; }
        if (mode == 19) { return "Detune spread"; }
        return "Osc phase";
    }
    pure function osc-label(mode: int) -> string {
        if (mode == 16) { return "Solver detail"; }
        if (mode == 17) { return "Substeps"; }
        if (mode == 19) { return "Coupling"; }
        return "Osc cycles";
    }
    pure function ca-label(mode: int) -> string {
        if (mode == 17) { return "Gravity"; }
        if (mode == 18) { return "Sieve moduli"; }
        return "CA rule";
    }
    pure function regen-label(mode: int) -> string {
        // Chaos always re-rolls (0 means every cycle); other modes keep 0 as "off".
        return mode == 16 ? "Live re-roll after (cycles)" : "Regenerate after (lengths, 0=off)";
    }
    property <[string]> mode-names: ["Euclidean", "Eulerian", "Phyllotaxis", "Cellular", "Oscillator", "Crystal", "Logistic", "Markov", "Raised-Cos Threshold", "Slowcat Rhythm", "Toussaint Distance", "Well-Formed Rhythm", "L-System Grammar", "Phase Shift / Reich", "Polyrhythm Stack", "Weighted Syncopation", "Three-Body Chaos", "Pebble Box", "Xenakis Sieve", "Kuramoto Lanes"];
    property <[string]> mode-help: [
        "Places pulses as evenly as possible around the step ring with Bjorklund spacing. Each lane scales the pulse count by its density profile and anchors its word on a different phase, so the kit interleaves instead of stacking.",
        "Builds a balanced directed graph whose vertices are rest plus the eight drum lanes, then walks every edge once with Hierholzer's algorithm. The Euler circuit becomes the step sequence; density gates which visited lanes actually sound.",
        "Rotates every lane by 1/φ per step (222.49°, the mirror of the 137.51° golden angle) and lays the dots on a √i phyllotaxis rosette; the panel draws all eight lanes and a second 1/φ³ spiral in the inner band. Density and pulse ratio set how much of each lane's wedge fires.",
        "Runs a Wolfram elementary cellular automaton on a ring, one row per generation. Pulses and phase choose which generation each lane reads; the rule number decides how the row evolves.",
        "Evaluates one of eight waveforms (sine, triangle, saw, square, pulse, decay, half-sine, noise) at each step with an explicit phase and cycle count. The waveform orders the steps and a density-derived rank cutoff keeps exactly the requested number.",
        "Tiles a seeded motif across the pattern, then applies a symmetry operation per unit cell: translation, mirror, glide, inversion, screw or centering. Symmetry sets the cell size; density sets how full the motif is.",
        "Iterates the logistic map x[n+1] = r·x[n]·(1−x[n]) with r set by density. Onsets land on local peaks above a per-lane cutoff, so related phrases recur without repeating exactly.",
        "Walks a first-order transition table over rest and the eight drum voices. Weights favour role-compatible moves such as kick→snare or hat→hat; density sets the chance of an event at each step.",
        "Thresholds a smooth raised-cosine envelope whose cycle count is the requested hit count. Each envelope cycle contributes one onset, so accents stay periodic and evenly spread.",
        "Builds each lane from a short motif whose length depends on the lane and pulse count, then concatenates phrases over slow subdivisions. Shifts and phrase rules keep the lanes out of phase.",
        "Selects onsets where integer boundary crossings occur in a maximally even pulse train. The seed rotates the circular origin and modular distance shapes the accents.",
        "Generates a Christoffel/Bresenham word with exactly k onsets whose inter-onset gaps differ by at most one. Each lane gets its own phase origin, so the same word interlocks across the kit.",
        "Rewrites a two-symbol alphabet in parallel for up to twelve generations, then reads the symbols as lane and accent roles; the panel shows the actual A/B word per step. Seed and variation choose one of four rule families.",
        "Repeats one maximally even pulse train on every lane, each copy circularly offset by a fixed span plus user and seed phase. The result is Reich-style phasing over a shared pattern length.",
        "Gives each lane a fixed integer ratio (1:1, 3:2, 2:1, 5:2, 4:3, 2:3, 5:4, 3:4) over the same pattern duration. Pulse count and density scale the number of onsets per ratio.",
        "Scores every step by metric weight, a lane-dependent shifted weight, and deterministic jitter. The highest-scoring steps become onsets, biasing the result toward offbeats and late subdivisions.",
        "Integrates a hierarchical three-body orbit with a leapfrog solver and turns orbital sweep plus close encounters into a per-step score. The panel draws the live absolute orbit with its axes and clamp boundary, and the orbit re-rolls at every cycle so it keeps moving. Rank selection keeps exactly the requested number of onsets; line crossings add accents.",
        "Bounces eight pebbles, one per lane, in a box whose gravity can be tilted and strengthened. Each shaker impulse kicks a rotating third of them; a pebble triggers its drum when its wall impact is harder than the density-derived threshold. The panel animates the recorded positions and flashes the wall each hit struck.",
        "Builds a sieve mask from residue classes modulo small primes: two union terms minus a subtracted term. ca_rule picks the moduli, symmetry and phase pick the residues, the pulse count says how many union terms are active. The panel draws the three lattice rows and the resulting step mask; density keeps a fraction of the members.",
        "Runs eight phase oscillators, one per lane, coupled to their ring neighbours. osc_rate sets the coupling strength, phase the frequency spread, pulses the target onsets, and density the per-lane weight. The panel draws the eight phase pointers, their trails and the mean phase vector, so drift and lock are visible."
    ];
    property <[Opt]> opts: [
        { label: "Steps", min: 1, max: 64, value: root.steps, text: root.round-steps ? "\{Math.round(root.steps)}" : "\{Math.round(root.steps * 100) / 100}", step: root.round-steps ? 1 : 0.25 },
        { label: root.pulse-label(root.mode), min: 0, max: root.pulses-max(root.mode), value: Math.min(root.pulses, root.pulses-max(root.mode)), text: "\{Math.round(Math.min(root.pulses, root.pulses-max(root.mode)))}", step: 1 },
        { label: "Rotate", min: 0, max: Math.max(Math.ceil(root.steps) - 1, 0), value: Math.min(root.rotate, Math.max(Math.ceil(root.steps) - 1, 0)), text: "\{Math.round(Math.min(root.rotate, Math.max(Math.ceil(root.steps) - 1, 0)))}", step: 1 },
        { label: root.density-label(root.mode), min: 0, max: 1, value: root.density, text: "\{Math.round(root.density * 100)}%", step: 0.01 },
        { label: "Seed", min: 0, max: 1, value: root.seed, text: "\{Math.round(root.seed * 1000) / 1000}", step: 0.001 },
        { label: root.phase-label(root.mode), min: 0, max: 1, value: root.phase, text: "\{Math.round(root.phase * 360)}°", step: 0.01 },
        { label: root.osc-label(root.mode), min: root.mode == 17 ? 1 : 0.125, max: root.mode == 17 ? 16 : 8, value: root.mode == 17 ? Math.max(root.osc-rate, 1) : root.osc-rate, text: root.mode == 17 ? "\{Math.round(Math.max(root.osc-rate, 1))}" : "\{Math.round(root.osc-rate * 100) / 100}", step: root.mode == 17 ? 1 : 0.125 },
        { label: root.ca-label(root.mode), min: 0, max: 255, value: root.ca-rule, text: root.mode == 17 ? "\{Math.round(root.ca-rule / 255 * 100)}%" : "\{Math.round(root.ca-rule)}", step: 1 },
        { label: "Probability", min: 0, max: 1, value: root.probability, text: "\{Math.round(root.probability * 100)}%", step: 0.01 },
        { label: "Velocity", min: 0.01, max: 1, value: root.velocity, text: "\{Math.round(root.velocity * 100)}%", step: 0.01 },
        { label: root.regen-label(root.mode), min: 0, max: 256, value: root.regenerate-every, text: "\{Math.round(root.regenerate-every)}", step: 1 },
        { label: "Symmetry", min: 1, max: 8, value: root.symmetry, text: "\{Math.round(root.symmetry)}", step: 1 },
        { label: "After lengths", min: 0, max: 256, value: root.randomize-after-lengths, text: "\{Math.round(root.randomize-after-lengths)}", step: 1 },
        { label: "Swing", min: 0, max: 0.5, value: root.swing, text: "\{Math.round(root.swing * 300)}%", step: 0.01 }
    ];

    // Everything lives inside one fixed 860x760 coordinate space. The window never resizes;
    // only the pattern-matrix cells scale, so nothing reflows.
    Rectangle {
        width: root.base-width; height: root.base-height;

    VerticalLayout {
        padding: 14px; spacing: 8px;
        HorizontalLayout {
            height: 34px; spacing: 6px;
            VerticalLayout { spacing: 0px; Text { text: "nDrum"; color: #f3f4f6; font-size: 18px; font-weight: 700; } Text { text: "algorithmic MIDI percussion sequencer  /  CLAP + VST3"; color: #8b95a5; font-size: 10px; } }
            Rectangle { width: 112px; height: 30px; border-radius: 5px; background: generate-touch.has-hover ? Theme.hi : #30343c; Text { text: root.generate-on ? "RE-GENERATE ↻" : "GENERATE ↻"; color: #f9fafb; font-size: 10px; horizontal-alignment: center; vertical-alignment: center; } generate-touch := TouchArea { clicked => { root.generate-pressed(); } } }
            Rectangle { width: 112px; height: 30px; border-radius: 5px; background: randomize-touch.has-hover ? Theme.c3 : #30343c; Text { text: "RANDOMIZE ⚄"; color: #f9fafb; font-size: 10px; horizontal-alignment: center; vertical-alignment: center; } randomize-touch := TouchArea { clicked => { root.randomize-pressed(); } } }
            Rectangle { width: 40px; height: 30px; border-radius: 5px; background: settings-touch.has-hover ? Theme.c2.with-alpha(0.5) : #30343c; Text { text: "⚙"; color: #f9fafb; font-size: 14px; horizontal-alignment: center; vertical-alignment: center; } settings-touch := TouchArea { clicked => { root.settings-open = !root.settings-open; } } }
        }
        HorizontalLayout {
            // 300px leaves room for the two- or three-sentence description plus the live math
            // line without squeezing the option sliders.
            height: 300px; spacing: 10px;
            mode-list := ScrollView {
                width: 126px; height: 300px;
                viewport-y <=> root.mode-scroll-y;
                VerticalLayout { spacing: 4px;
                    for i in root.mode-names.length: Rectangle {
                        height: 28px; border-radius: 4px;
                        background: i == root.mode ? @linear-gradient(90deg, Theme.c1 0%, Theme.c2 52%, Theme.c3 100%) : (mode-touch.has-hover ? #3b414a : #282d34);
                        Text { x: 5px; width: parent.width - 10px; height: parent.height; text: root.mode-names[i]; color: i == root.mode ? #0b0f14 : #d1d5db; font-size: 9px; horizontal-alignment: center; vertical-alignment: center; overflow: elide; }
                        // The wheel steps the mode rather than scrolling this list, so the
                        // selection must stay visible: see `changed mode` on the root.
                        mode-touch := TouchArea {
                            clicked => { root.set-mode(i); }
                            scroll-event(e) => {
                                if (e.delta-y != 0px) {
                                    root.set-mode(Math.max(0, Math.min(root.mode + (e.delta-y < 0px ? 1 : -1), root.mode-names.length - 1)));
                                    return accept;
                                }
                                return reject;
                            }
                        }
                    }
                }
            }
            ModePanel { nodes: root.view-nodes; edges: root.view-edges; lines: root.view-lines; hand: root.view-hand; }
            VerticalLayout {
                spacing: 3px;
                Text { text: root.mode-names[root.mode]; color: Theme.c1; font-size: 16px; font-weight: 700; }
                Text { text: root.mode-help[root.mode]; color: #c1c8d2; font-size: 13px; wrap: word-wrap; }
                // Live formula with the current snapshot substituted; pushed by Rust from the
                // same helpers the generator calls, so it cannot drift from what is playing.
                Text { text: root.mode-math; color: #7f8a99; font-size: 11px; wrap: word-wrap; }
                Rectangle { height: 5px; }
                Text { text: "GENERATOR OPTIONS"; color: #788394; font-size: 9px; }
                HorizontalLayout { spacing: 5px; for i in 4: OptSlider { opt: root.opts[i]; changed(v) => { root.set-opt(i, v); } } }
                HorizontalLayout {
                    spacing: 5px;
                    OptSlider { opt: root.opts[4]; changed(v) => { root.set-opt(4, v); } }
                    if root.shows-param(root.mode, 5): OptSlider { opt: root.opts[5]; changed(v) => { root.set-opt(5, v); } }
                    if root.shows-param(root.mode, 6): OptSlider { opt: root.opts[6]; changed(v) => { root.set-opt(6, v); } }
                    if root.shows-param(root.mode, 7): OptSlider { opt: root.opts[7]; changed(v) => { root.set-opt(7, v); } }
                }
                HorizontalLayout { spacing: 5px; OptSlider { opt: root.opts[8]; changed(v) => { root.set-opt(8, v); } } OptSlider { opt: root.opts[9]; changed(v) => { root.set-opt(9, v); } } }
                HorizontalLayout { spacing: 5px; OptSlider { opt: root.opts[10]; changed(v) => { root.set-opt(10, v); } } if root.shows-param(root.mode, 11): OptSlider { opt: root.opts[11]; changed(v) => { root.set-opt(11, v); } } }
                if root.mode == 4: HorizontalLayout {
                    Text { text: "WAVE"; color: #9ca3af; font-size: 10px; vertical-alignment: center; }
                    WaveGrid { horizontal-stretch: 1; options: root.wave-names; current: root.osc-wave; selected(i) => { root.set-osc-wave(i); } }
                }
            }
        }
        // Rate and swing are clock controls, so they get their own full-width row under the
        // generator options instead of sharing the cramped options column.
        HorizontalLayout {
            height: 28px; spacing: 8px;
            Text { text: "CLOCK"; color: #788394; font-size: 9px; vertical-alignment: center; }
            Text { text: "RATE"; color: #9ca3af; font-size: 10px; vertical-alignment: center; }
            Selector { horizontal-stretch: 1; options: ["1/4", "1/8", "1/8T", "1/16", "1/16T", "1/32"]; current: root.rate; text-size: 9px; selected(i) => { root.set-rate(i); } }
            Text { text: "SWING"; color: #9ca3af; font-size: 10px; vertical-alignment: center; }
            OptSlider { width: 230px; opt: root.opts[13]; changed(v) => { root.set-opt(13, v); } }
        }
        Text { text: "DRUM LANES     ·     MIDI channel 10 / GM-style note map"; color: #788394; font-size: 10px; }
        HorizontalLayout {
            spacing: 5px;
            for track in root.tracks: Rectangle {
                height: 28px; border-radius: 4px;
                background: track.enabled ? @linear-gradient(90deg, Theme.c1 0%, Theme.c2 100%) : #272c33;
                Text { text: track.name; color: track.enabled ? #101820 : #a8b0bc; font-size: 8px; horizontal-alignment: center; vertical-alignment: center; }
                TouchArea { clicked => { root.toggle-track(track.index); } }
            }
        }
        Text { text: "PATTERN MATRIX  ·  velocity = brightness  ·  probability = opacity  ·  playhead in amber"; color: #788394; font-size: 10px; }
        VerticalLayout {
            spacing: 4px;
            for track in root.tracks: HorizontalLayout {
                height: 22px; spacing: 0px;
                Text { width: 76px; text: track.name; color: track.enabled ? #d1d5db : #505965; font-size: 9px; vertical-alignment: center; }
                for cell in track.cells: Rectangle {
                    // Derived from the fixed layout width, not from `parent.width`: binding to
                    // a layout width is a binding loop. base-width - 2x14 padding - the 76px
                    // name column fills the row exactly.
                    width: max(2px, (root.base-width - 28px - 76px) / (track.cells.length * 1.0));
                    height: 20px;
                    Rectangle {
                        x: 0px; y: 0px;
                        width: max(parent.width - 1px, 0px); height: parent.height;
                        border-radius: 2px;
                        background: cell.hit ? (cell.velocity > 0.82 ? Theme.c1 : Theme.c2.with-alpha(0.85)) : #242930;
                        opacity: track.enabled ? (cell.hit ? (0.25 + 0.75 * cell.velocity * cell.probability) : 1.0) : 0.35;
                        border-width: cell.playing ? 2px : 0px; border-color: Theme.hi;
                    }
                }
            }
        }
        HorizontalLayout {
            height: 27px; spacing: 5px;
            Rectangle { width: 96px; height: 24px; border-radius: 4px; background: root.free-run ? #254e48 : #2a3038; Text { text: "Toggle free-run"; color: #d1d5db; font-size: 9px; horizontal-alignment: center; vertical-alignment: center; } free-touch := TouchArea { clicked => { root.toggle-free-run(); } } }
            Text { text: root.free-run ? "FREE-RUN CLOCK: ON" : "SYNC: HOST TRANSPORT"; color: root.free-run ? Theme.c1 : #8b95a5; font-size: 9px; vertical-alignment: center; }
            OptSlider { width: 154px; opt: root.opts[12]; changed(v) => { root.set-opt(12, v); } }
        }
    }

    // Settings slide in from the right edge over the editor. The panel is always present and
    // parked off-screen when closed, so the closing animation can play too; a bare
    // `if settings-open` would make it vanish instead of sliding out.
    // Tied to the animated position, not to the boolean: the scrim stays live while the panel
    // is still travelling out, and is absent once it is parked, so it cannot swallow clicks
    // meant for the editor underneath.
    if root.settings-x < root.base-width: Rectangle {
        x: 0px; y: 0px; width: root.base-width; height: root.base-height;
        background: #00000066;
        TouchArea { clicked => { root.settings-open = false; } }
    }
    Rectangle {
        x: root.settings-x; y: 0px; width: 300px; height: root.base-height;
        background: #191d24; border-width: 1px; border-color: #3b414a;
        animate x { duration: 140ms; easing: ease-in-out; }
        VerticalLayout {
            padding: 12px; spacing: 8px;
            HorizontalLayout {
                height: 24px;
                Text { text: "SETTINGS"; color: Theme.c1; font-size: 12px; font-weight: 700; vertical-alignment: center; }
                Rectangle { width: 74px; height: 22px; border-radius: 4px; background: close-settings.has-hover ? Theme.hi : #30343c; Text { text: "CLOSE"; color: #f3f4f6; font-size: 9px; horizontal-alignment: center; vertical-alignment: center; } close-settings := TouchArea { clicked => { root.settings-open = false; } } }
            }
            Text { text: "COLOUR THEME"; color: #788394; font-size: 9px; }
            Selector { options: ["Aurora", "Neon", "Lava", "Forest"]; current: root.theme-index; text-size: 10px; selected(i) => { root.set-theme(i); } }
            Text { text: "STEP SPACING"; color: #788394; font-size: 9px; }
            // Turning rounding off lets the loop wrap between grid cells, so the pattern
            // drifts against the step grid instead of landing on it.
            Rectangle {
                height: 26px; border-radius: 4px;
                background: root.round-steps ? Theme.c1.with-alpha(0.8) : (round-touch.has-hover ? #3b414a : #2a3038);
                Text {
                    x: 8px; width: parent.width - 16px;
                    text: root.round-steps ? "WHOLE STEPS ONLY" : "FRACTIONAL STEPS";
                    color: root.round-steps ? #0b0f14 : #d1d5db;
                    font-size: 9px; vertical-alignment: center;
                }
                round-touch := TouchArea { clicked => { root.toggle-round-steps(); } }
            }
            Text { text: "PATTERN NUMBERS"; color: #788394; font-size: 9px; }
            HorizontalLayout { spacing: 6px;
                NumBox {
                    label: "Steps"; value: root.steps; minimum: 1; maximum: 64;
                    step: root.round-steps ? 1 : 0.25; decimals: root.round-steps ? 0 : 2;
                    changed(v) => { root.set-opt(0, v); }
                }
                NumBox { label: "Pulses"; value: root.pulses; minimum: 0; maximum: Math.ceil(root.steps); step: 1; changed(v) => { root.set-opt(1, v); } }
            }
            HorizontalLayout { spacing: 6px;
                NumBox { label: "Rotate"; value: root.rotate; minimum: 0; maximum: Math.max(Math.ceil(root.steps) - 1, 0); step: 1; changed(v) => { root.set-opt(2, v); } }
                NumBox { label: "Symmetry"; value: root.symmetry; minimum: 1; maximum: 8; step: 1; changed(v) => { root.set-opt(11, v); } }
            }
            NumBox { label: "Regen after"; value: root.regenerate-every; minimum: 0; maximum: 256; step: 1; changed(v) => { root.set-opt(10, v); } }
            NumBox { label: "Rand after lengths"; value: root.randomize-after-lengths; minimum: 0; maximum: 256; step: 1; changed(v) => { root.set-opt(12, v); } }
            Text { text: "RANDOMIZE SCOPE"; color: #788394; font-size: 9px; }
            // Five bits of one host parameter (`randomize_scope`). Off keeps that group's
            // current values; on lets RANDOMIZE rewrite it.
            HorizontalLayout { spacing: 4px;
                ScopeChip { label: "MODE"; active: root.scope-mode; toggled => { root.toggle-scope(0); } }
                ScopeChip { label: "LENGTH"; active: root.scope-length; toggled => { root.toggle-scope(1); } }
                ScopeChip { label: "RHYTHM"; active: root.scope-rhythm; toggled => { root.toggle-scope(2); } }
                ScopeChip { label: "TONE"; active: root.scope-tone; toggled => { root.toggle-scope(3); } }
                ScopeChip { label: "FEEL"; active: root.scope-feel; toggled => { root.toggle-scope(4); } }
            }
            Text { text: "CREDITS / CONTACT"; color: #788394; font-size: 9px; }
            Text { text: "\{root.credit-author}  ·  nDrum"; color: #d1d5db; font-size: 10px; }
            TextInput { read-only: true; text: root.credit-github; color: #9fb0c3; font-size: 9px; height: 22px; vertical-alignment: center; }
            TextInput { read-only: true; text: root.credit-email; color: #9fb0c3; font-size: 9px; height: 22px; vertical-alignment: center; }
            TextInput { read-only: true; text: root.credit-support; color: #9fb0c3; font-size: 9px; height: 22px; vertical-alignment: center; }
            Text {
                text: "RANDOMIZE uses the top button; enable Auto Randomize in the transport row. Type exact values here, or use the arrows and wheel.";
                color: #8b95a5; font-size: 9px; wrap: word-wrap; vertical-stretch: 1; vertical-alignment: top;
            }
        }
    }
    }
}
