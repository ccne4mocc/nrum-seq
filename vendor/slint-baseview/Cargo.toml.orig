[package]
name = "slint-baseview"
version = "0.1.0"
authors = [
    "Aidan Martins <aidanmartins23@gmail.com>",
]
edition = "2021"
license = "ISC"
description = "A baseview backend for Slint — run a Slint UI inside a baseview window (e.g. an audio plugin editor)"
keywords = ["slint", "baseview", "gui", "audio", "plugin"]
categories = ["gui"]
repository = "https://codeberg.org/RustAudio/slint-baseview"

[dependencies]
baseview = { version = "0.1.1", features = ["opengl"] }
slint = { version = "=1.16.1", default-features = false, features = [
    "std",
    "renderer-femtovg",
    "raw-window-handle-06",
    "compat-1-2",
] }
i-slint-renderer-femtovg = { version = "=1.16.1", features = ["opengl"] }
# slint uses raw-window-handle 0.6, but baseview 0.1.x's `open_parented` takes
# the 0.5 `HasRawWindowHandle`. We need both: 0.6 is pulled in transitively by
# slint; 0.5 is what callers must satisfy to parent into baseview.
raw-window-handle = { package = "raw-window-handle", version = "0.5" }
once_cell = "1.21.4"
# Must match the keyboard-types version that `baseview` depends on (0.6.x): the
# `Key`/`Code`/`KeyState` values we match on come out of baseview's
# `KeyboardEvent`, so bumping this independently produces E0308 type mismatches.
keyboard-types = { version = "0.6.2", default-features = false }

[build-dependencies]
# Compiles the .slint file used by the `counter` example (see build.rs).
slint-build = "=1.16.1"

[features]
default = []

[[example]]
name = "counter"
path = "examples/counter/main.rs"