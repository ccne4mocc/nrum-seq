// A tiny demo UI for the slint-baseview `counter` example.
export component AppWindow inherits Window {
    width: 360px;
    height: 240px;
    background: #1f1f1f;

    // Driven from Rust each frame.
    in property <int> counter: 0;
    // Fired when the button is clicked.
    callback increment();

    VerticalLayout {
        padding: 24px;
        spacing: 16px;
        alignment: center;

        Text {
            text: "slint-baseview";
            color: #9ca3af;
            font-size: 14px;
            horizontal-alignment: center;
        }

        Text {
            text: "Count: " + counter;
            color: #2dd4bf;
            font-size: 28px;
            horizontal-alignment: center;
        }

        Rectangle {
            height: 40px;
            border-radius: 8px;
            background: touch.pressed ? #0d9488 : (touch.has-hover ? #14b8a6 : #0f766e);

            Text {
                text: "Increment";
                color: white;
                font-size: 14px;
            }

            touch := TouchArea {
                clicked => { root.increment(); }
            }
        }
    }
}
